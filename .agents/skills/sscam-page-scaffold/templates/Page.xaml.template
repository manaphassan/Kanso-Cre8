<!-- UTF-8 BOM required — do not remove -->
<Page x:Class="SS_CAM.Views.{{PAGE_NAME}}Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{{PAGE_TITLE}}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <!-- ── Page Header ────────────────────────────────── -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:SymbolIcon Symbol="{{PAGE_ICON}}" FontSize="24" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ui:TextBlock Text="{{PAGE_TITLE}}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ui:TextBlock Text="{{PAGE_SUBTITLE}}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <ui:Button Grid.Column="1" Appearance="Secondary"
                           Click="OnRefreshClicked" Height="34"
                           Padding="16,0" VerticalAlignment="Top" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </Grid>

            <!-- ── Content Area ───────────────────────────────── -->
            <ui:Card Padding="20">
                <StackPanel>
                    <ui:TextBlock Text="{{PAGE_NAME}}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <!-- Add content here -->
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>