<!-- UTF-8 BOM required — do not remove -->
<Page x:Class="SS_CAM.Views.{{PAGE_NAME}}Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{{PAGE_TITLE}}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <!-- ── Page Header ────────────────────────────────── -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <ui:TextBlock Text="{{PAGE_TITLE}}"
                                  FontSize="24" FontWeight="Bold"
                                  Foreground="{DynamicResource FluentLightTextPrimary}"/>
                    <ui:TextBlock Text="{{PAGE_SUBTITLE}}"
                                  Foreground="{DynamicResource FluentLightTextSecondary}"
                                  FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <ui:Button Grid.Column="1" Appearance="Secondary"
                           Click="OnRefreshClicked" Height="34"
                           Padding="16,0" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons"
                                   FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </ui:Button>
            </Grid>

            <!-- ── Content Area ───────────────────────────────── -->
            <Border Background="{DynamicResource FluentLightCardBg}"
                    BorderBrush="{DynamicResource FluentLightStroke}"
                    BorderThickness="1" CornerRadius="8" Padding="20"
                    Effect="{StaticResource FluentDepth4}">
                <StackPanel>
                    <ui:TextBlock Text="{{PAGE_NAME}}"
                                  FontSize="14" FontWeight="SemiBold"
                                  Foreground="{DynamicResource FluentLightTextPrimary}"/>
                    <!-- Add content here -->
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>