<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS_CAM.Linux.ViewModels"
             x:Class="SS_CAM.Linux.Views.Pages.CalendarView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer Padding="28,24">
        <StackPanel Spacing="20">
            <!-- 1. Header Bar -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="📅" FontSize="24" VerticalAlignment="Center"/>
                        <TextBlock Text="Big Calendar &amp; Malaysian Holidays" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Project timeline scheduling, campaign release milestones, and official Malaysian public holidays." Foreground="#94A3B8" FontSize="13"/>
                </StackPanel>

                <!-- Month Navigator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding PrevMonthCommand}" Content="◀" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,6"/>
                    <Border Background="#043388" CornerRadius="6" Padding="14,6">
                        <TextBlock Text="{Binding CalendarMonthYearHeader}" FontWeight="Bold" Foreground="White" FontSize="13"/>
                    </Border>
                    <Button Command="{Binding NextMonthCommand}" Content="▶" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,6"/>
                    <Button Command="{Binding TodayCalendarCommand}" Content="Today" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,6"/>
                </StackPanel>
            </Grid>

            <!-- 2. Big Calendar Grid (7 columns: Sun - Sat) -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16">
                <StackPanel Spacing="10">
                    <!-- Day Header -->
                    <Grid ColumnDefinitions="*, *, *, *, *, *, *">
                        <TextBlock Grid.Column="0" Text="SUN" FontWeight="Bold" FontSize="11" Foreground="#EF4444" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="MON" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="TUE" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="WED" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="THU" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="FRI" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="SAT" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                    </Grid>

                    <Border Height="1" Background="#1E293B"/>

                    <!-- Calendar Weeks -->
                    <ItemsControl ItemsSource="{Binding CalendarWeeks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Days}" Margin="0,2">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid ColumnDefinitions="*, *, *, *, *, *, *"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding IsToday, Converter={x:Static ObjectConverters.IsNull}}"
                                                    BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8" Margin="2" MinHeight="68">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Text="{Binding DayNumber}" FontWeight="Bold" FontSize="12" Foreground="{Binding IsCurrentMonth, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                    </Grid>
                                                    <Border IsVisible="{Binding HasHoliday}" Background="#78350F" CornerRadius="4" Padding="4,2">
                                                        <TextBlock Text="{Binding HolidayName}" FontSize="9" FontWeight="Bold" Foreground="#FDE68A" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 3. Holidays in this Month -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Malaysian Public Holidays in This Month" FontSize="13" FontWeight="Bold" Foreground="#94A3B8"/>
                    <ItemsControl ItemsSource="{Binding MonthlyHolidays}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="120, *, Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat='{}{0:dd MMM yyyy}'}" FontWeight="Bold" Foreground="#F59E0B" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="#64748B" FontSize="11"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
