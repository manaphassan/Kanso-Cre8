<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS_CAM.Linux.ViewModels"
             x:Class="SS_CAM.Linux.Views.Pages.DeliverablesView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer Padding="28,24">
        <StackPanel Spacing="20">
            <!-- 1. Header Bar -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🎁" FontSize="24" VerticalAlignment="Center"/>
                        <TextBlock Text="Deliverables &amp; Digital Assets Management (DAM)" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Authoritative index of final production renders, social creatives, video exports, and deliverables across all 05_DELIVERABLES vault folders." Foreground="#94A3B8" FontSize="13"/>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding OpenProjectFolderCommand}" CommandParameter="{Binding SynologyDrivePath}"
                        Background="#043388" Foreground="#FFFFFF" BorderBrush="#21A1F7" BorderThickness="1" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="📁" FontSize="13"/>
                        <TextBlock Text="Open Synology Vault" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 2. Search & Filter Bar -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <Grid ColumnDefinitions="320, 20, *, Auto">
                    <TextBox Grid.Column="0" Text="{Binding SearchCopyQuery}" PlaceholderText="Search deliverables by project or brand..." VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding FilteredSearchProjects.Count, StringFormat='Showing {0} Indexed Project Deliverables'}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Command="{Binding LoadProjectsCommand}" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔄" FontSize="12"/>
                            <TextBlock Text="Rescan Vault" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 3. Indexed Deliverables Projects List -->
            <ItemsControl ItemsSource="{Binding FilteredSearchProjects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto, 16, *, Auto">
                                <!-- Folder Icon -->
                                <Border Grid.Column="0" Width="44" Height="44" Background="#022057" CornerRadius="8" BorderBrush="#1E3A8A" BorderThickness="1">
                                    <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Details -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding Project}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="13.5"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="#043388" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{Binding Designer}" Foreground="#38BDF8" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <Border Background="#064E3B" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="05_DELIVERABLES" Foreground="#A7F3D0" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding CreatedDateDisplay, StringFormat='Indexed: {0}'}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FullPath}" FontFamily="Consolas" Foreground="#64748B" FontSize="10.5"/>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenProjectFolderCommand}" CommandParameter="{Binding FullPath}"
                                            Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="📂" FontSize="12"/>
                                            <TextBlock Text="Open Folder" FontSize="11.5"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CopySpecificValueCommand}" CommandParameter="{Binding FullPath}"
                                            Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <TextBlock Text="📋 Copy Path" FontSize="11.5"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
