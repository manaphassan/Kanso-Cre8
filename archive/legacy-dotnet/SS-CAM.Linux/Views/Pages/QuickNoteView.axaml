<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS_CAM.Linux.ViewModels"
             x:Class="SS_CAM.Linux.Views.Pages.QuickNoteView"
             x:DataType="vm:MainViewModel">
    <Grid ColumnDefinitions="260, *" Margin="28,24">
        <!-- Left Column: Notes List -->
        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,16,0">
            <Grid RowDefinitions="Auto, *, Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                    <TextBlock Text="Quick Notes" FontWeight="Bold" FontSize="16" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Command="{Binding NewNoteCommand}" Background="#043388" Foreground="White" CornerRadius="6" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="➕" FontSize="11"/>
                            <TextBlock Text="New" FontSize="11.5" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- List -->
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectNoteCommand}" CommandParameter="{Binding}"
                                        Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="#38BDF8"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CreatedDate}" FontSize="9.5" Foreground="#64748B"/>
                                        </Grid>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Right Column: Note Editor -->
        <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
            <Grid RowDefinitions="Auto, 16, *, Auto">
                <!-- Editor Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*, 14, 140, 14, Auto, 8, Auto">
                    <TextBox Grid.Column="0" Text="{Binding NoteEditorTitle}" PlaceholderText="Note Title..." FontSize="14" FontWeight="Bold"/>
                    <TextBox Grid.Column="2" Text="{Binding NoteEditorCategory}" PlaceholderText="Category..."/>
                    <Button Grid.Column="4" Command="{Binding SaveCurrentNoteCommand}" Background="#043388" Foreground="White" CornerRadius="6" Padding="14,8">
                        <TextBlock Text="💾 Save" FontWeight="Bold" FontSize="12"/>
                    </Button>
                    <Button Grid.Column="6" Command="{Binding DeleteNoteCommand}" Background="#7F1D1D" Foreground="#FCA5A5" CornerRadius="6" Padding="12,8">
                        <TextBlock Text="🗑 Delete" FontSize="12"/>
                    </Button>
                </Grid>

                <!-- Editor Text -->
                <TextBox Grid.Row="2" Text="{Binding NoteEditorContent}" AcceptsReturn="True"
                         FontFamily="Consolas" FontSize="13" Padding="14" Background="#090D16" BorderBrush="#1E293B" CornerRadius="8"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
