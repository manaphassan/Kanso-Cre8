<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS_CAM.Linux.ViewModels"
             x:Class="SS_CAM.Linux.Views.Pages.SearchCopyView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer Padding="28,24">
        <StackPanel Spacing="20">
            <!-- 1. Header Bar -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="🔍" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="Search &amp; Copy Vault Inspector" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Search across all project briefs, copywriting scripts, deliverables, and folder metadata across your entire Synology vault." Foreground="#94A3B8" FontSize="13"/>
            </StackPanel>

            <!-- 2. Search Box -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <Grid ColumnDefinitions="*, 20, Auto">
                    <TextBox Grid.Column="0" Text="{Binding SearchCopyQuery}" PlaceholderText="Type keywords, project code, or client name to filter..." FontSize="13"/>
                    <Button Grid.Column="2" Command="{Binding LoadProjectsCommand}" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔄" FontSize="12"/>
                            <TextBlock Text="Refresh Index" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 3. Results List -->
            <ItemsControl ItemsSource="{Binding FilteredSearchProjects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto, 16, *, Auto">
                                <Border Grid.Column="0" Width="40" Height="40" Background="#043388" CornerRadius="8" VerticalAlignment="Center">
                                    <TextBlock Text="📁" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{Binding Project}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="13"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="#022057" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{Binding Designer}" Foreground="#38BDF8" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding FullPath}" FontFamily="Consolas" Foreground="#64748B" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenProjectFolderCommand}" CommandParameter="{Binding FullPath}"
                                            Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                        <TextBlock Text="📂 Open" FontSize="11.5"/>
                                    </Button>
                                    <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CopySpecificValueCommand}" CommandParameter="{Binding FullPath}"
                                            Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <TextBlock Text="📋 Copy Path" FontSize="11.5"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
