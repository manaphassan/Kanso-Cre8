<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS_CAM.Linux.ViewModels"
             x:Class="SS_CAM.Linux.Views.Pages.WaktuSolatView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer Padding="28,24">
        <StackPanel Spacing="24">
            <!-- 1. Header Bar -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🕌" FontSize="24" VerticalAlignment="Center"/>
                        <TextBlock Text="JAKIM Malaysia Waktu Solat Studio" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Live synchronisation with official JAKIM Malaysia prayer time schedule via waktusolat.app API." Foreground="#94A3B8" FontSize="13"/>
                    <TextBlock Text="{Binding HijriDateString}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Zone Selector -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Select Malaysia Zone" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    <ComboBox ItemsSource="{Binding PrayerZones}" SelectedItem="{Binding SelectedPrayerZone}" Width="240"/>
                </StackPanel>
            </Grid>

            <!-- 2. Next Prayer Hero Card -->
            <Border Background="#064E3B" BorderBrush="#047857" BorderThickness="1" CornerRadius="12" Padding="24">
                <Grid ColumnDefinitions="Auto, 24, *, Auto">
                    <Border Grid.Column="0" Width="64" Height="64" Background="#047857" CornerRadius="12">
                        <TextBlock Text="🕌" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="NEXT PRAYER" FontSize="11" FontWeight="Bold" Foreground="#6EE7B7"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding NextPrayerName}" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="{Binding NextPrayerTime}" FontSize="28" FontWeight="Bold" Foreground="#A7F3D0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding NextPrayerCountdown, StringFormat='Countdown: {0}'}" FontSize="13" Foreground="#D1FAE5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Full Daily Prayer Schedule Table -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Today's Official Prayer Time Table" FontSize="14" FontWeight="Bold" Foreground="#94A3B8"/>
                    <ItemsControl ItemsSource="{Binding PrayerTimes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="140, *, Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Background="#022057" CornerRadius="6" Padding="12,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Time}" FontWeight="Bold" FontSize="14" Foreground="#38BDF8"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
