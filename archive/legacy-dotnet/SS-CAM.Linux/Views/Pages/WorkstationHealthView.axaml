<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS_CAM.Linux.ViewModels"
             x:Class="SS_CAM.Linux.Views.Pages.WorkstationHealthView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer Padding="28,24">
        <StackPanel Spacing="24">
            <!-- 1. Header Bar -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="💻" FontSize="24" VerticalAlignment="Center"/>
                        <TextBlock Text="Linux Workstation Health &amp; Diagnostics" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="System hardware telemetry, storage health, Synology NAS latency, and creative toolchain verification." Foreground="#94A3B8" FontSize="13"/>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding RescanHealthCommand}" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🔄" FontSize="12"/>
                        <TextBlock Text="Rescan Health" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 2. System Hardware KPI Cards -->
            <Grid ColumnDefinitions="*, *, *, *">
                <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,4,0">
                    <StackPanel Spacing="3">
                        <TextBlock Text="CPU MODEL" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding CpuInfo}" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="2,0,2,0">
                    <StackPanel Spacing="3">
                        <TextBlock Text="MEMORY (RAM)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding RamInfo}" FontSize="14" FontWeight="Bold" Foreground="#10B981"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="2,0,2,0">
                    <StackPanel Spacing="3">
                        <TextBlock Text="ROOT DISK (/)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding DiskRootInfo}" FontSize="14" FontWeight="Bold" Foreground="#F59E0B"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="4,0,0,0">
                    <StackPanel Spacing="3">
                        <TextBlock Text="HOME DISK (~)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding DiskHomeInfo}" FontSize="14" FontWeight="Bold" Foreground="#8B5CF6"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Network & NAS Connectivity -->
            <Border Background="#064E3B" BorderBrush="#047857" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid ColumnDefinitions="Auto, 16, *">
                    <TextBlock Grid.Column="0" Text="🌐" FontSize="24" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding NasPingStatus}" FontWeight="Bold" FontSize="13" Foreground="#A7F3D0"/>
                        <TextBlock Text="Real-time ICMP ping &amp; Synology Drive daemon connectivity" FontSize="11.5" Foreground="#6EE7B7"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. Creative Toolchain Installed Software Checks -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Creative Toolchain Verification (/usr/bin)" FontSize="14" FontWeight="Bold" Foreground="#94A3B8"/>
                    <ItemsControl ItemsSource="{Binding SoftwareChecks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="160, *, Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" FontFamily="Consolas" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Background="{Binding IsInstalled, Converter={x:Static ObjectConverters.IsNull}}" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="11" Foreground="{Binding StatusColor}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
