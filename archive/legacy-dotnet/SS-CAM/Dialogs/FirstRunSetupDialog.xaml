<ui:FluentWindow x:Class="SS_CAM.Dialogs.FirstRunSetupDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="SS-CAM Workstation &amp; Profile Setup"
                  Height="540" Width="520"
                  WindowStartupLocation="CenterScreen"
                  ResizeMode="NoResize"
                  Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <ui:SymbolIcon Symbol="Wrench24" FontSize="24" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <ui:TextBlock Text="Workstation &amp; Profile Setup" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <ui:TextBlock Text="First-time setup detected. Configure your workspace root and designer profile to get started."
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Content Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,10">

                <!-- Step 1: Workspace Root -->
                <ui:Card Margin="0,0,0,14" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="14" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="1. Creative Team Workspace Root (NAS)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <ui:TextBlock Text="Select your local Synology Drive folder sync directory (e.g. E:\SynologyDrive\Creative-Team)."
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="TxtWorkspaceRoot" Height="32" Padding="8,4" VerticalContentAlignment="Center" PlaceholderText="Select Creative-Team folder path..." FontSize="11"/>
                            <ui:Button Grid.Column="1" Click="OnAutoDetectClicked" Appearance="Secondary" Height="32" Padding="10,0" Margin="6,0,0,0" Cursor="Hand" ToolTip="Auto-detect Creative-Team folder">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Auto-Detect" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Grid.Column="2" Click="OnBrowseWorkspaceClicked" Appearance="Secondary" Height="32" Padding="10,0" Margin="6,0,0,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderSearch24" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Browse..." FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                        <ui:TextBlock x:Name="TxtWorkspaceStatus" Text="" FontSize="10" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                    </StackPanel>
                </ui:Card>

                <!-- Step 2: Designer Profile -->
                <ui:Card Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Person24" FontSize="14" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="2. Designer Persona &amp; Identity" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <ui:TextBlock Text="Designer Name:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtDesignerName" Height="32" Padding="8,4" VerticalContentAlignment="Center" PlaceholderText="e.g. Harus" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <ui:TextBlock Text="Staff ID / Folder Code:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtStaffId" Height="32" Padding="8,4" VerticalContentAlignment="Center" PlaceholderText="e.g. 0001D" FontSize="11"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,10">
                            <ui:TextBlock Text="Department / Unit:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbDepartment" Height="32" Padding="8,4" VerticalContentAlignment="Center" FontSize="11">
                                <ComboBoxItem Content="Creative &amp; Brand" IsSelected="True"/>
                                <ComboBoxItem Content="Video &amp; Motion Design"/>
                                <ComboBoxItem Content="3D &amp; Visual FX"/>
                                <ComboBoxItem Content="Digital Marketing"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,4">
                            <ui:TextBlock Text="Workstation Email:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="TxtEmail" Height="32" Padding="8,4" VerticalContentAlignment="Center" PlaceholderText="e.g. designer@suamisihat.com" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Action Button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:TextBlock x:Name="TxtError" Text="" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <ui:Button Appearance="Primary" Click="OnSaveClicked" Height="36" Padding="20,0" Cursor="Hand" FontWeight="Bold">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <ui:TextBlock Text="Complete Setup &amp; Start SS-CAM" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Button>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
