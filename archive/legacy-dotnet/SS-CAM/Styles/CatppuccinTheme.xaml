<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!--  CATPPUCCIN THEME (MOCHA FLAVOR)  .  SS-CAM v2.6.4+               -->
    <!--  Soothing pastel dark aesthetic (https://catppuccin.com)          -->
    <!-- ================================================================= -->

    <!-- Brand Accent - Mauve & Lavender -->
    <SolidColorBrush x:Key="FluentBrand80"    Color="#CBA6F7"/>
    <SolidColorBrush x:Key="FluentBrand70"    Color="#B4BEFE"/>
    <SolidColorBrush x:Key="FluentBrandLight" Color="#313244"/>
    <SolidColorBrush x:Key="FluentBrandTint"  Color="#313244"/>

    <!-- WPF-UI Core Base System Brush Overrides (Catppuccin Mocha) -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#1E1E2E"/>
    <SolidColorBrush x:Key="WindowBackground"                     Color="#1E1E2E"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"  Color="#313244"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#181825"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"         Color="#45475A"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"           Color="#CDD6F4"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"         Color="#A6ADC8"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"          Color="#9399B2"/>
    <SolidColorBrush x:Key="TextControlForeground"               Color="#CDD6F4"/>
    <SolidColorBrush x:Key="TextControlBackground"               Color="#181825"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"        Color="#313244"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"      Color="#45475A"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"       Color="#585B70"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"       Color="#45475A"/>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush"       Color="#CBA6F7"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"         Color="#CBA6F7"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"       Color="#B4BEFE"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"        Color="#89B4FA"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"     Color="#11111B"/>
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#A6E3A1"/>
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#F9E2AF"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#F38BA8"/>

    <!-- Canvas / Page Backgrounds - Catppuccin Base -->
    <SolidColorBrush x:Key="FluentLightCanvasBg"  Color="#1E1E2E"/>

    <!-- Card Surfaces - Catppuccin Surface0 & Mantle -->
    <SolidColorBrush x:Key="FluentLightCardBg"    Color="#313244"/>
    <SolidColorBrush x:Key="FluentLightCardSubBg" Color="#181825"/>

    <!-- Borders - Catppuccin Surface1 -->
    <SolidColorBrush x:Key="FluentLightStroke"    Color="#45475A"/>

    <!-- Typography - Catppuccin Text & Subtext0 -->
    <SolidColorBrush x:Key="FluentLightTextPrimary"   Color="#CDD6F4"/>
    <SolidColorBrush x:Key="FluentLightTextSecondary" Color="#A6ADC8"/>

    <!-- Sidebar Semantic Tokens for Catppuccin Mantle -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#181825"/>
    <SolidColorBrush x:Key="SidebarSearchBackgroundBrush" Color="#313244"/>
    <SolidColorBrush x:Key="SidebarTextPrimaryBrush" Color="#CDD6F4"/>
    <SolidColorBrush x:Key="SidebarTextSecondaryBrush" Color="#A6ADC8"/>
    <SolidColorBrush x:Key="SidebarUserCardBackgroundBrush" Color="#313244"/>
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#45475A"/>

    <!-- Status tokens - Catppuccin Green, Yellow, Red -->
    <SolidColorBrush x:Key="FluentSuccess" Color="#A6E3A1"/>
    <SolidColorBrush x:Key="FluentWarning" Color="#F9E2AF"/>
    <SolidColorBrush x:Key="FluentDanger"  Color="#F38BA8"/>

    <!-- Typography -->
    <FontFamily x:Key="FluentFontFamily">Segoe UI Variable Text, Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>

    <!-- Elevation Shadows -->
    <DropShadowEffect x:Key="FluentDepth4"
                      BlurRadius="10" ShadowDepth="2" Direction="270"
                      Color="#11111B" Opacity="0.30"/>

    <DropShadowEffect x:Key="FluentDepth8"
                      BlurRadius="18" ShadowDepth="4" Direction="270"
                      Color="#11111B" Opacity="0.45"/>

    <DropShadowEffect x:Key="FluentDepth16"
                      BlurRadius="30" ShadowDepth="8" Direction="270"
                      Color="#11111B" Opacity="0.60"/>

</ResourceDictionary>
