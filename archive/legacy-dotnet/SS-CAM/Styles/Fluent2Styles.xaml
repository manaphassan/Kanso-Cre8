<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- MICROSOFT FLUENT 2 DESIGN SYSTEM TOKENS (fluent2.microsoft.design) -->
    <!-- ================================================================= -->

    <!-- Brand Accent Tokens -->
    <SolidColorBrush x:Key="FluentBrand80" Color="#21A1F7"/>
    <SolidColorBrush x:Key="FluentBrand70" Color="#0E84D3"/>
    <SolidColorBrush x:Key="FluentBrandLight" Color="#EBF4FE"/>
    <SolidColorBrush x:Key="FluentBrandTint" Color="#EBF4FE"/>

    <!-- Official SuamiSihat Brand System Tokens (brand-system.html) -->
    <SolidColorBrush x:Key="SSPrussianBlue" Color="#022057"/>
    <SolidColorBrush x:Key="SSBlue"         Color="#043388"/>
    <SolidColorBrush x:Key="SSAzure"        Color="#21A1F7"/>
    <SolidColorBrush x:Key="SSMalibu"       Color="#6DC6EC"/>
    <SolidColorBrush x:Key="SSNeutralBlack" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="SSLion"         Color="#BD9A73"/>
    <SolidColorBrush x:Key="SSFawn"         Color="#CCAC8D"/>
    <SolidColorBrush x:Key="SSArylide"      Color="#E5D15C"/>
    <SolidColorBrush x:Key="SSBanana"       Color="#FCE53D"/>

    <!-- WPF-UI Core Base System Brush Overrides (Falconia Light) -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="WindowBackground"                     Color="#FAFAFA"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"         Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"           Color="#1C1C1C"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"         Color="#575756"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"          Color="#8A8A8A"/>
    <SolidColorBrush x:Key="TextControlForeground"               Color="#1C1C1C"/>
    <SolidColorBrush x:Key="TextControlBackground"               Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"      Color="#F5F5F5"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"       Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"       Color="#D1D1D1"/>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush"       Color="#21A1F7"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"         Color="#21A1F7"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"       Color="#0E84D3"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"        Color="#043388"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#107C41"/>
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#797700"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C50F1F"/>

    <!-- Neutral Dark Tokens -->
    <SolidColorBrush x:Key="FluentDarkCanvasBg" Color="#141414"/>
    <SolidColorBrush x:Key="FluentDarkCardBg" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="FluentDarkCardSubBg" Color="#292929"/>
    <SolidColorBrush x:Key="FluentDarkStroke" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="FluentDarkTextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FluentDarkTextSecondary" Color="#ADADAD"/>

    <!-- Neutral Light Tokens -->
    <SolidColorBrush x:Key="FluentLightCanvasBg" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="FluentLightCardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FluentLightCardSubBg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="FluentLightStroke" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="FluentLightTextPrimary" Color="#242424"/>
    <SolidColorBrush x:Key="FluentLightTextSecondary" Color="#616161"/>

    <!-- Sidebar Semantic Tokens -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#022057"/>
    <SolidColorBrush x:Key="SidebarSearchBackgroundBrush" Color="#043388"/>
    <SolidColorBrush x:Key="SidebarTextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarTextSecondaryBrush" Color="#8AAACF"/>
    <SolidColorBrush x:Key="SidebarUserCardBackgroundBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#163B75"/>

    <!-- Status Tokens -->
    <SolidColorBrush x:Key="FluentSuccess" Color="#107C41"/>
    <SolidColorBrush x:Key="FluentWarning" Color="#797700"/>
    <SolidColorBrush x:Key="FluentDanger" Color="#C50F1F"/>

    <!-- Typography Ramp -->
    <FontFamily x:Key="FluentFontFamily">Segoe UI Variable Text, Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>

    <!-- Elevation Depth Shadows & Glowing Effects -->
    <DropShadowEffect x:Key="FluentDepth4" BlurRadius="6" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.14"/>
    <DropShadowEffect x:Key="FluentDepth8" BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.20"/>
    <DropShadowEffect x:Key="FluentDepth16" BlurRadius="24" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.28"/>
    <DropShadowEffect x:Key="FluentCyberGlow" BlurRadius="16" ShadowDepth="0" Color="#00CFFF" Opacity="0.45"/>
    <SolidColorBrush x:Key="FluentGlassBorder" Color="#28FFFFFF"/>

</ResourceDictionary>
