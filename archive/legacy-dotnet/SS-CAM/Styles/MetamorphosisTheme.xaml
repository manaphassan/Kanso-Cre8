<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!--  METAMORPHOSIS THEME  .  SS-CAM v2.5.1+                           -->
    <!--  Glassmorphism skin layered on Fluent Design philosophy.           -->
    <!--  Strategy: override every FluentLight* + FluentBrand* key so all  -->
    <!--  existing pages pick up the glass look with zero XAML changes.    -->
    <!-- ================================================================= -->

    <!-- Brand Accent - Electric cyan replaces default Microsoft blue -->
    <SolidColorBrush x:Key="FluentBrand80"    Color="#00CFFF"/>
    <SolidColorBrush x:Key="FluentBrand70"    Color="#009CC4"/>
    <SolidColorBrush x:Key="FluentBrandLight" Color="#061D30"/>
    <SolidColorBrush x:Key="FluentBrandTint"  Color="#0D2444"/>

    <!-- WPF-UI Core Base System Brush Overrides (Metamorphosis Deep Navy) -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#080D1F"/>
    <SolidColorBrush x:Key="WindowBackground"                     Color="#080D1F"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"  Color="#0F1A3A"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#142045"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"         Color="#1E2E5C"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"           Color="#F1F5F9"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"         Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"          Color="#64748B"/>
    <SolidColorBrush x:Key="TextControlForeground"               Color="#F1F5F9"/>
    <SolidColorBrush x:Key="TextControlBackground"               Color="#0C1633"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"        Color="#14224B"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"      Color="#182857"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"       Color="#1E316A"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"       Color="#243977"/>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush"       Color="#00CFFF"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"         Color="#00CFFF"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"       Color="#009CC4"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"        Color="#1AB8E8"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"     Color="#080D1F"/>
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#F87171"/>

    <!-- Canvas / Page Backgrounds - Deep space navy -->
    <SolidColorBrush x:Key="FluentLightCanvasBg"  Color="#080D1F"/>

    <!-- Opaque Card Surfaces - Deep navy surfaces for high readability -->
    <SolidColorBrush x:Key="FluentLightCardBg"    Color="#0F1A3A"/>
    <SolidColorBrush x:Key="FluentLightCardSubBg" Color="#142045"/>

    <!-- Borders - Crisp navy stroke lines -->
    <SolidColorBrush x:Key="FluentLightStroke"    Color="#1E2E5C"/>

    <!-- Typography - light text on dark glass -->
    <SolidColorBrush x:Key="FluentLightTextPrimary"   Color="#F1F5F9"/>
    <SolidColorBrush x:Key="FluentLightTextSecondary" Color="#94A3B8"/>

    <!-- Sidebar Semantic Tokens for Metamorphosis Glass -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0B132B"/>
    <SolidColorBrush x:Key="SidebarSearchBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="SidebarTextPrimaryBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SidebarTextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="SidebarUserCardBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#334155"/>

    <!-- Status tokens - intensified for dark bg -->
    <SolidColorBrush x:Key="FluentSuccess" Color="#34D399"/>
    <SolidColorBrush x:Key="FluentWarning" Color="#FBBF24"/>
    <SolidColorBrush x:Key="FluentDanger"  Color="#F87171"/>

    <!-- Typography unchanged -->
    <FontFamily x:Key="FluentFontFamily">Segoe UI Variable Text, Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>

    <!-- ================================================================= -->
    <!--  METAMORPHOSIS-EXCLUSIVE TOKENS                                    -->
    <!-- ================================================================= -->

    <!-- Deep gradient canvas brush (used by MainWindow content area) -->
    <LinearGradientBrush x:Key="MetaCanvasGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#080D1F" Offset="0.0"/>
        <GradientStop Color="#0E1530" Offset="0.4"/>
        <GradientStop Color="#12103A" Offset="0.75"/>
        <GradientStop Color="#080D1F" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Cyan to Violet accent gradient -->
    <LinearGradientBrush x:Key="MetaAccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00CFFF" Offset="0.0"/>
        <GradientStop Color="#7C3AED" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Glass sheen - subtle cyan top highlight for cards -->
    <LinearGradientBrush x:Key="MetaGlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A00CFFF" Offset="0.0"/>
        <GradientStop Color="#0000CFFF" Offset="0.5"/>
    </LinearGradientBrush>

    <!-- Glow colour references -->
    <SolidColorBrush x:Key="MetaGlowCyan"   Color="#00CFFF"/>
    <SolidColorBrush x:Key="MetaGlowViolet" Color="#7C3AED"/>

    <!-- Elevation shadows replaced with luminous glow halos -->
    <DropShadowEffect x:Key="FluentDepth4"
                      BlurRadius="12" ShadowDepth="0"
                      Color="#00CFFF" Opacity="0.20"/>

    <DropShadowEffect x:Key="FluentDepth8"
                      BlurRadius="22" ShadowDepth="0"
                      Color="#7C3AED" Opacity="0.28"/>

    <DropShadowEffect x:Key="FluentDepth16"
                      BlurRadius="36" ShadowDepth="0"
                      Color="#7C3AED" Opacity="0.40"/>

    <!-- Named Metamorphosis glow effects -->
    <DropShadowEffect x:Key="MetaGlassCardGlow"
                      BlurRadius="18" ShadowDepth="0"
                      Color="#00CFFF" Opacity="0.18"/>

    <DropShadowEffect x:Key="MetaAccentButtonGlow"
                      BlurRadius="24" ShadowDepth="0"
                      Color="#00CFFF" Opacity="0.45"/>

    <DropShadowEffect x:Key="MetaHeroGlow"
                      BlurRadius="40" ShadowDepth="0"
                      Color="#7C3AED" Opacity="0.50"/>

    <DropShadowEffect x:Key="MetaNavActiveGlow"
                      BlurRadius="10" ShadowDepth="0"
                      Color="#00CFFF" Opacity="0.60"/>

</ResourceDictionary>
