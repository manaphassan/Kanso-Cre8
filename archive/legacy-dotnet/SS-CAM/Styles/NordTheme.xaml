<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!--  NORD THEME (ARCTIC LIGHT)  .  SS-CAM v2.6.4+                     -->
    <!--  Arctic, Snow-storm light color palette (https://www.nordtheme.com)-->
    <!-- ================================================================= -->

    <!-- Brand Accent Tokens - Nord Frost (#5E81AC, #81A1C1, #88C0D0) -->
    <SolidColorBrush x:Key="FluentBrand80"    Color="#5E81AC"/>
    <SolidColorBrush x:Key="FluentBrand70"    Color="#81A1C1"/>
    <SolidColorBrush x:Key="FluentBrandLight" Color="#E5E9F0"/>
    <SolidColorBrush x:Key="FluentBrandTint"  Color="#E5E9F0"/>

    <!-- WPF-UI Core Base System Brush Overrides (Nord Light Snow Storm & Polar Night) -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="WindowBackground"                     Color="#ECEFF4"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#E5E9F0"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"         Color="#E5E9F0"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"           Color="#2E3440"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"         Color="#4C566A"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"          Color="#434C5E"/>
    <SolidColorBrush x:Key="TextControlForeground"               Color="#2E3440"/>
    <SolidColorBrush x:Key="TextControlBackground"               Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"      Color="#E5E9F0"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"       Color="#D8DEE9"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"       Color="#D8DEE9"/>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush"       Color="#5E81AC"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"         Color="#5E81AC"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"       Color="#81A1C1"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"        Color="#88C0D0"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#A3BE8C"/>
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#D08770"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#BF616A"/>

    <!-- Canvas / Page Backgrounds - Nord Snow Storm nord6 -->
    <SolidColorBrush x:Key="FluentLightCanvasBg"  Color="#ECEFF4"/>

    <!-- Card Surfaces - Nord Pure White & nord5 -->
    <SolidColorBrush x:Key="FluentLightCardBg"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FluentLightCardSubBg" Color="#E5E9F0"/>

    <!-- Borders - Nord Snow Storm nord5 -->
    <SolidColorBrush x:Key="FluentLightStroke"    Color="#E5E9F0"/>

    <!-- Typography - Nord Polar Night nord0 & nord3 -->
    <SolidColorBrush x:Key="FluentLightTextPrimary"   Color="#2E3440"/>
    <SolidColorBrush x:Key="FluentLightTextSecondary" Color="#4C566A"/>

    <!-- Sidebar Semantic Tokens for Nord Light nord5 -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#E5E9F0"/>
    <SolidColorBrush x:Key="SidebarSearchBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarTextPrimaryBrush" Color="#2E3440"/>
    <SolidColorBrush x:Key="SidebarTextSecondaryBrush" Color="#4C566A"/>
    <SolidColorBrush x:Key="SidebarUserCardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#D8DEE9"/>

    <!-- Status Tokens - Nord Aurora Green, Orange, Red -->
    <SolidColorBrush x:Key="FluentSuccess" Color="#A3BE8C"/>
    <SolidColorBrush x:Key="FluentWarning" Color="#D08770"/>
    <SolidColorBrush x:Key="FluentDanger"  Color="#BF616A"/>

    <!-- Typography -->
    <FontFamily x:Key="FluentFontFamily">Segoe UI Variable Text, Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>

    <!-- Elevation Shadows -->
    <DropShadowEffect x:Key="FluentDepth4"
                      BlurRadius="8" ShadowDepth="2" Direction="270"
                      Color="#D8DEE9" Opacity="0.40"/>

    <DropShadowEffect x:Key="FluentDepth8"
                      BlurRadius="16" ShadowDepth="4" Direction="270"
                      Color="#D8DEE9" Opacity="0.55"/>

    <DropShadowEffect x:Key="FluentDepth16"
                      BlurRadius="24" ShadowDepth="8" Direction="270"
                      Color="#D8DEE9" Opacity="0.70"/>

</ResourceDictionary>
