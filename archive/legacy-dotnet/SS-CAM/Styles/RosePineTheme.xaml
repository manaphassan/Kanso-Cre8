<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!--  ROSÉ PINE THEME  .  SS-CAM v2.6.4+                              -->
    <!--  All natural pine, warm rose, iris & gold aesthetic              -->
    <!--  (https://rosepinetheme.com)                                      -->
    <!-- ================================================================= -->

    <!-- Brand Accent - Rosé & Iris -->
    <SolidColorBrush x:Key="FluentBrand80"    Color="#EBBCBA"/>
    <SolidColorBrush x:Key="FluentBrand70"    Color="#C4A7E7"/>
    <SolidColorBrush x:Key="FluentBrandLight" Color="#26233A"/>
    <SolidColorBrush x:Key="FluentBrandTint"  Color="#26233A"/>

    <!-- WPF-UI Core Base System Brush Overrides (Rosé Pine) -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#191724"/>
    <SolidColorBrush x:Key="WindowBackground"                     Color="#191724"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"  Color="#1F1D2E"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#191724"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"         Color="#26233A"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"           Color="#E0DEF4"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"         Color="#908CAA"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"          Color="#6E6A86"/>
    <SolidColorBrush x:Key="TextControlForeground"               Color="#E0DEF4"/>
    <SolidColorBrush x:Key="TextControlBackground"               Color="#191724"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"        Color="#1F1D2E"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"      Color="#26233A"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"       Color="#312F44"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"       Color="#26233A"/>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush"       Color="#EBBCBA"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"         Color="#EBBCBA"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"       Color="#C4A7E7"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"        Color="#9CCFD8"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"     Color="#191724"/>
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#31748F"/>
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#F6C177"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#EB6F92"/>

    <!-- Canvas / Page Backgrounds - Rosé Pine Base -->
    <SolidColorBrush x:Key="FluentLightCanvasBg"  Color="#191724"/>

    <!-- Card Surfaces - Rosé Pine Surface & Overlay -->
    <SolidColorBrush x:Key="FluentLightCardBg"    Color="#1F1D2E"/>
    <SolidColorBrush x:Key="FluentLightCardSubBg" Color="#191724"/>

    <!-- Borders - Rosé Pine Overlay -->
    <SolidColorBrush x:Key="FluentLightStroke"    Color="#26233A"/>

    <!-- Typography - Rosé Pine Text & Subtle -->
    <SolidColorBrush x:Key="FluentLightTextPrimary"   Color="#E0DEF4"/>
    <SolidColorBrush x:Key="FluentLightTextSecondary" Color="#908CAA"/>

    <!-- Sidebar Semantic Tokens for Rosé Pine Base -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#191724"/>
    <SolidColorBrush x:Key="SidebarSearchBackgroundBrush" Color="#1F1D2E"/>
    <SolidColorBrush x:Key="SidebarTextPrimaryBrush" Color="#E0DEF4"/>
    <SolidColorBrush x:Key="SidebarTextSecondaryBrush" Color="#908CAA"/>
    <SolidColorBrush x:Key="SidebarUserCardBackgroundBrush" Color="#1F1D2E"/>
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#26233A"/>

    <!-- Status tokens - Pine, Gold, Love -->
    <SolidColorBrush x:Key="FluentSuccess" Color="#31748F"/>
    <SolidColorBrush x:Key="FluentWarning" Color="#F6C177"/>
    <SolidColorBrush x:Key="FluentDanger"  Color="#EB6F92"/>

    <!-- Typography -->
    <FontFamily x:Key="FluentFontFamily">Segoe UI Variable Text, Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>

    <!-- Elevation Shadows -->
    <DropShadowEffect x:Key="FluentDepth4"
                      BlurRadius="10" ShadowDepth="2" Direction="270"
                      Color="#12101D" Opacity="0.35"/>

    <DropShadowEffect x:Key="FluentDepth8"
                      BlurRadius="18" ShadowDepth="4" Direction="270"
                      Color="#12101D" Opacity="0.50"/>

    <DropShadowEffect x:Key="FluentDepth16"
                      BlurRadius="30" ShadowDepth="8" Direction="270"
                      Color="#12101D" Opacity="0.65"/>

</ResourceDictionary>
