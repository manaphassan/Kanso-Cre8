<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- SS DEFAULT THEME - SS-CAM v2.6.0+
         SuamiSihat Brand Navy sidebar, white content area.
         WPF-UI runs in Light mode so content cards are white.
         Nav item text is overridden to white in OnThemeModeChanged.
         This file is a COMPLETE replacement for Fluent2Styles.xaml and
         must define ALL Fluent* tokens used anywhere in the app. -->

    <!-- Brand Accent - SS Blue & Azure -->
    <SolidColorBrush x:Key="FluentBrand80"    Color="#21A1F7"/>
    <SolidColorBrush x:Key="FluentBrand70"    Color="#0E84D3"/>
    <SolidColorBrush x:Key="FluentBrandLight" Color="#EBF4FE"/>
    <SolidColorBrush x:Key="FluentBrandTint"  Color="#EBF4FE"/>

    <!-- Official SuamiSihat Brand System Tokens (brand-system.html) -->
    <SolidColorBrush x:Key="SSPrussianBlue" Color="#022057"/>
    <SolidColorBrush x:Key="SSBlue"         Color="#043388"/>
    <SolidColorBrush x:Key="SSAzure"        Color="#21A1F7"/>
    <SolidColorBrush x:Key="SSMalibu"       Color="#6DC6EC"/>
    <SolidColorBrush x:Key="SSNeutralBlack" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="SSLion"         Color="#BD9A73"/>
    <SolidColorBrush x:Key="SSFawn"         Color="#CCAC8D"/>
    <SolidColorBrush x:Key="SSArylide"      Color="#E5D15C"/>
    <SolidColorBrush x:Key="SSBanana"       Color="#FCE53D"/>

    <!-- Neutral Light Tokens (Strict Rule: Neutral Black #1C1C1C for text) -->
    <SolidColorBrush x:Key="FluentLightCanvasBg"      Color="#F5F5F5"/>
    <SolidColorBrush x:Key="FluentLightCardBg"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FluentLightCardSubBg"     Color="#F8FAFC"/>
    <SolidColorBrush x:Key="FluentLightStroke"        Color="#E0E0E0"/>
    <SolidColorBrush x:Key="FluentLightTextPrimary"   Color="#1C1C1C"/>
    <SolidColorBrush x:Key="FluentLightTextSecondary" Color="#575756"/>

    <!-- Sidebar Semantic Tokens (Prussian Blue #022057) -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#022057"/>
    <SolidColorBrush x:Key="SidebarSearchBackgroundBrush" Color="#043388"/>
    <SolidColorBrush x:Key="SidebarTextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarTextSecondaryBrush" Color="#8AAACF"/>
    <SolidColorBrush x:Key="SidebarUserCardBackgroundBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#062E7A"/>

    <!-- Neutral Dark Tokens: same values as Fluent2Styles.xaml.
         Required so pages using FluentDark* keys do not fall back to
         transparent. SS Default content is white so these are rarely
         visible but must resolve to a valid value. -->
    <SolidColorBrush x:Key="FluentDarkCanvasBg"      Color="#141414"/>
    <SolidColorBrush x:Key="FluentDarkCardBg"        Color="#1F1F1F"/>
    <SolidColorBrush x:Key="FluentDarkCardSubBg"     Color="#292929"/>
    <SolidColorBrush x:Key="FluentDarkStroke"        Color="#2E2E2E"/>
    <SolidColorBrush x:Key="FluentDarkTextPrimary"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FluentDarkTextSecondary" Color="#ADADAD"/>

    <!-- Status tokens -->
    <SolidColorBrush x:Key="FluentSuccess" Color="#107C41"/>
    <SolidColorBrush x:Key="FluentWarning" Color="#797700"/>
    <SolidColorBrush x:Key="FluentDanger"  Color="#C50F1F"/>

    <!-- Typography -->
    <FontFamily x:Key="FluentFontFamily">Segoe UI Variable Text, Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>

    <!-- Elevation Depth Shadows -->
    <DropShadowEffect x:Key="FluentDepth4"  BlurRadius="6"  ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.14"/>
    <DropShadowEffect x:Key="FluentDepth8"  BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.20"/>
    <DropShadowEffect x:Key="FluentDepth16" BlurRadius="24" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.28"/>

</ResourceDictionary>