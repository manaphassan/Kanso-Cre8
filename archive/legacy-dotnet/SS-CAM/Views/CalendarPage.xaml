<Page x:Class="SS_CAM.Views.CalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Big Calendar">

    <Grid PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
        <!-- Main Scrollable Content Canvas -->
        <ScrollViewer x:Name="PageScrollViewer" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
            <StackPanel Margin="24,14,24,24">
                <!-- Page Header & Summary Bar -->
                <StackPanel Margin="0,0,0,10">
                    <!-- Header Title -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:SymbolIcon Symbol="CalendarMonth24" FontSize="24" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ui:TextBlock Text="Visual Project Timeline &amp; Calendar" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ui:TextBlock Text="Monthly project schedule, visual Gantt timeline charts, and deliverable deadlines." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,2,0,12" />

                    <!-- KPI Quick Summary Cards (4 Cards) -->
                    <UniformGrid Columns="4" Margin="0,0,0,0">
                        <!-- Deadlines This Month -->
                        <ui:Card Padding="12,8" Margin="0,0,8,0">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <ui:SymbolIcon Symbol="Clock24" FontSize="13" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="DEADLINES THIS MONTH" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                </StackPanel>
                                <ui:TextBlock x:Name="MetricDeadlinesMonth" Text="0" Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="22" FontWeight="Bold"/>
                                <ui:TextBlock Text="Scheduled deliverables" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" Margin="0,1,0,0"/>
                            </StackPanel>
                        </ui:Card>

                        <!-- Started This Month -->
                        <ui:Card Padding="12,8" Margin="0,0,8,0">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <ui:SymbolIcon Symbol="Play24" FontSize="13" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="STARTED THIS MONTH" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                </StackPanel>
                                <ui:TextBlock x:Name="MetricStartedMonth" Text="0" Foreground="{DynamicResource FluentBrand80}" FontSize="22" FontWeight="Bold"/>
                                <ui:TextBlock Text="New projects kicked off" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" Margin="0,1,0,0"/>
                            </StackPanel>
                        </ui:Card>

                        <!-- Overdue / Critical -->
                        <ui:Card Padding="12,8" Margin="0,0,8,0">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="OVERDUE / CRITICAL" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                </StackPanel>
                                <ui:TextBlock x:Name="MetricOverdue" Text="0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="22" FontWeight="Bold"/>
                                <ui:TextBlock Text="Past due dates" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" Margin="0,1,0,0"/>
                            </StackPanel>
                        </ui:Card>

                        <!-- Total Active Projects -->
                        <ui:Card Padding="12,8">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <ui:SymbolIcon Symbol="Folder24" FontSize="13" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="TOTAL PROJECTS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" FontWeight="Bold"/>
                                </StackPanel>
                                <ui:TextBlock x:Name="MetricTotalProjects" Text="0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontSize="22" FontWeight="Bold"/>
                                <ui:TextBlock Text="Active tracked projects" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" Margin="0,1,0,0"/>
                            </StackPanel>
                        </ui:Card>
                    </UniformGrid>
                </StackPanel>

                <!-- Interactive Control Bar (Month Navigation & Filters) -->
                <ui:Card Padding="12,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Month Navigation Buttons & Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Click="OnPrevMonthClicked" Appearance="Secondary" Height="32" Padding="10,0" Cursor="Hand" Margin="0,0,6,0" ToolTip="Previous Month">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Prev" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Click="OnTodayClicked" Appearance="Primary" Height="32" Padding="12,0" Cursor="Hand" Margin="0,0,6,0" ToolTip="Go to Current Month">
                                <ui:TextBlock Text="Today" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                            </ui:Button>

                            <ui:Button Click="OnNextMonthClicked" Appearance="Secondary" Height="32" Padding="10,0" Cursor="Hand" Margin="0,0,16,0" ToolTip="Next Month">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="Next" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                            <ui:TextBlock x:Name="TxtCurrentMonthTitle" Text="August 2026" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Centered Filters -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:TextBox x:Name="TxtSearchQuery" Width="180" Height="32" Padding="8,4" VerticalContentAlignment="Center" PlaceholderText="Filter projects..." Icon="Search24" TextChanged="OnSearchQueryChanged" FontSize="11" Margin="0,0,10,0"/>

                            <ui:TextBlock Text="Designer:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="DesignerFilter" Width="130" Height="32" Padding="8,4" VerticalContentAlignment="Center" SelectionChanged="OnFilterChanged" FontSize="11" Margin="0,0,10,0"/>

                            <ui:TextBlock Text="Status:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="StatusFilter" Width="120" Height="32" Padding="8,4" VerticalContentAlignment="Center" SelectionChanged="OnFilterChanged" FontSize="11">
                                <ComboBoxItem Content="All Statuses" IsSelected="True" VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="backlog" VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="in-progress" VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="review" VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="done" VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="on-hold" VerticalContentAlignment="Center"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Actions & View Switcher -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Segmented View Switcher Buttons -->
                            <Border Background="{DynamicResource TextControlBackground}" CornerRadius="6" Padding="2" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button x:Name="BtnViewGrid" Click="OnViewGridClicked" Appearance="Primary" Width="32" Height="28" Padding="0" Cursor="Hand" ToolTip="Grid View (Monthly Calendar)">
                                        <ui:SymbolIcon Symbol="CalendarMonth24" FontSize="14" VerticalAlignment="Center"/>
                                    </ui:Button>
                                    <ui:Button x:Name="BtnViewGantt" Click="OnViewGanttClicked" Appearance="Secondary" Width="32" Height="28" Padding="0" Cursor="Hand" ToolTip="Gantt Timeline (Visual Project Chart)">
                                        <ui:SymbolIcon Symbol="Timeline24" FontSize="14" VerticalAlignment="Center"/>
                                    </ui:Button>
                                </StackPanel>
                            </Border>

                            <ui:Button Appearance="Secondary" Click="OnRefreshClicked" Width="32" Height="32" Padding="0" Cursor="Hand" ToolTip="Refresh Calendar &amp; Timeline Data">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" VerticalAlignment="Center"/>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Main Monthly Grid Canvas Container -->
                <StackPanel x:Name="CalendarGridContainer" Margin="0,0,0,14" Visibility="Visible">
                    <!-- Day Name Headers Bar -->
                    <UniformGrid Columns="7" Margin="0,0,0,6">
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="8,6" CornerRadius="4,0,0,4" Margin="0,0,4,0">
                            <ui:TextBlock Text="SUN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="8,6" Margin="0,0,4,0">
                            <ui:TextBlock Text="MON" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="8,6" Margin="0,0,4,0">
                            <ui:TextBlock Text="TUE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="8,6" Margin="0,0,4,0">
                            <ui:TextBlock Text="WED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="8,6" Margin="0,0,4,0">
                            <ui:TextBlock Text="THU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="8,6" Margin="0,0,4,0">
                            <ui:TextBlock Text="FRI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="8,6" CornerRadius="0,4,4,0">
                            <ui:TextBlock Text="SAT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </Border>
                    </UniformGrid>

                    <!-- Dynamic 7x6 Day Cells Grid Container -->
                    <UniformGrid x:Name="CalendarGrid" Columns="7" VerticalAlignment="Top"/>
                </StackPanel>

                <!-- Visual Project Timeline / Gantt Chart Canvas Container -->
                <ui:Card x:Name="GanttContainer" Margin="0,0,0,14" Padding="14,12" Visibility="Collapsed">
                    <Grid x:Name="GanttGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Gantt Timeline Off-Days & Status Legend Bar -->
                        <Border Grid.Row="0" Margin="0,0,0,10" Padding="10,6" Background="{DynamicResource TextControlBackground}" CornerRadius="6" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Info24" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ui:TextBlock Text="Timeline Off-Days &amp; Conflict Guide:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <!-- Working Days -->
                                    <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ui:TextBlock Text="Working Day" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <!-- Weekend Off-Day -->
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#1864748B" BorderBrush="#3564748B" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ui:TextBlock Text="Weekend (Sat/Sun Off-Day)" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <!-- Public Holiday Off-Day -->
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#28EF4444" BorderBrush="#60EF4444" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ui:TextBlock Text="🇲🇾 Public Holiday (Off-Day)" FontSize="10" Foreground="#DC2626" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <!-- Today Marker -->
                                    <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ui:TextBlock Text="Today" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                    <!-- Conflict Alert -->
                                    <ui:TextBlock Text="⚠️ Due on Off-Day (Reschedule Required)" FontSize="10" Foreground="#DC2626" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Timeline Header Row (Days of current month) -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="8,6" CornerRadius="6" Margin="0,0,0,8">
                            <Grid x:Name="GanttHeaderGrid"/>
                        </Border>

                        <!-- Timeline Rows Stack with Today Guide Line Overlay & Background Grid Fills -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="520">
                            <Grid>
                                <Grid x:Name="GanttBackgroundGrid" IsHitTestVisible="False" Panel.ZIndex="0"/>
                                <StackPanel x:Name="GanttRowsStack" Panel.ZIndex="1"/>
                                <Grid x:Name="GanttTodayRowsGrid" IsHitTestVisible="False" Panel.ZIndex="10"/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Day Detail Side Overlay Drawer -->
        <Border x:Name="DayDetailPanel"
                Width="380" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <DockPanel Margin="20" LastChildFill="True">
                <!-- Close Button -->
                <ui:Button DockPanel.Dock="Top" Click="OnCloseDayDetail" HorizontalAlignment="Right"
                           Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,0,12" ToolTip="Close Panel">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </ui:Button>

                <!-- Selected Date Title -->
                <ui:TextBlock DockPanel.Dock="Top" x:Name="DayDetailTitle"
                              Text="August 12, 2026" FontSize="16" FontWeight="Bold"
                              Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,4"/>
                <ui:TextBlock DockPanel.Dock="Top" x:Name="DayDetailSubtitle"
                              Text="3 projects scheduled for this date" FontSize="12"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>

                <!-- Day Schedule List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DayDetailItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,0,10" Padding="12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Background="{Binding PriorityColor}" Visibility="{Binding PriorityBadgeVisibility}" CornerRadius="4" Padding="5,2" Margin="0,0,8,0">
                                                <ui:TextBlock Text="{Binding PriorityBadgeText}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <Border Background="{DynamicResource TextControlBackground}" CornerRadius="4" Padding="5,2">
                                                <ui:TextBlock Text="{Binding EventType}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <ui:TextBlock Text="{Binding Project}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,2"/>
                                        <ui:TextBlock Text="{Binding DesignerDisplay}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ui:Button Click="OnOpenProjectFolderClicked" Tag="{Binding FullPath}" Appearance="Secondary" Width="28" Height="28" Padding="0" Cursor="Hand" ToolTip="Open Folder">
                                                <ui:SymbolIcon Symbol="Folder24" FontSize="13" VerticalAlignment="Center"/>
                                            </ui:Button>
                                        </StackPanel>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Page>
