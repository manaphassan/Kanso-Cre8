<Page x:Class="SS_CAM.Views.CopywritingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1200"
      Title="Copywriting Studio"
      Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <ScrollViewer x:Name="PageScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24"
                      PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
        <StackPanel HorizontalAlignment="Stretch">

            <!-- 1. PAGE HEADER -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <ui:TextBlock Text="COPYWRITING &amp; AD SCRIPTING" FontSize="11" FontWeight="Bold"
                                  Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,2"/>
                    <ui:TextBlock Text="Copywriting Studio" FontSize="24" FontWeight="Bold"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBlock Text="Draft, optimize, and persist high-converting copy directly into 03_COPYWRITING/COPY.md with live WhatsApp &amp; Ad preview."
                                  FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnCopyPlainText" Appearance="Secondary" Margin="0,0,8,0"
                               Click="OnCopyPlainTextClicked" Cursor="Hand" ToolTip="Copy clean plain text (strips markdown formatting for Ads/WhatsApp)">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DocumentBulletList24" Margin="0,0,6,0" FontSize="14"/>
                            <ui:TextBlock Text="Copy Plain Text"/>
                        </StackPanel>
                    </ui:Button>

                    <ui:Button x:Name="BtnCopyClipboard" Appearance="Secondary" Margin="0,0,8,0"
                               Click="OnCopyClipboardClicked" Cursor="Hand" ToolTip="Copy raw Markdown script to clipboard">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Copy24" Margin="0,0,6,0" FontSize="14"/>
                            <ui:TextBlock Text="Copy Markdown"/>
                        </StackPanel>
                    </ui:Button>

                    <ui:Button x:Name="BtnSaveScript" Appearance="Primary"
                               Click="OnSaveScriptClicked" Cursor="Hand" ToolTip="Save changes directly to NAS COPY.md">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0" FontSize="14"/>
                            <ui:TextBlock Text="Save to NAS"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- 2. PROJECT SELECTION & STATUS BANNER -->
            <ui:Card Margin="0,0,0,16" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Row: Project Selector -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Folder24" Margin="0,0,8,0" FontSize="16" Foreground="{DynamicResource FluentBrand80}"/>
                            <ui:TextBlock Text="Select Project:" FontWeight="SemiBold" FontSize="13"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ComboBox x:Name="ProjectSelectorCmb" Grid.Column="1" Height="36"
                                  Padding="10,6" FontSize="12.5"
                                  SelectionChanged="OnProjectSelectionChanged" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                  Background="{DynamicResource TextControlBackground}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <ui:TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                  Padding="4,2"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <ui:Button x:Name="BtnReloadProjects" Grid.Column="2" Appearance="Secondary" Margin="8,0,0,0"
                                   Click="OnReloadProjectsClicked" Height="36" Cursor="Hand" ToolTip="Rescan workspace projects">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14"/>
                        </ui:Button>

                        <ui:Button x:Name="BtnOpenFolder" Grid.Column="3" Appearance="Secondary" Margin="8,0,0,0"
                                   Click="OnOpenFolderClicked" Height="36" Cursor="Hand" ToolTip="Open project folder in Windows Explorer">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" FontSize="14"/>
                                <ui:TextBlock Text="Open Folder"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <!-- Bottom Row: Path & Status Feedback with Pill Badge -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBlock Text="File Location: " FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBlock x:Name="TxtFilePath" Text="No project selected" FontSize="11.5"
                                          FontFamily="Consolas" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Status Pill Badge -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="10,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusBadgeDot" Width="6" Height="6" Fill="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0"/>
                                <ui:TextBlock x:Name="TxtSaveStatus" Text="Ready" FontSize="11" FontWeight="SemiBold"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ui:Card>

            <!-- 3. LIVE COPY TELEMETRY METRICS (5 METRIC CARDS) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Words -->
                <ui:Card Grid.Column="0" Margin="0,0,4,0" Padding="12">
                    <StackPanel>
                        <ui:TextBlock Text="WORD COUNT" FontSize="10" FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBlock x:Name="TxtMetricWords" Text="0 words" FontSize="18" FontWeight="Bold"
                                      Foreground="{DynamicResource FluentBrand80}" Margin="0,4,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Characters -->
                <ui:Card Grid.Column="1" Margin="4,0,4,0" Padding="12">
                    <StackPanel>
                        <ui:TextBlock Text="CHARACTERS" FontSize="10" FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBlock x:Name="TxtMetricChars" Text="0 chars" FontSize="18" FontWeight="Bold"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Reading Duration -->
                <ui:Card Grid.Column="2" Margin="4,0,4,0" Padding="12">
                    <StackPanel>
                        <ui:TextBlock Text="SILENT READING" FontSize="10" FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBlock x:Name="TxtMetricReadingTime" Text="0 sec" FontSize="18" FontWeight="Bold"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Speaking VO Duration -->
                <ui:Card Grid.Column="3" Margin="4,0,4,0" Padding="12">
                    <StackPanel>
                        <ui:TextBlock Text="SPEAKING VO (~130 WPM)" FontSize="10" FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBlock x:Name="TxtMetricSpeakingTime" Text="0 sec" FontSize="18" FontWeight="Bold"
                                      Foreground="{DynamicResource FluentBrand80}" Margin="0,4,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Line Count -->
                <ui:Card Grid.Column="4" Margin="4,0,0,0" Padding="12">
                    <StackPanel>
                        <ui:TextBlock Text="LINE COUNT" FontSize="10" FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBlock x:Name="TxtMetricLines" Text="0 lines" FontSize="18" FontWeight="Bold"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- 4. MAIN COPY EDITOR & LIVE SIMULATION WORKSPACE -->
            <ui:Card Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Workspace Header & 4-Way View Mode Switcher -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBlock x:Name="TxtCanvasHeader" Text="Rendered Copy Preview (FlowDocument)" FontWeight="Bold" FontSize="14"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            <ui:TextBlock x:Name="TxtEditorShortcutHint" Text="&#x2022; Press Ctrl+S to save instantly to NAS" FontSize="11.5"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                          Margin="8,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        
                        <!-- 4-Way Mode Segmented Switcher -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <!-- 1. Preview Live Markdown (Default) -->
                                <ui:Button x:Name="BtnModePreview" Appearance="Primary" Height="28" Padding="10,0" Margin="0,0,2,0"
                                           Click="OnModePreviewClicked" Cursor="Hand" ToolTip="Preview Live Markdown (Default View)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Eye24" Margin="0,0,4,0" FontSize="13"/>
                                        <ui:TextBlock Text="Preview Live" FontSize="11.5"/>
                                    </StackPanel>
                                </ui:Button>

                                <!-- 2. Split View (Live & Edit Markdown Side by Side) -->
                                <ui:Button x:Name="BtnModeSplit" Appearance="Secondary" Height="28" Padding="10,0" Margin="0,0,2,0"
                                           Click="OnModeSplitClicked" Cursor="Hand" ToolTip="Split View: Raw Editor &amp; Live Rendered Markdown side by side">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="SplitVertical24" Margin="0,0,4,0" FontSize="13"/>
                                        <ui:TextBlock Text="Split View" FontSize="11.5"/>
                                    </StackPanel>
                                </ui:Button>

                                <!-- 3. Edit Mode (Full Width Editor) -->
                                <ui:Button x:Name="BtnModeEdit" Appearance="Secondary" Height="28" Padding="10,0" Margin="0,0,2,0"
                                           Click="OnModeEditClicked" Cursor="Hand" ToolTip="Edit Mode: Full Width Markdown Editor">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Edit24" Margin="0,0,4,0" FontSize="13"/>
                                        <ui:TextBlock Text="Edit Mode" FontSize="11.5"/>
                                    </StackPanel>
                                </ui:Button>

                                <!-- 4. Mockup View (Ad & WhatsApp Simulation) -->
                                <ui:Button x:Name="BtnModeMockup" Appearance="Secondary" Height="28" Padding="10,0"
                                           Click="OnModeMockupClicked" Cursor="Hand" ToolTip="Mockup View: Live WhatsApp &amp; Meta Ad Simulation">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Phone24" Margin="0,0,4,0" FontSize="13"/>
                                        <ui:TextBlock Text="Mockup View" FontSize="11.5"/>
                                    </StackPanel>
                                </ui:Button>

                                <!-- 5. Sidebar Focus Mode Toggle -->
                                <Border Width="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="4,3,4,3"/>
                                <ui:Button x:Name="BtnToggleRightPane" Appearance="Secondary" Height="28" Padding="8,0"
                                           Click="OnToggleRightPaneClicked" Cursor="Hand" ToolTip="Toggle Properties &amp; Snippets Sidebar (Focus Mode)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Navigation24" Margin="0,0,4,0" FontSize="12"/>
                                        <ui:TextBlock Text="Sidebar" FontSize="11"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Workspace Content Grid (Full Height) -->
                    <Grid Grid.Row="1" MinHeight="720" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColEditor" Width="*"/>
                            <ColumnDefinition x:Name="ColSplitter" Width="0"/>
                            <ColumnDefinition x:Name="ColLivePreview" Width="0"/>
                            <ColumnDefinition x:Name="ColRightSplitter" Width="Auto"/>
                            <ColumnDefinition x:Name="ColRightPane" Width="320" MinWidth="0" MaxWidth="440"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Primary Canvas (FlowDocument in Preview Live, Editor in Edit & Split) -->
                        <Grid Grid.Column="0" VerticalAlignment="Stretch">
                            <!-- 1. Full FlowDocument Viewer (Active in Preview Live Mode) -->
                            <FlowDocumentScrollViewer x:Name="RenderedCopyViewer"
                                                      MinHeight="700"
                                                      VerticalScrollBarVisibility="Auto"
                                                      VerticalAlignment="Stretch"
                                                      FontFamily="{DynamicResource FluentFontFamily}"
                                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                      Background="{DynamicResource TextControlBackground}"
                                                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                      BorderThickness="1"
                                                      Padding="18"
                                                      Visibility="Visible"/>

                            <!-- 2. Raw Markdown Editor (Active in Edit Mode & Split Left) -->
                            <TextBox x:Name="CopyScriptEditor"
                                     MinHeight="700"
                                     VerticalAlignment="Stretch"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     FontFamily="Cascadia Code, Consolas, Segoe UI Mono, monospace"
                                     FontSize="12.5"
                                     Padding="16"
                                     Background="{DynamicResource TextControlBackground}"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                     BorderThickness="1"
                                     TextChanged="OnCopyScriptTextChanged"
                                     KeyDown="OnEditorKeyDown"
                                     Visibility="Collapsed"/>
                        </Grid>

                        <!-- COLUMN SPLITTER (Active in Split Mode) -->
                        <GridSplitter x:Name="LiveGridSplitter" Grid.Column="1" HorizontalAlignment="Stretch"
                                      Background="Transparent" Cursor="SizeWE" Visibility="Collapsed"/>

                        <!-- RIGHT COLUMN: SPLIT LIVE RENDERED MARKDOWN OR MOCKUP VIEW -->
                        <Grid x:Name="RightPaneContainer" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Stretch">
                            <!-- 1. Split Live Rendered FlowDocument (Right pane in Split Mode) -->
                            <FlowDocumentScrollViewer x:Name="RenderedCopyViewerSplit"
                                                      MinHeight="700"
                                                      VerticalScrollBarVisibility="Auto"
                                                      VerticalAlignment="Stretch"
                                                      FontFamily="{DynamicResource FluentFontFamily}"
                                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                      Background="{DynamicResource TextControlBackground}"
                                                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                      BorderThickness="1"
                                                      Padding="18"
                                                      Visibility="Collapsed"/>

                            <!-- 2. Ad & WhatsApp Live Mockups (Mockup View - Side by Side) -->
                            <Border x:Name="LivePreviewPanel"
                                    MinHeight="700"
                                    VerticalAlignment="Stretch"
                                    Background="{DynamicResource TextControlBackground}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16"
                                    Visibility="Collapsed">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Left: WhatsApp Broadcast Mockup -->
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <!-- Right: Meta Sponsored Ad Mockup -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- WhatsApp Live Simulation Card -->
                                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="10" VerticalAlignment="Top">
                                            <StackPanel>
                                                <!-- WhatsApp Header Bar -->
                                                <Border Background="#075E54" CornerRadius="9,9,0,0" Padding="14,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Ellipse Grid.Column="0" Width="28" Height="28" Fill="#25D366" Margin="0,0,10,0"/>
                                                        
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <ui:TextBlock Text="SuamiSihat&#x2122; Official" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF"/>
                                                            <ui:TextBlock Text="WhatsApp Broadcast Live Preview" FontSize="10" Foreground="#DCF8C6"/>
                                                        </StackPanel>

                                                        <Border Grid.Column="2" Background="#128C7E" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                            <ui:TextBlock Text="WHATSAPP BROADCAST" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- WhatsApp Chat Bubble Surface -->
                                                <Border Background="#E5DDD5" Padding="14" MinHeight="260">
                                                    <Border Background="#FFFFFF" CornerRadius="8" Padding="12,10" HorizontalAlignment="Stretch"
                                                            BorderBrush="#D0D7DE" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock x:Name="TxtWhatsAppLiveContent" Text="Drafting your copy in the editor on the left will render formatted text here in real time..."
                                                                       TextWrapping="Wrap" FontSize="12.5" FontFamily="Segoe UI" LineHeight="19"
                                                                       Foreground="#111B21"/>
                                                            
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                                <TextBlock x:Name="TxtWhatsAppTimestamp" Text="10:30 AM" FontSize="9.5" Foreground="#667781" Margin="0,0,4,0"/>
                                                                <TextBlock Text="&#x2713;&#x2713;" FontSize="9.5" FontWeight="Bold" Foreground="#53BDEB"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Meta Ad Primary Text Card -->
                                        <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="14" VerticalAlignment="Top">
                                            <StackPanel>
                                                <!-- Meta Sponsor Header -->
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Ellipse Grid.Column="0" Width="30" Height="30" Fill="{DynamicResource FluentBrand80}" Margin="0,0,10,0"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <ui:TextBlock Text="SuamiSihat" FontWeight="SemiBold" FontSize="12.5"
                                                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        <ui:TextBlock Text="Sponsored &#x2022; Meta Ads (FB/IG Feed)" FontSize="10"
                                                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <ui:SymbolIcon Grid.Column="2" Symbol="MoreHorizontal24" FontSize="14"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Ad Body Text -->
                                                <TextBlock x:Name="TxtMetaAdLiveContent" Text="Primary ad copy will appear here formatted for Facebook &amp; Instagram feed ads."
                                                           TextWrapping="Wrap" FontSize="12" FontFamily="Segoe UI" LineHeight="18"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,14"/>

                                                <!-- Mock CTA Footer -->
                                                <Border Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <ui:TextBlock Text="SUAMISIHAT.CLINIC" FontSize="9.5" FontWeight="SemiBold"
                                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            <ui:TextBlock Text="Dapatkan Konsultasi &amp; Rawatan Premium" FontSize="11" FontWeight="Bold"
                                                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </StackPanel>

                                                        <Border Grid.Column="1" Background="{DynamicResource FluentBrand80}" CornerRadius="4" Padding="12,6">
                                                            <ui:TextBlock Text="Send Message" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- COLUMN 3: Subtle Draggable Splitter for Right Pane -->
                        <GridSplitter x:Name="RightPaneGridSplitter" Grid.Column="3" Width="6"
                                      HorizontalAlignment="Center" Background="Transparent"
                                      Cursor="SizeWE" Margin="4,0,4,0"/>

                        <!-- COLUMN 4: RIGHT PROPERTY PANE & QUICK SNIPPETS -->
                        <Border x:Name="RightPropertyPane" Grid.Column="4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- 1. Segmented Tab Selector Header -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- 2. Tab Content Container -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Segmented Tab Header -->
                                <Border Grid.Row="0" Background="{DynamicResource TextControlBackground}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="2" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:Button x:Name="BtnRightTabProperties" Grid.Column="0" Appearance="Primary" Height="28"
                                                   Click="OnRightTabPropertiesClicked" Cursor="Hand" ToolTip="View Project Properties &amp; Metadata">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Settings24" Margin="0,0,5,0" FontSize="12"/>
                                                <ui:TextBlock Text="Properties" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </ui:Button>

                                        <ui:Button x:Name="BtnRightTabSnippets" Grid.Column="1" Appearance="Secondary" Height="28"
                                                   Click="OnRightTabSnippetsClicked" Cursor="Hand" ToolTip="Quick Snippets &amp; Ad Hooks">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Flash24" Margin="0,0,5,0" FontSize="12"/>
                                                <ui:TextBlock Text="Snippets" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </ui:Button>
                                    </Grid>
                                </Border>

                                <!-- TAB 1: PROPERTIES CONTENT (Matches Web Portal Layout) -->
                                <ScrollViewer x:Name="PanePropertiesContent" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,0,2,0">
                                        <!-- ASSIGNEE (DESIGNER) -->
                                        <StackPanel Margin="0,0,0,12">
                                            <ui:TextBlock Text="ASSIGNEE (DESIGNER)" FontSize="9.5" FontWeight="Bold"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource FluentBrand80}" Margin="0,0,8,0">
                                                    <ui:TextBlock x:Name="TxtPropDesignerInitial" Text="H" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ui:TextBlock x:Name="TxtPropDesigner" Text="Harussani" FontSize="12.5" FontWeight="SemiBold"
                                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,10,0,0" Opacity="0.5"/>
                                        </StackPanel>

                                        <!-- REVIEWER -->
                                        <StackPanel Margin="0,0,0,12">
                                            <ui:TextBlock Text="REVIEWER" FontSize="9.5" FontWeight="Bold"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="26" Height="26" CornerRadius="13" Background="#0078D4" Margin="0,0,8,0">
                                                    <ui:TextBlock Text="HA" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Background="{DynamicResource TextControlBackground}"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Stretch">
                                                    <ui:TextBlock x:Name="TxtPropReviewer" Text="Hasan · Manager" FontSize="12" FontWeight="Normal"
                                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                            <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,10,0,0" Opacity="0.5"/>
                                        </StackPanel>

                                        <!-- CORPORATE BRAND / SUBSIDIARY -->
                                        <StackPanel Margin="0,0,0,12">
                                            <ui:TextBlock Text="CORPORATE BRAND / SUBSIDIARY" FontSize="9.5" FontWeight="Bold"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#043388" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <ui:TextBlock x:Name="TxtPropBrandPill" Text="SSE" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </Border>
                                                <ui:TextBlock x:Name="TxtPropBrandName" Text="SuamiSihat Ecommerce Sdn Bhd" FontSize="11.5"
                                                              TextTrimming="CharacterEllipsis" MaxWidth="210"
                                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,10,0,0" Opacity="0.5"/>
                                        </StackPanel>

                                        <!-- PRIORITY LEVEL -->
                                        <StackPanel Margin="0,0,0,12">
                                            <ui:TextBlock Text="PRIORITY LEVEL" FontSize="9.5" FontWeight="Bold"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <Border x:Name="BadgePropPriority" Background="#FEF3C7" BorderBrush="#FCD34D"
                                                    BorderThickness="1" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                                                <ui:TextBlock x:Name="TxtPropPriority" Text="MEDIUM" FontSize="10" FontWeight="Bold" Foreground="#D97706"/>
                                            </Border>
                                            <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,10,0,0" Opacity="0.5"/>
                                        </StackPanel>

                                        <!-- CAMPAIGN DEADLINE -->
                                        <StackPanel Margin="0,0,0,12">
                                            <ui:TextBlock Text="CAMPAIGN DEADLINE" FontSize="9.5" FontWeight="Bold"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Calendar24" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0"/>
                                                <ui:TextBlock x:Name="TxtPropDeadline" Text="2026-09-06" FontSize="12" FontWeight="SemiBold"
                                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                            <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,10,0,0" Opacity="0.5"/>
                                        </StackPanel>

                                        <!-- DELIVERABLES STORAGE (Interactive 1-Click Folder Launcher) -->
                                        <StackPanel Margin="0,0,0,12">
                                            <ui:TextBlock Text="DELIVERABLES STORAGE" FontSize="9.5" FontWeight="Bold"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <Border MouseLeftButtonUp="OnOpenDeliverablesFolderClicked" Cursor="Hand"
                                                    Background="{DynamicResource TextControlBackground}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="8,6"
                                                    ToolTip="Click to open 05_DELIVERABLES in Windows Explorer">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Grid.Column="0" Symbol="Folder24" FontSize="13"
                                                                   Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <ui:TextBlock Grid.Column="1" x:Name="TxtPropDeliverablesCount" Text="0 files" FontSize="12"
                                                                  FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                  VerticalAlignment="Center"/>
                                                    <ui:SymbolIcon Grid.Column="2" Symbol="Open24" FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,10,0,0" Opacity="0.5"/>
                                        </StackPanel>

                                        <!-- RECENT APPROVALS & SIGN-OFFS -->
                                        <StackPanel Margin="0,0,0,4">
                                            <ui:TextBlock Text="RECENT APPROVALS &amp; SIGN-OFFS" FontSize="9.5" FontWeight="Bold"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                            <ui:TextBlock x:Name="TxtPropApprovalStatus" Text="No approval records yet." FontSize="11.5"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- TAB 2: SNIPPETS & HOOKS CONTENT (Relocated Drawer) -->
                                <ScrollViewer x:Name="PaneSnippetsContent" Grid.Row="1" Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,0,2,0">
                                        <!-- Header row with Reset Template button -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBlock Grid.Column="0" Text="CLICK TO INSERT AT CURSOR" FontSize="9" FontWeight="Bold"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                            <ui:Button x:Name="BtnResetTemplate" Grid.Column="1" Appearance="Secondary" Height="24" Padding="6,0"
                                                       Click="OnResetTemplateClicked" Cursor="Hand" ToolTip="Reset to standard brand copy template">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="DocumentSync24" Margin="0,0,3,0" FontSize="11"/>
                                                    <ui:TextBlock Text="Reset" FontSize="10"/>
                                                </StackPanel>
                                            </ui:Button>
                                        </Grid>

                                        <!-- Section 1: Viral Frameworks -->
                                        <ui:TextBlock Text="VIRAL AD FRAMEWORKS" FontSize="9.5" FontWeight="Bold"
                                                      Foreground="{DynamicResource FluentBrand80}" Margin="0,4,0,6"/>

                                        <ui:Button x:Name="BtnInsertTikTok" Appearance="Secondary" Margin="0,0,0,6" Height="28" Padding="8,0"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                   Click="OnInsertTikTokClicked" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Video24" Margin="0,0,6,0" FontSize="12"/>
                                                <ui:TextBlock Text="TikTok 3-Hook Table" FontSize="11.5"/>
                                            </StackPanel>
                                        </ui:Button>

                                        <ui:Button x:Name="BtnInsertMetaPas" Appearance="Secondary" Margin="0,0,0,6" Height="28" Padding="8,0"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                   Click="OnInsertMetaPasClicked" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Speaker224" Margin="0,0,6,0" FontSize="12"/>
                                                <ui:TextBlock Text="Meta PAS Framework" FontSize="11.5"/>
                                            </StackPanel>
                                        </ui:Button>

                                        <ui:Button x:Name="BtnInsertWhatsApp" Appearance="Secondary" Margin="0,0,0,6" Height="28" Padding="8,0"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                   Click="OnInsertWhatsAppClicked" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Chat24" Margin="0,0,6,0" FontSize="12"/>
                                                <ui:TextBlock Text="WhatsApp Broadcast" FontSize="11.5"/>
                                            </StackPanel>
                                        </ui:Button>

                                        <ui:Button x:Name="BtnInsertNeubrutalist" Appearance="Secondary" Margin="0,0,0,6" Height="28" Padding="8,0"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                   Click="OnInsertNeubrutalistClicked" Cursor="Hand" ToolTip="High-CTR bold direct-response ad framework">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Flash24" Margin="0,0,6,0" FontSize="12"/>
                                                <ui:TextBlock Text="Neubrutalist Hook" FontSize="11.5"/>
                                            </StackPanel>
                                        </ui:Button>

                                        <ui:Button x:Name="BtnInsertRetro" Appearance="Secondary" Margin="0,0,0,6" Height="28" Padding="8,0"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                   Click="OnInsertRetroClicked" Cursor="Hand" ToolTip="Retro-futuristic nostalgic storytelling framework">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Games24" Margin="0,0,6,0" FontSize="12"/>
                                                <ui:TextBlock Text="Retro Story Angle" FontSize="11.5"/>
                                            </StackPanel>
                                        </ui:Button>

                                        <ui:Button x:Name="BtnInsertClaims" Appearance="Secondary" Margin="0,0,0,12" Height="28" Padding="8,0"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                   Click="OnInsertClaimsClicked" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Checkmark24" Margin="0,0,6,0" FontSize="12"/>
                                                <ui:TextBlock Text="Claims Matrix" FontSize="11.5"/>
                                            </StackPanel>
                                        </ui:Button>

                                        <!-- Section 2: Ad Hooks & CTAs -->
                                        <ui:TextBlock Text="AD HOOKS &amp; SCARCITY" FontSize="9.5" FontWeight="Bold"
                                                      Foreground="{DynamicResource FluentBrand80}" Margin="0,4,0,6"/>

                                        <ui:Button x:Name="BtnSnippetWhatsappLink" Appearance="Secondary" Margin="0,0,0,6" Height="28" Padding="8,0"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                   Click="OnSnippetWhatsappLinkClicked" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Link24" Margin="0,0,6,0" FontSize="12"/>
                                                <ui:TextBlock Text="WhatsApp CTA Link" FontSize="11.5"/>
                                            </StackPanel>
                                        </ui:Button>

                                        <ui:Button x:Name="BtnSnippetPromoVoucher" Appearance="Secondary" Margin="0,0,0,6" Height="28" Padding="8,0"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                   Click="OnSnippetPromoVoucherClicked" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Tag24" Margin="0,0,6,0" FontSize="12"/>
                                                <ui:TextBlock Text="Promo Voucher Code" FontSize="11.5"/>
                                            </StackPanel>
                                        </ui:Button>

                                        <ui:Button x:Name="BtnSnippetKkmDisclaimer" Appearance="Secondary" Margin="0,0,0,6" Height="28" Padding="8,0"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                   Click="OnSnippetKkmDisclaimerClicked" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Shield24" Margin="0,0,6,0" FontSize="12"/>
                                                <ui:TextBlock Text="KKM Disclaimer" FontSize="11.5"/>
                                            </StackPanel>
                                        </ui:Button>

                                        <ui:Button x:Name="BtnSnippetHalalGuarantee" Appearance="Secondary" Margin="0,0,0,6" Height="28" Padding="8,0"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                   Click="OnSnippetHalalGuaranteeClicked" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Certificate24" Margin="0,0,6,0" FontSize="12"/>
                                                <ui:TextBlock Text="100% Original Guarantee" FontSize="11.5"/>
                                            </StackPanel>
                                        </ui:Button>

                                        <ui:Button x:Name="BtnSnippetUrgencyTimer" Appearance="Secondary" Margin="0,0,0,6" Height="28" Padding="8,0"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                   Click="OnSnippetUrgencyTimerClicked" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Timer24" Margin="0,0,6,0" FontSize="12"/>
                                                <ui:TextBlock Text="Urgency Scarcity Box" FontSize="11.5"/>
                                            </StackPanel>
                                        </ui:Button>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>

        <!-- ── Smooth Fluent 2 Loading Overlay (Indeterminate Ring & Feedback) ── -->
        <Border x:Name="LoadingOverlay" Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
                Opacity="0.88" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="44" Height="44"
                                 Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,16"/>
                <ui:TextBlock x:Name="TxtLoadingMessage" Text="Loading Copywriting Workspace..."
                              FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBlock Text="Reading briefs and COPY.md from Synology NAS"
                              FontSize="11.5" HorizontalAlignment="Center"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>


