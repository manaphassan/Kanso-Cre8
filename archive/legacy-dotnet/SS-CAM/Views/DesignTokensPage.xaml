<Page x:Class="SS_CAM.Views.DesignTokensPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Design Tokens">

    <Page.Resources>
        <!-- Token group header style -->
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9D9D9D"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
        </Style>

        <!-- Token row card style -->
        <Style x:Key="TokenCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                    <Setter Property="BorderBrush" Value="#21A1F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Copy button style -->
        <Style x:Key="CopyBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#043388"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#21A1F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#022057"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#1A1A1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header bar -->
            <RowDefinition Height="Auto"/>  <!-- Status / filter bar -->
            <RowDefinition Height="*"/>     <!-- Token list -->
        </Grid.RowDefinitions>

        <!-- ── PAGE HEADER ── -->
        <Border Grid.Row="0" Background="#202020" BorderBrush="#303030"
                BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <ui:TextBlock Text="Design Tokens" FontSize="24" FontWeight="Bold"
                               Foreground="#FFFFFF" FontFamily="Segoe UI Variable Display"/>
                    <ui:TextBlock x:Name="SubtitleText"
                               Text="Live token reference from fluent.css on the server."
                               Foreground="#9D9D9D" FontSize="12" Margin="0,3,0,0"
                               FontFamily="Segoe UI Variable Text"/>
                </StackPanel>

                <!-- Refresh + open-in-browser buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="RefreshBtn" Click="OnRefreshClicked"
                            Style="{StaticResource CopyBtnStyle}"
                            Content="&#x27F3;  Refresh" Margin="0,0,8,0" Padding="14,6"/>
                    <ui:Button x:Name="OpenBrowserBtn" Click="OnOpenInBrowserClicked"
                            Background="#2A2A2A" Foreground="#C8C8C8" BorderThickness="1"
                            BorderBrush="#3A3A3A" Padding="14,6" Cursor="Hand" FontSize="11"
                            FontFamily="Segoe UI Variable Text">
                        <ui:Button.Template>
                            <ControlTemplate TargetType="ui:Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#333333"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ui:Button.Template>
                        <ui:TextBlock Text="&#x1F310;  Open in Browser" Foreground="#C8C8C8" FontSize="11"
                                   FontFamily="Segoe UI Variable Text"/>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── STATUS / SEARCH BAR ── -->
        <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#303030"
                BorderThickness="0,0,0,1" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <Border Grid.Column="0" Background="#2A2A2A" BorderBrush="#3A3A3A"
                        BorderThickness="1" CornerRadius="5" Padding="10,6"
                        MaxWidth="360" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons"
                                   FontSize="13" Foreground="#606060"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#C8C8C8" FontSize="12" CaretBrush="#21A1F7"
                                 FontFamily="Segoe UI Variable Text"
                                 VerticalAlignment="Center"
                                 TextChanged="OnSearchTextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Filter tokens&#x2026;" Foreground="#505050"
                                                                       FontSize="12" FontFamily="Segoe UI Variable Text"
                                                                       Margin="0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Token count + copied notice -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TokenCountText" Text="&#x2014;"
                               Foreground="#606060" FontSize="11"
                               FontFamily="Segoe UI Variable Text" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock x:Name="CopiedNotice" Text=""
                               Foreground="#21A1F7" FontSize="11" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Text" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── TOKEN LIST ── -->
        <Grid Grid.Row="2">
            <!-- Loading overlay -->
            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Fetching fluent.css from server&#x2026;"
                           Foreground="#9D9D9D" FontSize="13" HorizontalAlignment="Center"
                           FontFamily="Segoe UI Variable Text"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                             Margin="0,12,0,0" Foreground="#21A1F7" Background="#303030"
                             BorderThickness="0"/>
            </StackPanel>

            <!-- Error panel -->
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#x26A0;" FontSize="32" HorizontalAlignment="Center" Foreground="#EAB308"/>
                <TextBlock x:Name="ErrorText" Text="Could not load tokens."
                           Foreground="#9D9D9D" FontSize="13" HorizontalAlignment="Center"
                           FontFamily="Segoe UI Variable Text" Margin="0,8,0,0"/>
                <ui:Button Content="Try Again" Click="OnRefreshClicked"
                        Style="{StaticResource CopyBtnStyle}"
                        Margin="0,16,0,0" HorizontalAlignment="Center" Padding="20,7"/>
            </StackPanel>

            <!-- Token scroll list -->
            <ScrollViewer x:Name="TokenScrollViewer" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" Background="Transparent" Padding="24,8,24,24"
                          PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                <StackPanel x:Name="TokenPanel"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
