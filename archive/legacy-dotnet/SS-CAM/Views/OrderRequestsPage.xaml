<Page x:Class="SS_CAM.Views.OrderRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1280"
      Title="Order Requests"
      Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <ContextMenu x:Key="OrderCardContextMenu">
            <MenuItem Header="Accept Brief (In Progress)" Click="OnContextMenuAcceptClicked">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Play24" FontSize="14"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Convert into Official Project" Click="OnContextMenuConvertClicked">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="FolderAdd24" FontSize="14"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Copy Script &amp; Angle Brief" Click="OnContextMenuCopyScriptClicked">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Copy24" FontSize="14"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Reject / Cancel Order Request" Click="OnContextMenuRejectClicked">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Page.Resources>

    <Grid>
        <ScrollViewer x:Name="PageScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24"
                      PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
            <StackPanel HorizontalAlignment="Stretch">

                <!-- ── 1. PAGE HEADER ──────────────────────────────────────────────── -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <ui:TextBlock Text="CREATIVE ORDERS &amp; BRIEF PIPELINE" FontSize="11" FontWeight="Bold"
                                      Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ClipboardTask24" FontSize="24" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,10,0"/>
                            <ui:TextBlock Text="Order Requests" FontSize="24" FontWeight="Bold"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <ui:TextBlock Text="Review incoming creative orders from Web Portal &amp; Companion App, inspect copy scripts, and convert requests into official projects with automated NAS scaffolding."
                                      FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Top Action Bar -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="BtnRefreshQueue" Appearance="Secondary" Margin="0,0,8,0"
                                   Click="OnRefreshQueueClicked" Cursor="Hand" ToolTip="Reload orders ledger from NAS">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" FontSize="14"/>
                                <ui:TextBlock Text="Refresh Queue"/>
                            </StackPanel>
                        </ui:Button>

                        <ui:Button x:Name="BtnOpenWebPortal" Appearance="Secondary" Margin="0,0,8,0"
                                   Click="OnOpenWebPortalClicked" Cursor="Hand" ToolTip="Open Creative Web Portal in browser">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Globe24" Margin="0,0,6,0" FontSize="14"/>
                                <ui:TextBlock Text="Web Portal"/>
                            </StackPanel>
                        </ui:Button>

                        <ui:Button x:Name="BtnNewOrder" Appearance="Secondary"
                                   Click="OnNewOrderClicked" Cursor="Hand" ToolTip="Open Project Creator">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Folder24" Margin="0,0,6,0" FontSize="14"/>
                                <ui:TextBlock Text="Project Creator"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- ── 2. METRIC TELEMETRY CARDS ───────────────────────────────────── -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Orders -->
                    <ui:Card Grid.Column="0" Padding="14,12">
                        <StackPanel>
                            <ui:TextBlock Text="Total Requests" FontSize="11" FontWeight="SemiBold"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBlock x:Name="TxtMetricTotal" Text="0" FontSize="22" FontWeight="Bold"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                            <ui:TextBlock Text="In shared NAS ledger" FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Pending Review -->
                    <ui:Card Grid.Column="2" Padding="14,12">
                        <StackPanel>
                            <ui:TextBlock Text="Pending Review" FontSize="11" FontWeight="SemiBold"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBlock x:Name="TxtMetricPending" Text="0" FontSize="22" FontWeight="Bold"
                                          Foreground="#F59E0B" Margin="0,2,0,0"/>
                            <ui:TextBlock Text="Awaiting project conversion" FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- In Progress -->
                    <ui:Card Grid.Column="4" Padding="14,12">
                        <StackPanel>
                            <ui:TextBlock Text="In Progress" FontSize="11" FontWeight="SemiBold"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBlock x:Name="TxtMetricInProgress" Text="0" FontSize="22" FontWeight="Bold"
                                          Foreground="#3B82F6" Margin="0,2,0,0"/>
                            <ui:TextBlock Text="Active in design pipeline" FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Converted to Projects -->
                    <ui:Card Grid.Column="6" Padding="14,12">
                        <StackPanel>
                            <ui:TextBlock Text="Scaffolded Projects" FontSize="11" FontWeight="SemiBold"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ui:TextBlock x:Name="TxtMetricConverted" Text="0" FontSize="22" FontWeight="Bold"
                                          Foreground="#10B981" Margin="0,2,0,0"/>
                            <ui:TextBlock Text="With COPY.md on NAS" FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </ui:Card>
                </Grid>

                <!-- ── 3. MAIN DUAL-PANE WORKSPACE ─────────────────────────────────── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" MinWidth="340"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── LEFT PANE: QUEUE & FILTERS ── -->
                    <StackPanel Grid.Column="0">
                        <ui:Card Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Search Input -->
                                <ui:TextBox x:Name="TxtSearchQuery" PlaceholderText="Search brief title, requester, ID..."
                                            TextChanged="OnSearchTextChanged" Margin="0,0,0,10"/>

                                <!-- Status Filter Segmented Chips -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="RadioFilterAll" Content="All" IsChecked="True"
                                                 Checked="OnFilterStatusChanged" Margin="0,0,8,0" FontSize="11"/>
                                    <RadioButton x:Name="RadioFilterPending" Content="Pending"
                                                 Checked="OnFilterStatusChanged" Margin="0,0,8,0" FontSize="11"/>
                                    <RadioButton x:Name="RadioFilterInProgress" Content="Active"
                                                 Checked="OnFilterStatusChanged" Margin="0,0,8,0" FontSize="11"/>
                                    <RadioButton x:Name="RadioFilterDone" Content="Done"
                                                 Checked="OnFilterStatusChanged" FontSize="11"/>
                                </StackPanel>

                                <!-- Entity Filter Dropdown -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Text="Entity:" VerticalAlignment="Center" FontSize="11.5"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CmbEntityFilter" Grid.Column="1" SelectionChanged="OnEntityFilterChanged"
                                              FontSize="11.5" Height="30">
                                        <ComboBoxItem Content="All Entities (SSH, SSC, SSE, SSW, SST)" IsSelected="True"/>
                                        <ComboBoxItem Content="SSC - Healthcare / Clinic"/>
                                        <ComboBoxItem Content="SSH - SuamiSihat Holding"/>
                                        <ComboBoxItem Content="SSE - E-Commerce"/>
                                        <ComboBoxItem Content="SSW - Wellness"/>
                                        <ComboBoxItem Content="SST - Technology"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Order List Cards -->
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="6" MinHeight="500">
                            <Grid>
                                <ListBox x:Name="ListOrdersQueue" BorderThickness="0" Background="Transparent"
                                         SelectionChanged="OnOrderSelectedChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,6"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnListBoxItemPreviewMouseRightButtonDown"/>
                                            <Setter Property="ContextMenu" Value="{StaticResource OrderCardContextMenu}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="ItemBorder"
                                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource FluentBrand80}"/>
                                                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/>
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource FluentBrand80}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <!-- Row 1: Badges -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Entity Pill -->
                                                    <Border Grid.Column="0" Background="{Binding EntityBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <ui:TextBlock Text="{Binding SafeEntity}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                    </Border>

                                                    <!-- Priority Pill -->
                                                    <Border Grid.Column="1" Background="{Binding PriorityBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <ui:TextBlock Text="{Binding PriorityBadge}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                    </Border>

                                                    <!-- Format Label -->
                                                    <ui:TextBlock Grid.Column="2" Text="{Binding FormatLabel}" FontSize="11"
                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                                                  TextTrimming="CharacterEllipsis"/>

                                                    <!-- Status Badge -->
                                                    <Border Grid.Column="3" BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <ui:TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" FontSize="9.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Row 2: Title -->
                                                <ui:TextBlock Text="{Binding SafeTitle}" FontSize="13" FontWeight="SemiBold"
                                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                                <!-- Row 3: Copy snippet -->
                                                <ui:TextBlock Text="{Binding CopySnippet}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                              TextWrapping="Wrap" Margin="0,0,0,6" MaxHeight="32" TextTrimming="CharacterEllipsis"/>

                                                <!-- Row 4: Requester & Target Date -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Person24" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,0"/>
                                                        <ui:TextBlock Text="{Binding Requester}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Calendar24" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,0"/>
                                                        <ui:TextBlock Text="{Binding FormattedTargetDate}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Converted Banner if already created -->
                                                <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,6,0,0"
                                                        Visibility="{Binding ConvertedBannerVisibility}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="12" Foreground="#059669" Margin="0,0,4,0"/>
                                                        <ui:TextBlock Text="Project Scaffolded" FontSize="10.5" FontWeight="SemiBold" Foreground="#059669"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Empty Queue Notification -->
                                <StackPanel x:Name="PanelEmptyQueue" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="Collapsed" Margin="24">
                                    <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <ui:TextBlock Text="No Matching Requests" FontSize="14" FontWeight="SemiBold"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <ui:TextBlock Text="Try resetting your search query or status filter." FontSize="11.5"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ── RIGHT PANE: BRIEF INSPECTOR & PROJECT CONVERSION ── -->
                    <StackPanel Grid.Column="2">

                        <!-- Empty Selection Placeholder -->
                        <ui:Card x:Name="CardNoSelection" Padding="32" MinHeight="500" Visibility="Visible">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="ClipboardTask24" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                <ui:TextBlock Text="Select a Creative Request" FontSize="18" FontWeight="SemiBold"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                <ui:TextBlock Text="Click any order card on the left queue to inspect the full copywriting script, production parameters, and convert it directly into an official project."
                                              FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                              TextAlignment="Center" MaxWidth="440" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </ui:Card>

                        <!-- Selected Order Detailed Inspector -->
                        <StackPanel x:Name="PanelOrderDetails" Visibility="Collapsed">

                            <!-- Header Summary Card -->
                            <ui:Card Padding="18" Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Meta Row -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="BadgeDetailEntity" Grid.Column="0" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                            <ui:TextBlock x:Name="TxtDetailEntity" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>

                                        <Border x:Name="BadgeDetailPriority" Grid.Column="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                            <ui:TextBlock x:Name="TxtDetailPriority" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>

                                        <Border x:Name="BadgeDetailStatus" Grid.Column="2" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                            <ui:TextBlock x:Name="TxtDetailStatus" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>

                                        <ui:TextBlock x:Name="TxtDetailOrderId" Grid.Column="3" Text="ORD-XXXXXX-XXXX"
                                                      FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>

                                        <ui:TextBlock x:Name="TxtDetailSubmittedAt" Grid.Column="4" Text="Submitted on dd MMM yyyy"
                                                      FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Large Title -->
                                    <ui:TextBlock x:Name="TxtDetailTitle" Text="Creative Project Title"
                                                  FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                  TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <!-- Submitter Metadata Strip -->
                                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Requester -->
                                            <StackPanel Grid.Column="0">
                                                <ui:TextBlock Text="Requester" FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <ui:TextBlock x:Name="TxtDetailRequester" Text="Staff Name" FontSize="12" FontWeight="SemiBold"
                                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,1,0,0"/>
                                                <ui:TextBlock x:Name="TxtDetailRequesterRole" Text="Role / Department" FontSize="10.5"
                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>

                                            <!-- Target Deadline -->
                                            <StackPanel Grid.Column="1">
                                                <ui:TextBlock Text="Target Deadline" FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <ui:TextBlock x:Name="TxtDetailTargetDate" Text="2026-09-18" FontSize="12" FontWeight="SemiBold"
                                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,1,0,0"/>
                                                <ui:TextBlock x:Name="TxtDetailDeadlineStatus" Text="On Track" FontSize="10.5"
                                                              Foreground="#10B981"/>
                                            </StackPanel>

                                            <!-- Format / Deliverable -->
                                            <StackPanel Grid.Column="2">
                                                <ui:TextBlock Text="Format &amp; Canvas" FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <ui:TextBlock x:Name="TxtDetailFormat" Text="1:1 Feed Post" FontSize="12" FontWeight="SemiBold"
                                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,1,0,0"/>
                                                <ui:TextBlock x:Name="TxtDetailFormatSpecs" Text="1080 x 1080 px | 72 DPI" FontSize="10.5"
                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ui:Card>

                            <!-- Copywriting & Script Studio Section -->
                            <ui:Card Padding="18" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="16" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,8,0"/>
                                            <ui:TextBlock Text="Copywriting Script &amp; Angle Brief" FontSize="14" FontWeight="Bold"
                                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <ui:TextBlock x:Name="TxtCopyCharCount" Text="(0 characters)" FontSize="11"
                                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ui:Button Appearance="Secondary" Height="28" Padding="10,0" Click="OnCopyScriptClicked"
                                                       Cursor="Hand" ToolTip="Copy script text to clipboard">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Copy24" FontSize="12" Margin="0,0,4,0"/>
                                                    <ui:TextBlock Text="Copy Text" FontSize="11"/>
                                                </StackPanel>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Script Box -->
                                    <TextBox x:Name="TxtDetailCopy"
                                             Height="160"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="Consolas, Cascadia Code, Segoe UI"
                                             FontSize="12"
                                             Padding="10"
                                             Background="{DynamicResource TextControlBackground}"
                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                             BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                             BorderThickness="1"/>
                                </StackPanel>
                            </ui:Card>

                            <!-- Production Notes Card (Collapsible if empty) -->
                            <ui:Card x:Name="CardProductionNotes" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0"/>
                                        <ui:TextBlock Text="Requester &amp; Production Notes" FontSize="12" FontWeight="SemiBold"
                                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                    <ui:TextBlock x:Name="TxtDetailAttachmentNote" Text="No additional notes."
                                                  FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ui:Card>

                            <!-- ── ACTION: PROJECT CONVERSION & NAS PROVISIONING ── -->
                            <ui:Card Padding="18">
                                <StackPanel>
                                    <!-- Header Block -->
                                    <StackPanel Margin="0,0,0,12">
                                        <ui:TextBlock Text="PROJECT SCAFFOLDING &amp; NAS PROVISIONING" FontSize="10.5" FontWeight="Bold"
                                                      Foreground="{DynamicResource FluentBrand80}"/>
                                        <ui:TextBlock Text="Convert into Official Project" FontSize="16" FontWeight="Bold"
                                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,10"/>

                                        <!-- Dedicated Assigned Designer Row with full width (never cropped or overlapped) -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <ui:SymbolIcon Symbol="Person24" FontSize="14" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0"/>
                                                <ui:TextBlock Text="Assigned Designer:" FontSize="12" FontWeight="SemiBold"
                                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ComboBox x:Name="CmbAssignee" Grid.Column="1" Height="34" FontSize="12"
                                                      HorizontalAlignment="Stretch" MinWidth="220"
                                                      SelectionChanged="OnAssigneeSelectionChanged"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Unconverted State: Scaffolding Preview -->
                                    <StackPanel x:Name="PanelUnconvertedActions">
                                        <!-- Path Preview Box -->
                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                            <StackPanel>
                                                <ui:TextBlock Text="Target Canonical Project Folder on NAS:" FontSize="11" FontWeight="SemiBold"
                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ui:TextBlock x:Name="TxtTargetFolderPreview" Text="SSNAS\Creative-Team\2026\202609_September\202609_0015D_SSC_Project_Title"
                                                              FontSize="12" FontWeight="Bold" FontFamily="Consolas, Segoe UI"
                                                              Foreground="{DynamicResource FluentBrand80}" TextWrapping="Wrap"/>

                                                <!-- Preset Scaffolding List -->
                                                <ui:TextBlock Text="Will scaffold: 01_Brief_and_Copy (with COPY.md) | 02_Source_Assets | 03_Artwork_Design | 04_Final_Exports | README.md"
                                                              FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Action Buttons Row (Convert, Accept, Reject/Cancel) -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ui:Button x:Name="BtnConvertProject" Grid.Column="0" Appearance="Primary" Height="42"
                                                       Click="OnConvertOrderClicked" Cursor="Hand" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="FolderAdd24" FontSize="16" Margin="0,0,8,0"/>
                                                    <ui:TextBlock Text="Convert into Project" FontSize="13.5" FontWeight="Bold"/>
                                                </StackPanel>
                                            </ui:Button>

                                            <!-- Mark In-Progress without scaffolding -->
                                            <ui:Button x:Name="BtnMarkInProgress" Grid.Column="1" Appearance="Secondary" Height="42"
                                                       Click="OnMarkInProgressClicked" Cursor="Hand" ToolTip="Mark order status as in-progress"
                                                       Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Play24" FontSize="14" Margin="0,0,6,0"/>
                                                    <ui:TextBlock Text="Accept Brief"/>
                                                </StackPanel>
                                            </ui:Button>

                                            <!-- Reject or Cancel Order -->
                                            <ui:Button x:Name="BtnRejectOrder" Grid.Column="2" Appearance="Danger" Height="42"
                                                       Click="OnRejectOrderClicked" Cursor="Hand" ToolTip="Reject or cancel this creative order request">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Margin="0,0,6,0"/>
                                                    <ui:TextBlock Text="Reject / Cancel"/>
                                                </StackPanel>
                                            </ui:Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Already Converted State: Open in Explorer -->
                                    <StackPanel x:Name="PanelConvertedActions" Visibility="Collapsed">
                                        <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="24" Foreground="#059669" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <ui:TextBlock Text="Project Successfully Provisioned on NAS" FontSize="13" FontWeight="Bold" Foreground="#065F46"/>
                                                    <ui:TextBlock x:Name="TxtExistingProjectPath" Text="Folder Path" FontSize="11.5" FontFamily="Consolas, Segoe UI"
                                                                  Foreground="#047857" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ui:Button Grid.Column="0" Appearance="Primary" Height="38" Click="OnOpenExistingProjectClicked" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,6,0"/>
                                                    <ui:TextBlock Text="Open in Windows Explorer"/>
                                                </StackPanel>
                                            </ui:Button>

                                            <ui:Button Grid.Column="2" Appearance="Secondary" Height="38" Click="OnMarkCompletedClicked" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Margin="0,0,6,0"/>
                                                    <ui:TextBlock Text="Mark Order Completed"/>
                                                </StackPanel>
                                            </ui:Button>

                                            <ui:Button Grid.Column="4" Appearance="Danger" Height="38" Click="OnRejectOrderClicked" Cursor="Hand" ToolTip="Cancel this creative order">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Margin="0,0,6,0"/>
                                                    <ui:TextBlock Text="Cancel Order"/>
                                                </StackPanel>
                                            </ui:Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Status Message Bar -->
                                    <ui:TextBlock x:Name="TxtActionStatusMessage" FontSize="11.5" Foreground="{DynamicResource FluentBrand80}"
                                                  Margin="0,8,0,0" HorizontalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
