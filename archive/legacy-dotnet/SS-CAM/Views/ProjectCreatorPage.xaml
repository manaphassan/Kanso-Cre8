<Page x:Class="SS_CAM.Views.ProjectCreatorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Project Creator">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" Padding="24" Background="Transparent" PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
            <StackPanel>
                <!-- Fluent 2 Header -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="24" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ui:TextBlock Text="Standardized Project Creator" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ui:TextBlock Text="Generate standardized Post Haste folder structures, canvas presets, creative briefs, and project metadata." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ui:Button Grid.Column="1" Appearance="Secondary" Click="OnManagePresetsClicked" Width="36" Height="36" Padding="0" Cursor="Hand" ToolTip="Manage Category Presets &amp; Folder Trees" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" VerticalAlignment="Center"/>
                    </ui:Button>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Form Controls -->
                    <StackPanel Grid.Column="0">
                        <!-- Project Identity Group (Fluent 2 Card) -->
                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <ui:TextBlock Text="&#xE8A5; " FontFamily="Segoe Fluent Icons" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0"/>
                                    <ui:TextBlock Text="01. Project Identity &amp; Project ID" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Year -->
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock Text="Year" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="YearComboBox" Height="36" SelectionChanged="OnFormInputChanged"/>
                                    </StackPanel>
                                    <!-- Sub-brand -->
                                    <StackPanel Grid.Column="2">
                                        <ui:TextBlock Text="Sub-Brand" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="SubBrandComboBox" Height="36" SelectionChanged="OnFormInputChanged"/>
                                    </StackPanel>
                                    <!-- Project ID Suffix Code -->
                                    <StackPanel Grid.Column="4">
                                        <ui:TextBlock Text="Project ID Suffix" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                        <ui:TextBox x:Name="ProjectIdInput" Text="0001D" Height="36" TextChanged="OnFormInputChanged"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Linked Creative Request from NAS _Orders -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <ui:TextBlock Text="Link Creative Order (Optional from NAS _Orders)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <ui:TextBlock x:Name="OrderAttachmentsBadge" Text="" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FluentBrand80}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="LinkedOrderComboBox" Height="36" SelectionChanged="OnLinkedOrderSelectionChanged" DisplayMemberPath="DisplayText"/>
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" Appearance="Secondary" Content="Sync" Click="OnRefreshOrdersClicked" Height="36" Padding="12,0" VerticalAlignment="Bottom" ToolTip="Reload orders from NAS _Orders"/>
                                </Grid>

                                <StackPanel Margin="0,0,0,14">
                                    <ui:TextBlock Text="Project Title / Descriptor" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                    <ui:TextBox x:Name="ProjectNameInput" Text="brand campaign" Height="36" TextChanged="OnFormInputChanged"/>
                                </StackPanel>

                                <StackPanel>
                                    <ui:TextBlock Text="Project Brief / Remarks" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>

                                    <!-- Unified Integrated Markdown Editor Container -->
                                    <Border Background="{DynamicResource TextControlBackground}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                        <DockPanel LastChildFill="True">
                                            <!-- Toolbar Header -->
                                            <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:Button x:Name="MdBold" Content="B" Click="OnMdBold" Height="24" Padding="8,0" Background="Transparent" Foreground="{DynamicResource FluentBrand80}" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" ToolTip="Bold (**text**)"/>
                                                    <ui:Button x:Name="MdItalic" Content="I" Click="OnMdItalic" Height="24" Padding="8,0" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Georgia, serif" FontStyle="Italic" FontSize="12" BorderThickness="0" Cursor="Hand" ToolTip="Italic (*text*)"/>
                                                    <ui:Button x:Name="MdCode" Click="OnMdCode" Height="24" Padding="8,0" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Consolas" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="Inline code (`text`)">
                                                        <ui:TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                                    </ui:Button>
                                                    <Border Width="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="4,3"/>
                                                    <ui:Button x:Name="MdHeading" Content="H2" Click="OnMdHeading" Height="24" Padding="8,0" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="10" BorderThickness="0" Cursor="Hand" ToolTip="Heading 2 (## heading)"/>
                                                    <ui:Button x:Name="MdList" Content="* List" Click="OnMdList" Height="24" Padding="8,0" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="10" BorderThickness="0" Cursor="Hand" ToolTip="List item (- item)"/>
                                                    <ui:Button x:Name="MdSep" Content="- HR" Click="OnMdSep" Height="24" Padding="8,0" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="10" BorderThickness="0" Cursor="Hand" ToolTip="Horizontal rule (---)"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Text Box -->
                                            <ui:TextBox x:Name="ProjectDescriptionInput"
                                                        AcceptsReturn="True" AcceptsTab="True"
                                                        Height="170"
                                                        VerticalScrollBarVisibility="Auto"
                                                        TextWrapping="Wrap"
                                                        FontSize="12"
                                                        Padding="8"
                                                        BorderThickness="0"
                                                        Background="Transparent"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- Template & Platform Configuration -->
                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <ui:TextBlock Text="&#xE710; " FontFamily="Segoe Fluent Icons" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0"/>
                                    <ui:TextBlock Text="02. Preset &amp; Starter Canvas Template" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Category Preset -->
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock Text="Category Preset" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="PresetComboBox" Height="36" SelectionChanged="OnFormInputChanged"/>
                                    </StackPanel>

                                    <!-- Canvas Size Preset -->
                                    <StackPanel Grid.Column="2">
                                        <ui:TextBlock Text="Target Platform" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="PlatformComboBox" Height="36" SelectionChanged="OnFormInputChanged"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Dynamic SLA Target & Turnaround Indicator -->
                                <Border x:Name="SlaBadgeBorder" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ui:TextBlock x:Name="SlaTargetText" Text="SLA Target: 3 Days" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <ui:TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ui:TextBlock x:Name="SlaDeadlineText" Text="Target Due Date: 2026-08-31" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Visual Platform Cards Row -->
                                <ui:TextBlock Text="Select Target Platform Preset" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,8"/>
                                <UniformGrid Columns="4" Margin="0,0,0,14">
                                    <ui:CardAction x:Name="CardPlatformWordPress" Padding="8,10" Margin="2" Click="OnVisualPlatformCardClicked" Tag="WordPress">
                                        <StackPanel HorizontalAlignment="Center">
                                            <ui:TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <ui:TextBlock Text="WordPress" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <ui:TextBlock Text="1920x1080 RGB" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </ui:CardAction>
                                    <ui:CardAction x:Name="CardPlatform1x1" Padding="8,10" Margin="2" Click="OnVisualPlatformCardClicked" Tag="1:1">
                                        <StackPanel HorizontalAlignment="Center">
                                            <ui:TextBlock Text="&#xE8EA;" FontFamily="Segoe Fluent Icons" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <ui:TextBlock Text="1:1 Post" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <ui:TextBlock Text="1080x1080 px" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </ui:CardAction>
                                    <ui:CardAction x:Name="CardPlatform9x16" Padding="8,10" Margin="2" Click="OnVisualPlatformCardClicked" Tag="9:16">
                                        <StackPanel HorizontalAlignment="Center">
                                            <ui:TextBlock Text="&#xE8EA;" FontFamily="Segoe Fluent Icons" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <ui:TextBlock Text="9:16 Story" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <ui:TextBlock Text="1080x1920 px" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </ui:CardAction>
                                    <ui:CardAction x:Name="CardPlatform16x9" Padding="8,10" Margin="2" Click="OnVisualPlatformCardClicked" Tag="16:9">
                                        <StackPanel HorizontalAlignment="Center">
                                            <ui:TextBlock Text="&#xE8B2;" FontFamily="Segoe Fluent Icons" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <ui:TextBlock Text="16:9 Banner" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <ui:TextBlock Text="1920x1080 px" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </ui:CardAction>
                                    <ui:CardAction x:Name="CardPlatformPrint" Padding="8,10" Margin="2" Click="OnVisualPlatformCardClicked" Tag="Print Poster A4">
                                        <StackPanel HorizontalAlignment="Center">
                                            <ui:TextBlock Text="&#xE749;" FontFamily="Segoe Fluent Icons" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <ui:TextBlock Text="Print Poster" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <ui:TextBlock Text="A4 / 300 DPI" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </ui:CardAction>
                                    <ui:CardAction x:Name="CardPlatformTrifold" Padding="8,10" Margin="2" Click="OnVisualPlatformCardClicked" Tag="Trifold">
                                        <StackPanel HorizontalAlignment="Center">
                                            <ui:TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <ui:TextBlock Text="Trifold A4" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <ui:TextBlock Text="3-Panel Brochure" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </ui:CardAction>
                                    <ui:CardAction x:Name="CardPlatformA5Leaflet" Padding="8,10" Margin="2" Click="OnVisualPlatformCardClicked" Tag="A5 Leaflet">
                                        <StackPanel HorizontalAlignment="Center">
                                            <ui:TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <ui:TextBlock Text="A5 Leaflet" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <ui:TextBlock Text="148x210mm 300DPI" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </ui:CardAction>
                                    <ui:CardAction x:Name="CardPlatformRollup" Padding="8,10" Margin="2" Click="OnVisualPlatformCardClicked" Tag="Rollup">
                                        <StackPanel HorizontalAlignment="Center">
                                            <ui:TextBlock Text="&#xE914;" FontFamily="Segoe Fluent Icons" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <ui:TextBlock Text="Rollup 80x200" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <ui:TextBlock Text="80x200cm 150DPI" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </ui:CardAction>
                                </UniformGrid>

                                <ui:TextBlock x:Name="PlatformSpecsText" Text="1080 x 1080 px &#x00B7; 72 DPI &#x00B7; sRGB Color Mode" FontSize="11" Foreground="{DynamicResource FluentBrand80}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="InjectCanvasCheck" Content="Generate Starter Canvas File" IsChecked="True" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Click="OnFormInputChanged"/>
                                    <ComboBox x:Name="TemplateExtensionComboBox" Grid.Column="2" Width="140" Height="34" IsEditable="True" SelectionChanged="OnFormInputChanged" TextBoxBase.TextChanged="OnFormInputChanged"/>
                                </Grid>

                                <!-- Canva Cloud Bridge Section -->
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#00C4CC" CornerRadius="4" Padding="5,2" Margin="0,0,8,0">
                                                    <ui:TextBlock Text="CANVA" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <ui:TextBlock Text="Canva Creative Cloud Bridge" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ui:Button Grid.Column="1" Appearance="Secondary" Content="Create on Canva (Auto-size)" Click="OnLaunchCanvaWithDimensionsClicked" Height="26" Padding="10,0" FontSize="11" FontWeight="SemiBold" Cursor="Hand" ToolTip="Open Canva in browser with exact platform dimensions"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="CanvaUrlInput" Grid.Column="0" Height="32" FontSize="11" PlaceholderText="Paste Canva Design URL (e.g. https://www.canva.com/design/...)" TextChanged="OnFormInputChanged"/>
                                            <ui:Button Grid.Column="2" Appearance="Secondary" Content="Test Link" Click="OnTestCanvaLinkClicked" Height="32" Padding="12,0" FontSize="11" Cursor="Hand" ToolTip="Test open Canva URL"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox x:Name="IncludeRevisionsCheck" Content="Include Client Revisions folder" IsChecked="True" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,16,0" Click="OnFormInputChanged"/>
                                    <CheckBox x:Name="IncludeRawMediaCheck" Content="Include Raw Media folder" IsChecked="True" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Click="OnFormInputChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- Output Destination -->
                        <ui:Card Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <ui:TextBlock Text="&#xE8B7; " FontFamily="Segoe Fluent Icons" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0"/>
                                    <ui:TextBlock Text="03. Output Directory" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>

                                <ui:TextBlock Text="Target Root Workspace Folder" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TargetDirectoryInput" Height="36" Grid.Column="0" TextChanged="OnFormInputChanged"/>
                                    <ui:Button Grid.Column="2" Appearance="Secondary" Content="Browse..." Click="OnBrowseTargetDirectory" Height="34" Width="100" FontWeight="SemiBold" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Status Indicator Text -->
                        <ui:TextBlock x:Name="CreateStatusText" Text="" FontSize="12" Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontWeight="Bold" Margin="0,0,0,10"/>

                        <!-- Primary Action Button -->
                        <ui:Button Appearance="Primary" Content="Generate Standardized Project Folder" Click="OnCreateProjectClicked" Height="44" FontSize="14" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Right Column: Live Directory Tree Preview (Fluent 2 Card) -->
                    <ui:Card Grid.Column="2" VerticalAlignment="Top" Padding="16" Effect="{DynamicResource FluentDepth4}">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:TextBlock Text="&#xE8B7; " FontFamily="Segoe Fluent Icons" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ui:TextBlock Text="Live Directory Tree Preview" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                                <ui:TextBlock Text="Real-time visual hierarchy of the project folder structure." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                            </StackPanel>

                            <!-- Folder Name Header Card -->
                            <ui:Card DockPanel.Dock="Top" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <ui:TextBlock Text="GENERATED TARGET FOLDER PATH:" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <ui:TextBlock x:Name="PreviewPathText" Text="" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <ui:Button Appearance="Secondary" Content="Copy Path" Click="OnCopyFolderPathClicked" Padding="10,4" FontSize="11" Margin="0,0,8,0" Cursor="Hand"/>
                                        <ui:Button Appearance="Secondary" Content="Copy Name" Click="OnCopyFolderNameClicked" Padding="10,4" FontSize="11" Cursor="Hand"/>
                                    </StackPanel>

                                    <!-- Folder Status Alert Badge -->
                                    <Border x:Name="FolderStatusBadge" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{DynamicResource SystemFillColorCautionBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,8,0,0" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock x:Name="FolderStatusBadgeIcon" Text="&#xE7BA; " FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                            <ui:TextBlock x:Name="FolderStatusBadgeText" Text="Target directory already exists" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ui:Card>

                            <!-- Tree Hierarchy View -->
                            <ui:Card DockPanel.Dock="Top" Padding="12" Margin="0,0,0,16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                                    <ui:TextBlock x:Name="FolderStructureBox" Text="2026_SS_BRAND_0001D_brand_campaign&#10;+-- 01_Product_Shots&#10;+-- 02_Raw_Footage&#10;+-- 03_Final_Exports" FontFamily="Consolas, Segoe UI Mono, monospace" FontSize="11.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" LineHeight="20"/>
                                </ScrollViewer>
                            </ui:Card>

                            <!-- Recent Projects List Section (Rich Card List with Date & Status) -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="History24" FontSize="14" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Recent Projects" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ui:TextBlock Grid.Column="1" Text="Double-click to open in Explorer" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                </Grid>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="220"
                                              PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                                    <ItemsControl x:Name="RecentProjectsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:CardAction Margin="0,0,0,6" Padding="10,8" Cursor="Hand"
                                                               MouseDoubleClick="OnRecentProjectCardDoubleClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Folder Icon Container -->
                                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6"
                                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                                Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Folder24" FontSize="14" Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Project Title & Subtitle Info (Date & Designer) -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <ui:TextBlock Text="{Binding Project}" FontSize="12" FontWeight="SemiBold"
                                                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,6,2"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="CalendarMonth24" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <ui:TextBlock Text="{Binding CreatedDateDisplay}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <ui:TextBlock Text="&#x2022;" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <ui:TextBlock Text="{Binding Designer}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Status Badge -->
                                                        <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                                Background="{DynamicResource TextControlBackground}"
                                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Width="6" Height="6" CornerRadius="3" Background="{Binding StatusBadgeColor}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                <ui:TextBlock Text="{Binding StatusDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusBadgeColor}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </ui:CardAction>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </DockPanel>
                    </ui:Card>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Manage Presets Modal Overlay -->
        <Grid x:Name="ManagePresetsModal" Background="#90000000" Visibility="Collapsed">
            <ui:Card Padding="24" Width="680" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{DynamicResource FluentDepth16}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock Text="&#xE713; " FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ui:TextBlock Text="Category Presets &amp; Folder Templates" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Appearance="Transparent" Content="X" Click="OnClosePresetsModalClicked" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Presets List -->
                        <DockPanel Grid.Column="0">
                            <ui:Button DockPanel.Dock="Bottom" Appearance="Primary" Content="+ New Category Preset" Click="OnAddNewPresetClicked" Height="34" FontSize="11" FontWeight="Bold" Cursor="Hand" HorizontalAlignment="Stretch"/>
                            <ListBox x:Name="PresetsListBox" SelectionChanged="OnPresetSelectionChanged" DisplayMemberPath="Name" Margin="0,0,0,10"/>
                        </DockPanel>

                        <!-- Right: Edit Preset Form -->
                        <StackPanel Grid.Column="2">
                            <ui:TextBlock x:Name="PresetFormTitle" Text="Edit Category Preset" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12"/>
                            
                            <ui:TextBlock Text="Category Name" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="TxtPresetName" Height="34" Margin="0,0,0,10"/>

                            <ui:TextBlock Text="Project ID Suffix Code" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="TxtPresetSuffix" Height="34" Margin="0,0,0,10"/>

                            <ui:TextBlock Text="Folder Tree Structure (1 subfolder per line, use '/' for nested subfolders)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="TxtPresetFolders" AcceptsReturn="True" Height="140" Margin="0,0,0,14"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button x:Name="BtnDeletePreset" Appearance="Danger" Content="Delete" Click="OnDeletePresetClicked" Height="34" Padding="12,0" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="0,0,8,0"/>
                                <ui:Button Appearance="Primary" Content="Save Preset" Click="OnSavePresetClicked" Height="34" Padding="16,0" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</Page>


