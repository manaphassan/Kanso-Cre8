<Page x:Class="SS_CAM.Views.QrCodePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="QR Code Studio">

    <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" Padding="24" Background="Transparent" PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
        <StackPanel>
            
            <!-- Standard App Page Header (Consistent with BrandAssets & Radio pages) -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:SymbolIcon Symbol="QrCode24" FontSize="24" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ui:TextBlock Text="QR Code Studio &amp; Generator" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ui:TextBlock Text="Create high-resolution vector and raster QR codes for print collaterals, digital campaigns, and client links."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Header Actions: Reset Options Only -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Secondary" Click="OnResetDefaultsClicked" Padding="12,6" Cursor="Hand" ToolTip="Reset all customizations">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="Reset Options" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- Main 2-Column Grid (Left: Controls, Right: Sticky Live Preview) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>      <!-- Left Customization Controls -->
                    <ColumnDefinition Width="380"/>    <!-- Right Live Preview Card -->
                </Grid.ColumnDefinitions>

                <!-- Left Column: Inputs & Customization Cards -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">

                    <!-- Card 1: Content Type Selection & Input Fields -->
                    <ui:Card Margin="0,0,0,12" Padding="16">
                        <StackPanel>
                            <ui:TextBlock Text="1. ENTER QR CONTENT" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,12"/>
                            
                            <!-- Content Type Filter Tabs -->
                            <WrapPanel x:Name="ContentTypePanel" Margin="0,0,0,14">
                                <ui:Button x:Name="BtnTabUrl" Tag="URL" Click="OnContentTypeClicked" Appearance="Primary" Padding="12,6" Margin="0,0,6,6" FontSize="11" FontWeight="Bold">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="&#xE71B;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="URL Link" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="BtnTabText" Tag="TEXT" Click="OnContentTypeClicked" Appearance="Secondary" Padding="12,6" Margin="0,0,6,6" FontSize="11">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Free Text" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="BtnTabWifi" Tag="WIFI" Click="OnContentTypeClicked" Appearance="Secondary" Padding="12,6" Margin="0,0,6,6" FontSize="11">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="&#xE701;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Wi-Fi Network" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="BtnTabVCard" Tag="VCARD" Click="OnContentTypeClicked" Appearance="Secondary" Padding="12,6" Margin="0,0,6,6" FontSize="11">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="VCard Contact" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="BtnTabWhatsApp" Tag="WHATSAPP" Click="OnContentTypeClicked" Appearance="Secondary" Padding="12,6" Margin="0,0,6,6" FontSize="11">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="&#xE8BD;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="WhatsApp" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="BtnTabEmail" Tag="EMAIL" Click="OnContentTypeClicked" Appearance="Secondary" Padding="12,6" Margin="0,0,6,6" FontSize="11">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="&#xE715;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Email" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                            </WrapPanel>

                            <!-- Dynamic Input Container -->
                            <StackPanel x:Name="PanelUrlInput">
                                <ui:TextBlock Text="Website or Destination URL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtUrl" Text="https://suamisihat.com.my" Padding="10,8" FontSize="12" TextChanged="OnInputTextChanged"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelTextInput" Visibility="Collapsed">
                                <ui:TextBlock Text="Enter Text or Serial Code" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtFreeText" Text="SuamiSihat Creative Assets Management" TextWrapping="Wrap" AcceptsReturn="True" Height="70" Padding="10,8" FontSize="12" TextChanged="OnInputTextChanged"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelWifiInput" Visibility="Collapsed">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <ui:TextBlock Text="Wi-Fi SSID / Network Name" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtWifiSsid" Text="SuamiSihat_Office" Padding="10,8" FontSize="12" TextChanged="OnInputTextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <ui:TextBlock Text="Encryption" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CmbWifiEnc" SelectedIndex="0" Padding="8,6" SelectionChanged="OnOptionChanged">
                                            <ComboBoxItem Content="WPA / WPA2"/>
                                            <ComboBoxItem Content="WEP"/>
                                            <ComboBoxItem Content="Unencrypted"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <ui:TextBlock Text="Wi-Fi Password" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtWifiPassword" Text="SS_Secure2026!" Padding="10,8" FontSize="12" TextChanged="OnInputTextChanged"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelVCardInput" Visibility="Collapsed">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <ui:TextBlock Text="Full Name" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtVCardName" Text="Harussani SuamiSihat" Padding="8,6" FontSize="12" TextChanged="OnInputTextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <ui:TextBlock Text="Phone Number" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtVCardPhone" Text="+60123456789" Padding="8,6" FontSize="12" TextChanged="OnInputTextChanged"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <ui:TextBlock Text="Email Address" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtVCardEmail" Text="info@suamisihat.com.my" Padding="8,6" FontSize="12" TextChanged="OnInputTextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <ui:TextBlock Text="Organization / Title" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtVCardOrg" Text="SuamiSihat Creative Studio" Padding="8,6" FontSize="12" TextChanged="OnInputTextChanged"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="PanelWhatsAppInput" Visibility="Collapsed">
                                <ui:TextBlock Text="Phone Number (Include Country Code e.g. 60123456789)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtWaPhone" Text="60123456789" Padding="10,8" FontSize="12" Margin="0,0,0,8" TextChanged="OnInputTextChanged"/>
                                <ui:TextBlock Text="Preset Message (Optional)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtWaMessage" Text="Hello SuamiSihat, I would like to inquire about creative brand assets." Padding="10,8" FontSize="12" TextChanged="OnInputTextChanged"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelEmailInput" Visibility="Collapsed">
                                <ui:TextBlock Text="Recipient Email Address" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtEmailTo" Text="contact@suamisihat.com.my" Padding="10,8" FontSize="12" Margin="0,0,0,8" TextChanged="OnInputTextChanged"/>
                                <ui:TextBlock Text="Email Subject" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtEmailSubject" Text="Creative Asset Request" Padding="10,8" FontSize="12" TextChanged="OnInputTextChanged"/>
                            </StackPanel>

                        </StackPanel>
                    </ui:Card>

                    <!-- Card 2: Colors & Gradient Customizer + Quick Palette Presets -->
                    <ui:Card Margin="0,0,0,12" Padding="16">
                        <StackPanel>
                            <ui:TextBlock Text="2. COLORS &amp; GRADIENTS" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,10"/>
                            
                            <!-- Brand Palette Presets -->
                            <ui:TextBlock Text="Instant Brand Color Palettes" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,12">
                                <ui:Button x:Name="BtnPresetNavy" Click="OnColorPresetClicked" Tag="NAVY_AZURE" Padding="10,5" Margin="0,0,6,6" Appearance="Primary">Prussian &amp; Azure</ui:Button>
                                <ui:Button x:Name="BtnPresetGold" Click="OnColorPresetClicked" Tag="GOLD" Padding="10,5" Margin="0,0,6,6" Appearance="Secondary">Gold Elegance</ui:Button>
                                <ui:Button x:Name="BtnPresetEmerald" Click="OnColorPresetClicked" Tag="EMERALD" Padding="10,5" Margin="0,0,6,6" Appearance="Secondary">Emerald Tech</ui:Button>
                                <ui:Button x:Name="BtnPresetMidnight" Click="OnColorPresetClicked" Tag="MIDNIGHT" Padding="10,5" Margin="0,0,6,6" Appearance="Secondary">Midnight Dark</ui:Button>
                            </WrapPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <ui:TextBlock Text="Foreground Primary Color" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="ColorTileFg1" Width="28" Height="28" CornerRadius="6" Background="#022057" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtFg1Hex" Text="#022057" Width="90" Padding="6,4" FontSize="12" VerticalAlignment="Center" TextChanged="OnColorHexChanged"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ui:TextBlock Text="Gradient Secondary" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <CheckBox x:Name="ChkUseGradient" IsChecked="False" Content="Enable" Margin="8,0,0,0" FontSize="10" Click="OnOptionChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="ColorTileFg2" Width="28" Height="28" CornerRadius="6" Background="#21A1F7" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtFg2Hex" Text="#21A1F7" Width="90" Padding="6,4" FontSize="12" VerticalAlignment="Center" TextChanged="OnColorHexChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <ui:TextBlock Text="Background Color" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="ColorTileBg" Width="28" Height="28" CornerRadius="6" Background="#FFFFFF" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtBgHex" Text="#FFFFFF" Width="90" Padding="6,4" FontSize="12" VerticalAlignment="Center" TextChanged="OnColorHexChanged"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock Text="Custom Eye Outer / Inner" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="ColorTileEyeFrame" Width="24" Height="24" CornerRadius="4" Background="#022057" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,4,0" ToolTip="Eye Outer Frame Color"/>
                                        <Border x:Name="ColorTileEyeDot" Width="24" Height="24" CornerRadius="4" Background="#21A1F7" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,6,0" ToolTip="Eye Inner Dot Color"/>
                                        <ui:Button Click="OnSelectEyeColorsClicked" Content="Preset" Padding="8,4" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Card 3: Body & Eye Shapes Styling -->
                    <ui:Card Margin="0,0,0,12" Padding="16">
                        <StackPanel>
                            <ui:TextBlock Text="3. BODY &amp; EYE DOT SHAPES" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,12"/>

                            <!-- Body Dot Shape Picker -->
                            <ui:TextBlock Text="Body Pattern Shape" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,12">
                                <ui:Button x:Name="BtnBodySquare" Click="OnBodyShapeClicked" Tag="Square" Padding="10,6" Margin="0,0,6,6" Appearance="Primary">Square</ui:Button>
                                <ui:Button x:Name="BtnBodyRounded" Click="OnBodyShapeClicked" Tag="Rounded" Padding="10,6" Margin="0,0,6,6" Appearance="Secondary">Rounded</ui:Button>
                                <ui:Button x:Name="BtnBodyCircle" Click="OnBodyShapeClicked" Tag="Circle" Padding="10,6" Margin="0,0,6,6" Appearance="Secondary">Circle</ui:Button>
                                <ui:Button x:Name="BtnBodyDots" Click="OnBodyShapeClicked" Tag="Dots" Padding="10,6" Margin="0,0,6,6" Appearance="Secondary">Dots</ui:Button>
                                <ui:Button x:Name="BtnBodyDiamond" Click="OnBodyShapeClicked" Tag="Diamond" Padding="10,6" Margin="0,0,6,6" Appearance="Secondary">Diamond</ui:Button>
                                <ui:Button x:Name="BtnBodyClassy" Click="OnBodyShapeClicked" Tag="Classy" Padding="10,6" Margin="0,0,6,6" Appearance="Secondary">Classy</ui:Button>
                            </WrapPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <ui:TextBlock Text="Eye Outer Frame" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbEyeFrameShape" SelectedIndex="0" Padding="8,6" SelectionChanged="OnOptionChanged">
                                        <ComboBoxItem Content="Square Outer"/>
                                        <ComboBoxItem Content="Rounded Outer"/>
                                        <ComboBoxItem Content="Circle Outer"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock Text="Eye Inner Ball" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbEyeDotShape" SelectedIndex="0" Padding="8,6" SelectionChanged="OnOptionChanged">
                                        <ComboBoxItem Content="Square Dot"/>
                                        <ComboBoxItem Content="Circle Dot"/>
                                        <ComboBoxItem Content="Diamond Dot"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Card 4: Logo & Branding Overlay -->
                    <ui:Card Padding="16">
                        <StackPanel>
                            <ui:TextBlock Text="4. LOGO &amp; WATERMARK OVERLAY" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,12"/>
                            
                            <ui:TextBlock Text="Logo Overlay Options" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,12">
                                <ui:Button x:Name="BtnLogoSsIcon" Click="OnPresetLogoClicked" Tag="SS_ICON" Padding="12,6" Margin="0,0,6,6" Appearance="Primary">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="SuamiSihat Logo (ss_icon_light)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="BtnLogoNone" Click="OnPresetLogoClicked" Tag="NONE" Padding="12,6" Margin="0,0,6,6" Appearance="Secondary">No Logo</ui:Button>
                            </WrapPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Appearance="Secondary" Click="OnUploadCustomLogoClicked" Padding="12,6" Cursor="Hand" ToolTip="Upload custom image logo">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Upload Custom Image Logo..." FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <CheckBox Grid.Column="1" x:Name="ChkLogoBackground" IsChecked="True" Content="White Background Pad" Margin="12,0,0,0" FontSize="11" VerticalAlignment="Center" Click="OnOptionChanged"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                </StackPanel>

                <!-- Right Column: Real-Time Live Preview & High-Res Export -->
                <StackPanel Grid.Column="1">
                    <ui:Card Padding="20" Effect="{DynamicResource FluentDepth8}">
                        <StackPanel>
                            <!-- Live Scannability Badge Header -->
                            <Grid Margin="0,0,0,12">
                                <ui:TextBlock Text="REAL-TIME PREVIEW" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center"/>
                                
                                <Border x:Name="BadgeScannability" HorizontalAlignment="Right" CornerRadius="12" Background="#10B981" Padding="8,3">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ui:TextBlock x:Name="TxtScannabilityStatus" Text="100% SCANNABLE" FontSize="9" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Backdrop Light & Dark Mode Options -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <ui:TextBlock Text="Backdrop Mode:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ui:Button x:Name="BtnBackdropLight" Click="OnBackdropThemeClicked" Tag="LIGHT" Padding="8,3" Margin="0,0,4,0" Appearance="Primary" FontSize="10">Light Mode</ui:Button>
                                <ui:Button x:Name="BtnBackdropDark" Click="OnBackdropThemeClicked" Tag="DARK" Padding="8,3" Margin="0,0,4,0" Appearance="Secondary" FontSize="10">Dark Mode</ui:Button>
                            </StackPanel>

                            <!-- Live Rendered Bitmap Preview Box -->
                            <Border x:Name="PreviewContainerBorder" CornerRadius="12" Background="#FFFFFF" Padding="16" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Image x:Name="ImgQrPreview" Width="260" Height="260" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <!-- Size & Resolution Slider -->
                            <ui:TextBlock Text="Export Resolution Size" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" x:Name="SldResolution" Minimum="300" Maximum="2000" Value="800" TickFrequency="100" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnResolutionSliderChanged"/>
                                <ui:TextBlock Grid.Column="1" x:Name="TxtResolutionValue" Text="800px" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FluentBrand80}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Error Correction Level -->
                            <ui:TextBlock Text="Error Correction Reliability" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbErrorCorrection" SelectedIndex="0" Padding="8,6" Margin="0,0,0,18" SelectionChanged="OnOptionChanged">
                                <ComboBoxItem Content="High (30% Data Recovery - Best for Logos)"/>
                                <ComboBoxItem Content="Quartile (25% Data Recovery)"/>
                                <ComboBoxItem Content="Medium (15% Data Recovery)"/>
                                <ComboBoxItem Content="Low (7% Data Recovery)"/>
                            </ComboBox>

                            <!-- Primary Export Button -->
                            <ui:Button Appearance="Primary" Click="OnExportPngClicked" Padding="14,10" Margin="0,0,0,8" HorizontalAlignment="Stretch" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Download High-Res PNG" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
