<Page x:Class="SS_CAM.Views.QuickNotePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Quick Note"
      Focusable="True" KeyDown="OnPageKeyDown">

    <Grid Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="24,20,24,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ui:SymbolIcon Symbol="Document24" FontSize="24" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ui:TextBlock Text="Quick Notes &amp; Markdown Scratchpad" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <ui:TextBlock Text="Capture creative briefs, meeting notes, client feedback, and design ideas with live Markdown preview."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"
                       Margin="0,2,0,0" />
        </StackPanel>

        <!-- Main Two-Panel Body -->
        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Notes List Sidebar ── -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,12,12,8">
                        <StackPanel>
                            <!-- Full-width Primary New Note Button -->
                            <ui:Button Click="OnNewNoteClicked" Appearance="Primary" Height="34"
                                       HorizontalAlignment="Stretch" Cursor="Hand" ToolTip="Create New Note (Ctrl+N)">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="New Note" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                            <!-- Instant Search Box -->
                            <ui:TextBox x:Name="TxtSearchNotes" PlaceholderText="Search notes..." Margin="0,8,0,8"
                                        TextChanged="OnSearchNotesChanged" Height="30" FontSize="11.5"
                                        Icon="Search24"/>

                            <!-- Filter Chips Row -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:Button x:Name="BtnFilterAll" Grid.Column="0" Appearance="Secondary"
                                           Height="28" Padding="0" Margin="0,0,3,0"
                                           Click="OnFilterAllClicked" Cursor="Hand" ToolTip="All Notes">
                                    <ui:TextBlock x:Name="TxtFilterAll" Text="All" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ui:Button>
                                <ui:Button x:Name="BtnFilterPinned" Grid.Column="1" Appearance="Secondary"
                                           Height="28" Padding="0" Margin="0,0,3,0"
                                           Click="OnFilterPinnedClicked" Cursor="Hand" ToolTip="Pinned Notes">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:TextBlock x:Name="IconFilterPinned" Text="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock x:Name="TxtFilterPinned" Text="Pin" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="BtnFilterHigh" Grid.Column="2" Appearance="Secondary"
                                           Height="28" Padding="0" Margin="0,0,3,0"
                                           Click="OnFilterHighClicked" Cursor="Hand" ToolTip="High Priority Notes">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:TextBlock x:Name="IconFilterHigh" Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock x:Name="TxtFilterHigh" Text="High" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="BtnFilterTasks" Grid.Column="3" Appearance="Secondary"
                                           Height="28" Padding="0"
                                           Click="OnFilterTasksClicked" Cursor="Hand" ToolTip="Notes with Tasks">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:TextBlock x:Name="IconFilterTasks" Text="&#xE73A;" FontFamily="Segoe Fluent Icons" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock x:Name="TxtFilterTasks" Text="Tasks" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Note count label -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SubtitleBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1" Padding="12,6">
                        <ui:TextBlock x:Name="TxtNoteCount" Text="0 notes"
                                    FontSize="11" FontWeight="Medium"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Border>

                    <!-- Note list -->
                    <ListBox x:Name="NotesList" SelectionChanged="OnNoteSelected"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Padding="8">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemBorder" Padding="10,8" CornerRadius="6" Cursor="Hand"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Selection Indicator Bar -->
                                        <Border x:Name="SelectionPill" Grid.Column="0" Width="3" CornerRadius="1.5"
                                                Background="{DynamicResource FluentBrand80}" Margin="0,0,8,0"
                                                Visibility="Collapsed"/>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                                           Foreground="{DynamicResource FluentBrand80}"
                                                           Visibility="{Binding PinBadgeVisibility}"
                                                           Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Pinned Note"/>
                                                <ui:TextBlock Text="{Binding Title}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Title}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Body snippet preview -->
                                            <ui:TextBlock Text="{Binding Snippet}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,4"
                                                       Opacity="0.85"/>

                                            <!-- Meta row: Modified date + task count -->
                                            <StackPanel Orientation="Horizontal">
                                                <ui:TextBlock Text="{Binding ModifiedDisplay}"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Border Visibility="{Binding TaskBadgeVisibility}" Background="{DynamicResource TextControlBackground}"
                                                        CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <ui:TextBlock Text="{Binding TaskProgressDisplay}" FontSize="9"
                                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Priority Badge Tag -->
                                        <Border Grid.Column="2" CornerRadius="3" Padding="4,1" VerticalAlignment="Center" Margin="4,0,0,0"
                                                Visibility="{Binding PriorityBadgeVisibility}"
                                                Background="{DynamicResource SystemFillColorCautionBrush}">
                                            <ui:TextBlock Text="{Binding PriorityLabel}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource FluentBrandTint}"/>
                                        <Setter TargetName="SelectionPill" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ── Right: Editor Pane ── -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <!-- Toolbar Row -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SubtitleBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0" Padding="12,8">
                        <StackPanel>
                            <!-- Toolbar Row 1: Formatting buttons - full set -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <!-- Headings -->
                                <ui:Button x:Name="NMdH1" Content="H1" Click="OnNMdH1" Height="28" MinWidth="28" Padding="5,0"
                                        Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="Heading 1 (# text)"/>
                                <ui:Button x:Name="NMdH2" Content="H2" Click="OnNMdH2" Height="28" MinWidth="28" Padding="5,0"
                                        Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        FontWeight="SemiBold" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="Heading 2 (## text)"/>
                                <ui:Button x:Name="NMdH3" Content="H3" Click="OnNMdH3" Height="28" MinWidth="28" Padding="5,0"
                                        Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        FontWeight="SemiBold" FontSize="11" BorderThickness="0" Cursor="Hand" ToolTip="Heading 3 (### text)"/>

                                <Border Width="1" Height="14" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="4,0"/>

                                <!-- Inline styles -->
                                <ui:Button x:Name="NMdBold" Content="B" Click="OnNMdBold" Height="28" MinWidth="28" Padding="5,0"
                                        Background="Transparent" Foreground="{DynamicResource FluentBrand80}"
                                        FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" ToolTip="Bold (**text**)"/>
                                <ui:Button x:Name="NMdItalic" Content="I" Click="OnNMdItalic" Height="28" MinWidth="28" Padding="5,0"
                                        Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        FontFamily="Georgia, serif" FontStyle="Italic" FontSize="13"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Italic (*text*)"/>
                                <ui:Button x:Name="NMdStrike" Click="OnNMdStrike" Height="28" MinWidth="28" Padding="5,0"
                                        Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Strikethrough (~~text~~)">
                                    <ui:TextBlock Text="S" FontSize="13" TextDecorations="Strikethrough" VerticalAlignment="Center"/>
                                </ui:Button>
                                <ui:Button x:Name="NMdCode" Click="OnNMdCode" Height="28" MinWidth="28" Padding="5,0"
                                        Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Inline code (`code`)">
                                    <ui:TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                </ui:Button>
                                <ui:Button x:Name="NMdCodeBlock" Click="OnNMdCodeBlock" Height="28" MinWidth="28" Padding="5,0"
                                        Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Code block (``` block ```)">
                                    <ui:TextBlock Text="&#xE943;" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center"/>
                                </ui:Button>

                                <Border Width="1" Height="14" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="4,0"/>

                                <!-- Block elements -->
                                <ui:Button x:Name="NMdQuote" Click="OnNMdQuote" Height="28" MinWidth="28" Padding="5,0"
                                        Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Blockquote (&gt; text)">
                                    <ui:TextBlock Text="&#xE8D2;" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center"/>
                                </ui:Button>
                                <ui:Button x:Name="NMdList" Click="OnNMdList" Height="28" MinWidth="44" Padding="5,0"
                                        Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Bullet list (- text)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="&#x2022;" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="List" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="NMdNumList" Click="OnNMdNumList" Height="28" MinWidth="28" Padding="5,0"
                                        Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Numbered list (1. text)">
                                    <ui:TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center"/>
                                </ui:Button>
                                <ui:Button x:Name="NMdCheck" Click="OnNMdCheck" Height="28" MinWidth="28" Padding="5,0"
                                        Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Task checkbox (- [ ] text)">
                                    <ui:TextBlock Text="&#xE73A;" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center"/>
                                </ui:Button>
                                <ui:Button x:Name="NMdHR" Click="OnNMdHR" Height="28" MinWidth="36" Padding="5,0"
                                        Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Horizontal rule (---)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="&#x2500;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="HR" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>

                                <Border Width="1" Height="14" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="4,0"/>

                                <!-- Insert -->
                                <ui:Button x:Name="NMdLink" Click="OnNMdLink" Height="28" MinWidth="28" Padding="5,0"
                                        Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Link [text](url)">
                                    <ui:TextBlock Text="&#xE71B;" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center"/>
                                </ui:Button>
                                <ui:Button x:Name="NMdImage" Click="OnNMdImage" Height="28" MinWidth="28" Padding="5,0"
                                        Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Image ![alt](url)">
                                    <ui:TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center"/>
                                </ui:Button>

                                <Border Width="1" Height="14" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="4,0"/>

                                <!-- Markdown Guide / Cheatsheet Info Button -->
                                <ui:Button x:Name="BtnMarkdownHelp" Click="OnToggleMarkdownHelp" Height="28" Width="28" Padding="0"
                                        Background="Transparent" Foreground="{DynamicResource FluentBrand80}"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Markdown Guide &amp; Cheatsheet">
                                    <ui:TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ui:Button>
                            </StackPanel>


                            <!-- Toolbar Row 2: Controls + Mode Switcher + Templates + Actions -->
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Group: Pin, Priority, 3-Way Mode, Templates, Copy Plain -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Pin Toggle Button -->
                                    <ui:Button x:Name="BtnTogglePin" Click="OnTogglePinClicked"
                                               Height="28" Width="28" Padding="0" Cursor="Hand" Margin="0,0,6,0"
                                               ToolTip="Pin note to top">
                                        <ui:TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ui:Button>

                                    <!-- Priority Dropdown -->
                                    <ComboBox x:Name="CmbPriority" SelectionChanged="OnPriorityChanged"
                                              Height="28" Width="92" FontSize="11" Margin="0,0,8,0"
                                              Padding="8,0" VerticalContentAlignment="Center" ToolTip="Set note priority">
                                        <ComboBoxItem Content="Normal"/>
                                        <ComboBoxItem Content="Medium"/>
                                        <ComboBoxItem Content="High"/>
                                    </ComboBox>

                                    <!-- 3-Way Mode Segmented Control (Split / Edit / Preview) -->
                                    <Border CornerRadius="4" Margin="0,0,8,0" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="1">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button x:Name="BtnModeSplit" Click="OnModeSplit"
                                                    Height="26" Padding="8,0" Background="{DynamicResource FluentBrand80}"
                                                    Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Split View (Side-by-side Live Preview)">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="SplitVertical24" FontSize="13" Margin="0,0,4,0"/>
                                                    <ui:TextBlock Text="Split" FontSize="11.5" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </ui:Button>
                                            <ui:Button x:Name="BtnModeEdit" Click="OnModeEdit"
                                                    Height="26" Padding="8,0" Background="Transparent"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    BorderThickness="0" Cursor="Hand" ToolTip="Edit Markdown Only">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Edit24" FontSize="13" Margin="0,0,4,0"/>
                                                    <ui:TextBlock Text="Edit" FontSize="11.5"/>
                                                </StackPanel>
                                            </ui:Button>
                                            <ui:Button x:Name="BtnModePreview" Click="OnModePreview"
                                                    Height="26" Padding="8,0" Background="Transparent"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    BorderThickness="0" Cursor="Hand" ToolTip="Preview Markdown Only">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Eye24" FontSize="13" Margin="0,0,4,0"/>
                                                    <ui:TextBlock Text="Preview" FontSize="11.5"/>
                                                </StackPanel>
                                            </ui:Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Templates Dropdown Button -->
                                    <ui:Button x:Name="BtnTemplates" Click="OnTemplatesButtonClicked" Height="28" Padding="8,0" Margin="0,0,6,0"
                                               Cursor="Hand" ToolTip="Insert Ready-to-use Template">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="DocumentSync24" FontSize="13" Margin="0,0,4,0"/>
                                            <ui:TextBlock Text="Templates &#x25BE;" FontSize="11.5"/>
                                        </StackPanel>
                                        <ui:Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Creative Brief" Click="OnTemplateBriefClicked"/>
                                                <MenuItem Header="Client Feedback &amp; Revisions" Click="OnTemplateFeedbackClicked"/>
                                                <MenuItem Header="Meeting Minutes" Click="OnTemplateMeetingClicked"/>
                                                <MenuItem Header="TikTok / Reels 3-Hook Matrix" Click="OnTemplateTikTokClicked"/>
                                                <Separator/>
                                                <MenuItem Header="Task Checklist &amp; Next Steps" Click="OnTemplateChecklistClicked"/>
                                            </ContextMenu>
                                        </ui:Button.ContextMenu>
                                    </ui:Button>

                                    <!-- Copy Plain Text Button -->
                                    <ui:Button x:Name="BtnCopyCleanText" Click="OnCopyCleanTextClicked" Height="28" Padding="8,0" Margin="0,0,6,0"
                                               Cursor="Hand" ToolTip="Copy plain text without markdown markup (for WhatsApp / Slack)">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Copy24" FontSize="13" Margin="0,0,4,0"/>
                                            <ui:TextBlock Text="Clean Text" FontSize="11.5"/>
                                        </StackPanel>
                                    </ui:Button>
                                </StackPanel>

                                <!-- Right Group: Delete Note -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button x:Name="BtnDeleteNote" Appearance="Danger" Click="OnDeleteNoteClicked"
                                               Height="28" Width="28" Padding="0" Cursor="Hand" ToolTip="Delete Note">
                                        <ui:TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                    </Border>

                    <!-- Bottom Telemetry & Sync Strip -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SubtitleBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                            Padding="14,6" CornerRadius="0,0,8,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:TextBlock x:Name="TxtWordCount" Text="0 words" FontSize="11"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                                <ui:TextBlock x:Name="TxtCharCount" Text="0 characters" FontSize="11"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                                <ui:TextBlock x:Name="TxtTaskStats" Text="0 tasks" FontSize="11"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:TextBlock x:Name="TxtSyncStatus" Text="&#x25CF; NAS Synced" FontSize="11" FontWeight="SemiBold"
                                              Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"
                                              Margin="0,0,10,0"/>
                                <ui:TextBlock x:Name="TxtSavedStatus" Text="" FontSize="11"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Editor Body Container -->
                    <Grid>
                        <!-- Empty state (no note selected) -->
                        <Grid x:Name="PanelEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Notebook24" FontSize="56"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <ui:TextBlock Text="No Note Selected"
                                            FontSize="16" FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                                <ui:TextBlock Text="Select a note from the left sidebar or create a new note to start writing."
                                            FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            HorizontalAlignment="Center" Margin="0,6,0,20" TextWrapping="Wrap" TextAlignment="Center"/>
                                <ui:Button Click="OnNewNoteClicked" Appearance="Primary" Height="34" Padding="14,0"
                                           HorizontalAlignment="Center" Cursor="Hand" ToolTip="Create New Note (Ctrl+N)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="Create New Note" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Grid>

                        <!-- Active Note Workspace (Split / Edit / Preview) -->
                        <Grid x:Name="PanelActiveWorkspace" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColNoteEditor" Width="*"/>
                                <ColumnDefinition x:Name="ColNoteSplitter" Width="6"/>
                                <ColumnDefinition x:Name="ColNotePreview" Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Edit Mode TextBox -->
                            <TextBox x:Name="NoteEditor" Grid.Column="0"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas, Cascadia Mono, Segoe UI" FontSize="13"
                                     Padding="16" BorderThickness="0"
                                     Background="{DynamicResource TextControlBackground}"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                     TextChanged="OnNoteEditorChanged"/>

                            <!-- Splitter -->
                            <GridSplitter x:Name="NoteGridSplitter" Grid.Column="1" Width="6"
                                          HorizontalAlignment="Center" Background="{DynamicResource CardStrokeColorDefaultBrush}"
                                          Cursor="SizeWE"/>

                            <!-- Live Rendered Markdown Preview -->
                            <FlowDocumentScrollViewer x:Name="NotePreviewViewer" Grid.Column="2"
                                                      FontFamily="{DynamicResource FluentFontFamily}"
                                                      VerticalScrollBarVisibility="Auto"
                                                      Background="{DynamicResource TextControlBackground}" BorderThickness="0"
                                                      Padding="20"/>
                        </Grid>

                        <!-- Markdown Guide Slide-out Drawer Panel -->
                        <Border x:Name="PanelMarkdownHelp" HorizontalAlignment="Right" Width="320"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Drawer Header -->
                                <Border Grid.Row="0" Background="{DynamicResource SubtitleBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                                        Padding="14,10">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                                       Foreground="{DynamicResource FluentBrand80}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <ui:TextBlock Text="Markdown Reference" FontWeight="Bold" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ui:Button Click="OnCloseMarkdownHelp" Height="24" Width="24" Padding="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Close guide">
                                            <ui:TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </ui:Button>
                                    </Grid>
                                </Border>

                                <!-- Scrollable Cheatsheet Content -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14">
                                    <StackPanel>
                                        <!-- Headings -->
                                        <ui:TextBlock Text="HEADINGS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,6"/>
                                        <Border Background="{DynamicResource TextControlBackground}" CornerRadius="4" Padding="8" Margin="0,0,0,14">
                                            <StackPanel>
                                                <ui:TextBlock Text="# Heading 1" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <ui:TextBlock Text="## Heading 2" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                                <ui:TextBlock Text="### Heading 3" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Text Formatting -->
                                        <ui:TextBlock Text="TEXT FORMATTING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,6"/>
                                        <Border Background="{DynamicResource TextControlBackground}" CornerRadius="4" Padding="8" Margin="0,0,0,14">
                                            <StackPanel>
                                                <ui:TextBlock Text="**Bold text**" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <ui:TextBlock Text="*Italic text*" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                                <ui:TextBlock Text="***Bold &amp; Italic***" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                                <ui:TextBlock Text="~~Strikethrough~~" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                                                <ui:TextBlock Text="`inline code`" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Lists & Tasks -->
                                        <ui:TextBlock Text="LISTS &amp; TASKS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,6"/>
                                        <Border Background="{DynamicResource TextControlBackground}" CornerRadius="4" Padding="8" Margin="0,0,0,14">
                                            <StackPanel>
                                                <ui:TextBlock Text="- Bullet list item" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <ui:TextBlock Text="1. Numbered item" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                                <ui:TextBlock Text="- [ ] Todo task item" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                                <ui:TextBlock Text="- [x] Completed task" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Links & Quotes -->
                                        <ui:TextBlock Text="LINKS &amp; QUOTES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,6"/>
                                        <Border Background="{DynamicResource TextControlBackground}" CornerRadius="4" Padding="8" Margin="0,0,0,14">
                                            <StackPanel>
                                                <ui:TextBlock Text="[Link Label](https://url.com)" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <ui:TextBlock Text="![Alt text](https://image.png)" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,3,0,0"/>
                                                <ui:TextBlock Text="&gt; Blockquote text block" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                                                <ui:TextBlock Text="---" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Code Block -->
                                        <ui:TextBlock Text="CODE BLOCK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,6"/>
                                        <Border Background="{DynamicResource TextControlBackground}" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <ui:TextBlock Text="```" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <ui:TextBlock Text="code block here" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <ui:TextBlock Text="```" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

