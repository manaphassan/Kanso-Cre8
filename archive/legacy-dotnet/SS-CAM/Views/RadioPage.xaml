<Page x:Class="SS_CAM.Views.RadioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:SS_CAM.Converters"
      Title="Radio Player">

    <Page.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Page.Resources>

    <!-- Main Layout Grid (Standard Fluent 2 Page Grid Layout - Consistent with All SS-CAM Pages) -->
    <Grid Margin="24,16,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Row 0: Page Header -->
            <RowDefinition Height="Auto"/>   <!-- Row 1: Hero Featured Player Banner -->
            <RowDefinition Height="Auto"/>   <!-- Row 2: Genre Filter Tabs -->
            <RowDefinition Height="*"/>      <!-- Row 3: Station Cards Grid -->
        </Grid.RowDefinitions>

        <!-- Row 0: Page Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="24" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ui:TextBlock Text="Radio &amp; Focus Audio Streams" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <ui:TextBlock Text="Curated Malaysian radio broadcasts, ambient focus music, and custom stream URLs for uninterrupted creative flow."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"
                           Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Secondary" Click="OnImportPlaylistClicked" Margin="0,0,8,0"
                        Padding="10,6" Cursor="Hand" ToolTip="Import .pls or .m3u" >
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="&#xE8B5;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="Import" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button Appearance="Secondary" Click="OnResetDefaultsClicked" Margin="0,0,8,0"
                        Padding="10,6" Cursor="Hand" ToolTip="Reset to defaults" >
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="Reset" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button Appearance="Primary" Click="OnAddCustomStationClicked"
                        Padding="14,8" Cursor="Hand" ToolTip="Add a custom stream URL" >
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="Add Stream" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Row 1: ── TOP HERO FEATURED PLAYER BANNER (Standard Banner Hero Mesh) ── -->
        <ui:Card Grid.Row="1" MinHeight="130" Height="130" Padding="0" Margin="0,0,0,16"
                 Background="#022057"
                 Effect="{DynamicResource FluentDepth4}"
                 ClipToBounds="True">
            <Border CornerRadius="12" Background="#022057" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                <Grid x:Name="HeroMeshContainer" SizeChanged="OnHeroMeshSizeChanged" MouseMove="OnHeroMeshMouseMove" MouseLeave="OnHeroMeshMouseLeave" Background="#022057" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                <!-- SuamiSihat Hero Mesh Backdrop Animation Layer (HERO-BANNER-BACKGROUND.md standard) -->
                <Rectangle x:Name="HeroMeshAtmosphere" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Rectangle.Fill>
                        <LinearGradientBrush x:Name="HeroMeshGrad" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop x:Name="HeroMeshStop1" Color="#022057" Offset="0.0"/>
                            <GradientStop x:Name="HeroMeshStop2" Color="#043388" Offset="0.6"/>
                            <GradientStop x:Name="HeroMeshStop3" Color="#021233" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Dynamic Pulsating Aura Glow Rings & SuamiSihat Men Icon Backdrop -->
                <Canvas x:Name="HeroMeshBackdropCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                    <!-- Glowing Azure Aura Ring -->
                    <Ellipse x:Name="AuraRing1" Width="380" Height="380" Canvas.Right="-60" Canvas.Top="-120" Opacity="0.50">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#21A1F7" Offset="0.0"/>
                                <GradientStop Color="#0021A1F7" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="AuraScale1" CenterX="190" CenterY="190" ScaleX="1.0" ScaleY="1.0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Glowing Brand Yellow Aura Ring -->
                    <Ellipse x:Name="AuraRing2" Width="320" Height="320" Canvas.Left="-60" Canvas.Bottom="-110" Opacity="0.40">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FCE53D" Offset="0.0"/>
                                <GradientStop Color="#00FCE53D" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="AuraScale2" CenterX="160" CenterY="160" ScaleX="1.0" ScaleY="1.0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Concentric Bass Shockwave Ripple Ring (Expanding on bass drops) -->
                    <Ellipse x:Name="BassShockwaveRing" Width="140" Height="140" Canvas.Right="180" Canvas.Top="20" Opacity="0" IsHitTestVisible="False">
                        <Ellipse.Stroke>
                            <SolidColorBrush x:Name="ShockwaveBrush" Color="#21A1F7"/>
                        </Ellipse.Stroke>
                        <Ellipse.StrokeThickness>
                            <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib">3.0</System:Double>
                        </Ellipse.StrokeThickness>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="ShockwaveScale" CenterX="70" CenterY="70" ScaleX="1.0" ScaleY="1.0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Floating Spark Particles Layer (Transient treble & energy sparkles) -->
                    <Canvas x:Name="ParticleCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                        <Ellipse x:Name="Spark1" Width="5" Height="5" Canvas.Right="140" Canvas.Top="20" Fill="#FCE53D" Opacity="0.6">
                            <Ellipse.Effect><DropShadowEffect Color="#FCE53D" BlurRadius="8" ShadowDepth="0"/></Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="Spark2" Width="4" Height="4" Canvas.Right="220" Canvas.Top="45" Fill="#21A1F7" Opacity="0.7">
                            <Ellipse.Effect><DropShadowEffect Color="#21A1F7" BlurRadius="8" ShadowDepth="0"/></Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="Spark3" Width="6" Height="6" Canvas.Right="80" Canvas.Top="60" Fill="#38BDF8" Opacity="0.5">
                            <Ellipse.Effect><DropShadowEffect Color="#38BDF8" BlurRadius="10" ShadowDepth="0"/></Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="Spark4" Width="4" Height="4" Canvas.Left="120" Canvas.Top="30" Fill="#FCE53D" Opacity="0.6">
                            <Ellipse.Effect><DropShadowEffect Color="#FCE53D" BlurRadius="8" ShadowDepth="0"/></Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="Spark5" Width="5" Height="5" Canvas.Left="260" Canvas.Top="55" Fill="#21A1F7" Opacity="0.7">
                            <Ellipse.Effect><DropShadowEffect Color="#21A1F7" BlurRadius="8" ShadowDepth="0"/></Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="Spark6" Width="3" Height="3" Canvas.Right="180" Canvas.Top="15" Fill="#FFFFFF" Opacity="0.8">
                            <Ellipse.Effect><DropShadowEffect Color="#FFFFFF" BlurRadius="6" ShadowDepth="0"/></Ellipse.Effect>
                        </Ellipse>
                    </Canvas>

                    <!-- 69 Scattered Floating Mars Symbols (♂) Canvas (Active only during audio playback) -->
                    <Canvas x:Name="ScatteredSymbolsCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0" IsHitTestVisible="False"/>

                    <!-- SuamiSihat Floating Crest Icon (Active only during audio playback) -->
                    <Canvas x:Name="SSLogoCanvas" Canvas.Right="240" Canvas.Top="25" Opacity="0" IsHitTestVisible="False">
                        <Grid Width="70" Height="70">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="MenIconScale" CenterX="35" CenterY="35" ScaleX="1.0" ScaleY="1.0"/>
                            </Grid.RenderTransform>
                            <Viewbox Width="65" Height="65" Opacity="0.35">
                                <Canvas Width="1081" Height="1080">
                                    <Path Data="M502.876,705.61c11.387,10.993 24.629,18.95 38.659,23.928c23.084,8.125 48.39,8.125 71.501,-0.03l0.027,-0.027c3.572,-1.209 7.031,-2.643 10.488,-4.301l0.03,-0.03c10.121,-4.836 19.652,-11.33 28.144,-19.54c0.505,-0.449 1.012,-0.956 1.491,-1.433c0.477,-0.48 0.982,-0.984 1.434,-1.491c8.21,-8.49 14.704,-18.024 19.539,-28.144c1.661,-3.46 3.122,-6.946 4.331,-10.516l0.028,-0.027c8.154,-23.113 8.154,-48.418 0.027,-71.501c-4.975,-14.032 -12.933,-27.275 -23.925,-38.662c-0.452,-0.504 -0.957,-1.011 -1.434,-1.488l-101.221,-101.221c-13.974,-13.974 -36.636,-13.974 -50.61,-0c-13.468,13.467 -13.945,35.032 -1.434,49.119c0.45,0.507 0.957,1.014 1.434,1.491l101.221,101.219c0.477,0.479 0.984,0.984 1.433,1.491c12.511,14.087 12.034,35.652 -1.433,49.119c-13.975,13.975 -36.636,13.975 -50.611,0l-62.559,-62.559l-50.611,50.61l62.56,62.56c0.479,0.477 0.984,0.984 1.491,1.433" Fill="#6DC6EC"/>
