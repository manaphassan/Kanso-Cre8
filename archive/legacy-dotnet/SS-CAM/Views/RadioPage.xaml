                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Canvas>

                    <!-- Dual-Ribbon 3D Waveform Paths (for Waveform mode) -->
                    <Path x:Name="HeroWavePath" Stroke="#21A1F7" StrokeThickness="3.0" Opacity="0.85" Visibility="Collapsed">
                        <Path.Effect>
                            <DropShadowEffect Color="#21A1F7" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
                        </Path.Effect>
                    </Path>
                    <Path x:Name="HeroWavePath2" Stroke="#FCE53D" StrokeThickness="2.0" Opacity="0.75" Visibility="Collapsed">
                        <Path.Effect>
                            <DropShadowEffect Color="#FCE53D" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>
                        </Path.Effect>
                    </Path>

                    <!-- Water Drop Line Ripple Paths (for WaterDrop mode) -->
                    <Path x:Name="HeroWaterDropPath" Stroke="#21A1F7" StrokeThickness="3.0" Opacity="0.85" Visibility="Collapsed">
                        <Path.Effect>
                            <DropShadowEffect Color="#21A1F7" BlurRadius="16" ShadowDepth="0" Opacity="0.85"/>
                        </Path.Effect>
                    </Path>
                    <Path x:Name="HeroWaterDropPath2" Stroke="#38BDF8" StrokeThickness="2.0" Opacity="0.70" Visibility="Collapsed">
                        <Path.Effect>
                            <DropShadowEffect Color="#38BDF8" BlurRadius="12" ShadowDepth="0" Opacity="0.75"/>
                        </Path.Effect>
                    </Path>
                </Canvas>

                <!-- Foreground Content Overlay -->
                <Grid Panel.ZIndex="1" Margin="24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>      <!-- Track / Station Metadata -->
                        <ColumnDefinition Width="Auto"/>   <!-- Hero Controls & Visualizer -->
                    </Grid.ColumnDefinitions>

                    <!-- Station Metadata + Status -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- Cover Art / Fallback Emoji Container -->
                            <Grid Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Border CornerRadius="6" Background="#1E293B" ClipToBounds="True">
                                    <Image x:Name="HeroCoverImage" Width="28" Height="28" Stretch="UniformToFill" Visibility="Collapsed"/>
                                </Border>
                                <ui:TextBlock x:Name="HeroIconText" Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                           Foreground="#21A1F7" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>

                            <ui:TextBlock x:Name="HeroStationName" Text="No station selected"
                                       FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Border x:Name="HeroGenreBadge" Background="#21A1F7"
                                    CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <ui:TextBlock x:Name="HeroGenreText" Text="Select Stream" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        
                        <ui:TextBlock x:Name="HeroStreamTitleText" Text="Click any radio card below to tune in live..."
                                   FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ui:TextBlock x:Name="HeroStatusDot" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ui:TextBlock x:Name="HeroStatusText" Text="Ready" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Hero Transport Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Play / Pause CTA -->
                        <ui:Button x:Name="HeroPlayBtn" Click="OnHeroPlayClicked" Appearance="Primary"
                                   Width="42" Height="42" CornerRadius="21" Padding="0" Margin="0,0,8,0" Cursor="Hand" ToolTip="Play / Pause">
                            <ui:TextBlock x:Name="HeroPlayBtnText" Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="18"/>
                        </ui:Button>

                        <!-- Stop Button -->
                        <ui:Button x:Name="HeroStopBtn" Click="OnHeroStopClicked" Appearance="Secondary"
                                   Width="36" Height="36" Padding="0" Margin="0,0,4,0" Cursor="Hand" ToolTip="Stop Stream">
                            <ui:TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </ui:Card>

        <!-- Row 2: Genre Filter Tabs -->
        <ui:Card Grid.Row="2" Padding="6" Margin="0,0,0,12">
                <WrapPanel x:Name="FilterCategoryPanel">
                    <Border x:Name="TabAll" CornerRadius="6" Background="{DynamicResource FluentBrand80}" Margin="2">
                        <ui:Button Tag="ALL" Click="OnFilterClicked" Padding="12,6"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" FontWeight="Bold" FontSize="11"
                                >
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="All" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Border>
                    <Border x:Name="TabFav" CornerRadius="6" Background="Transparent" Margin="2">
                        <ui:Button Tag="FAV" Click="OnFilterClicked" Padding="12,6"
                                Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                BorderThickness="0" FontWeight="SemiBold" FontSize="11"
                                >
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Favourites" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Border>
                    <Border x:Name="TabFocus" CornerRadius="6" Background="Transparent" Margin="2">
                        <ui:Button Tag="FOCUS" Click="OnFilterClicked" Padding="12,6"
                                Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                BorderThickness="0" FontWeight="SemiBold" FontSize="11"
                                >
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Focus / Lo-Fi" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Border>
                    <Border x:Name="TabPop" CornerRadius="6" Background="Transparent" Margin="2">
                        <ui:Button Tag="POP" Click="OnFilterClicked" Padding="12,6"
                                Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                BorderThickness="0" FontWeight="SemiBold" FontSize="11"
                                >
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Pop / Hits" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Border>
                    <Border x:Name="TabTalk" CornerRadius="6" Background="Transparent" Margin="2">
                        <ui:Button Tag="TALK" Click="OnFilterClicked" Padding="12,6"
                                Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                BorderThickness="0" FontWeight="SemiBold" FontSize="11"
                                >
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xE8D4;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Talk / News" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Border>
                    <Border x:Name="TabJazz" CornerRadius="6" Background="Transparent" Margin="2">
                        <ui:Button Tag="JAZZ" Click="OnFilterClicked" Padding="12,6"
                                Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                BorderThickness="0" FontWeight="SemiBold" FontSize="11"
                                >
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xEC4F;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Jazz / Chill" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Border>
                    <Border x:Name="TabCustom" CornerRadius="6" Background="Transparent" Margin="2">
                        <ui:Button Tag="CUSTOM" Click="OnFilterClicked" Padding="12,6"
                                Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                BorderThickness="0" FontWeight="SemiBold" FontSize="11"
                                >
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Custom" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Border>
                </WrapPanel>
            </ui:Card>

            <!-- Station Cards (3-column, scrollable) -->
            <ScrollViewer Grid.Row="3" Margin="0" VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" Background="Transparent" PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                <ItemsControl x:Name="StationItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="5" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>  <!-- Meta -->
                                        <RowDefinition Height="Auto"/>  <!-- Actions -->
                                    </Grid.RowDefinitions>

                                    <!-- Name + Genre + Description -->
                                    <StackPanel Grid.Row="0" Margin="14,12,14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       FontWeight="Bold" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="{DynamicResource FluentBrandLight}"
                                                    CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <ui:TextBlock Text="{Binding Genre}"
                                                           Foreground="{DynamicResource FluentBrand80}"
                                                           FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <ui:TextBlock Text="{Binding Description}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Action row -->
                                    <Border Grid.Row="1"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Favourite + Edit -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <ui:Button Click="OnStationFavoriteClicked" Tag="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" ToolTip="Toggle Favourite" Padding="4">
                                                    <ui:TextBlock Text="{Binding FavIcon}" FontFamily="Segoe Fluent Icons"
                                                               FontSize="14" Foreground="{DynamicResource FluentBrand80}"/>
                                                </ui:Button>
                                                <ui:Button Click="OnStationEditClicked" Tag="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" ToolTip="Edit" Padding="4">
                                                    <ui:TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons"
                                                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </ui:Button>
                                            </StackPanel>
                                            <!-- Play button (primary, centred) -->
                                            <Border Grid.Column="1" HorizontalAlignment="Center"
                                                    Width="34" Height="34" CornerRadius="17"
                                                    Background="{DynamicResource FluentBrand80}">
                                                <ui:Button Click="OnStationPlayClicked" Tag="{Binding}"
                                                        Background="Transparent" Foreground="White"
                                                        BorderThickness="0" Cursor="Hand" ToolTip="Tune In">
                                                    <ui:TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons"
                                                               FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </ui:Button>
                                            </Border>
                                            <!-- Delete -->
                                            <ui:Button Grid.Column="2" Click="OnStationDeleteClicked" Tag="{Binding}"
                                                    Background="Transparent" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                    BorderThickness="0" Cursor="Hand" ToolTip="Remove" Padding="4">
                                                <ui:TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                                            </ui:Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Add / Edit Modal overlay -->
            <Grid x:Name="AddStationModal" Grid.RowSpan="3"
                  Background="#80000000" Visibility="Collapsed">
                <Border Background="{DynamicResource FluentLightCardBg}"
                        CornerRadius="12" Width="480" Padding="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource FluentLightStroke}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                           Foreground="{DynamicResource FluentBrand80}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ui:TextBlock x:Name="ModalTitleText" Text="Add Custom Radio Stream"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource FluentBrand80}"
                                           VerticalAlignment="Center"
                                           />
                            </StackPanel>
                            <ui:Button Click="OnCloseModalClicked" HorizontalAlignment="Right"
                                    Background="Transparent"
                                    Foreground="{DynamicResource FluentLightTextSecondary}"
                                    BorderThickness="0" Cursor="Hand" Padding="4">
                                <ui:TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                            </ui:Button>
                        </Grid>

                        <ui:TextBlock Text="Station Name" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"
                                   />
                        <TextBox x:Name="TxtStationName" Padding="8,6" Margin="0,0,0,12" FontSize="12"/>

                        <ui:TextBlock Text="Stream URL" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"
                                   />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtStreamUrl" Grid.Column="0" Padding="8,6" FontSize="12" Text="https://"/>
                            <ui:Button Grid.Column="1" Appearance="Primary" Click="OnTestStreamClicked" Padding="10,0"
                                    FontWeight="Bold" FontSize="11" Cursor="Hand" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                               Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Text="Test" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                        <Border x:Name="StreamTestBadge"
                                Background="{DynamicResource FluentLightCardSubBg}"
                                CornerRadius="4" Padding="8,4" Margin="0,0,0,12" Visibility="Collapsed">
                            <ui:TextBlock x:Name="StreamTestText" Text="Stream status" FontSize="10"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       />
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <ui:TextBlock Text="Genre" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"
                                           />
                                <ComboBox x:Name="CmbGenre" Padding="8,6" FontSize="12" IsEditable="True">
                                    <ComboBoxItem Content="Focus / Lo-Fi" IsSelected="True"/>
                                    <ComboBoxItem Content="Pop / Hits"/>
                                    <ComboBoxItem Content="Talk / News"/>
                                    <ComboBoxItem Content="Jazz / Chill"/>
                                    <ComboBoxItem Content="Malay Pop"/>
                                    <ComboBoxItem Content="Custom"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <ui:TextBlock Text="Emoji" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"
                                           />
                                <TextBox x:Name="TxtEmoji" Text="" Padding="8,6"
                                         Width="56" TextAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <ui:TextBlock Text="Description (Optional)" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource FluentLightTextSecondary}" Margin="0,0,0,4"
                                   />
                        <TextBox x:Name="TxtDescription" Padding="8,6" Margin="0,0,0,20" FontSize="12"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Appearance="Secondary" Click="OnCloseModalClicked" Content="Cancel" Padding="14,6" Margin="0,0,8,0" Cursor="Hand"/>
                            <ui:Button Appearance="Primary" Click="OnSaveCustomStationClicked" Content="Save Station" Padding="16,6"
                                    FontWeight="Bold" Cursor="Hand" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
</Page>

