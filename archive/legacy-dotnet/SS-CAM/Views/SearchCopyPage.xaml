<Page x:Class="SS_CAM.Views.SearchCopyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Search &amp; Copy"
      Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <ScrollViewer x:Name="PageScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.CanContentScroll="False"
                      PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
        <StackPanel Margin="24,16,24,24">

            <!-- ── Page Header ── -->
            <StackPanel Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ui:SymbolIcon Symbol="Search24" FontSize="24" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ui:TextBlock Text="Project Workspace Catalog" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <ui:TextBlock Text="Browse your workspace like a catalog &#x2014; select a project from the top tray to inspect its brief, assets, and task telemetry."
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>

            <!-- ── 1. TOP SECTION: SEARCH FILTERS & HORIZONTAL PROJECT FOLDERS TRAY (MAX 10) ── -->
            <ui:Card Padding="16,14" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Row 1: Search Bar & Filter Dropdowns -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox x:Name="SearchInput" Grid.Column="0" Height="36"
                                    PlaceholderText="Search project title, Project ID..." 
                                    TextChanged="OnSearchInputChanged"/>

                        <ComboBox x:Name="DesignerFilterCmb" Grid.Column="2" Height="36" Padding="10,4" FontSize="12" SelectionChanged="OnFilterChanged"
                                  VerticalContentAlignment="Center"/>

                        <ComboBox x:Name="CategoryFilterCmb" Grid.Column="4" Height="36" Padding="10,4" FontSize="12" SelectionChanged="OnFilterChanged"
                                  VerticalContentAlignment="Center"/>

                        <ui:Button Grid.Column="6" Appearance="Primary" Click="OnSearchClicked"
                                   Height="36" Padding="16,0" FontWeight="Bold" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Search24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="Search" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <!-- Row 2: Tray Header + Project Count Badge + Batch Action Bar (if active) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="PROJECT FOLDERS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <ui:TextBlock x:Name="TxtProjectCount" Text="Loading..." FontSize="10.5" Foreground="{DynamicResource FluentBrand80}" FontWeight="Bold"/>
                            </Border>
                            <ui:TextBlock Text="&#x2022; Max 10 recent projects displayed" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Inline Batch Action Bar -->
                        <StackPanel x:Name="BatchActionBar" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="CheckmarkSquare24" FontSize="12" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock x:Name="TxtBatchCount" Text="0 selected" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="BatchStatusCmb" Height="28" Width="120" Padding="6,2" VerticalContentAlignment="Center" FontSize="10" SelectionChanged="OnBatchStatusChanged" Margin="0,0,6,0">
                                <ComboBoxItem Content="Set Status..." VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="backlog" VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="in-progress" VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="review" VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="done" VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="on-hold" VerticalContentAlignment="Center"/>
                            </ComboBox>
                            <ComboBox x:Name="BatchPriorityCmb" Height="28" Width="120" Padding="6,2" VerticalContentAlignment="Center" FontSize="10" SelectionChanged="OnBatchPriorityChanged" Margin="0,0,6,0">
                                <ComboBoxItem Content="Set Priority..." VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="low" VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="medium" VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="high" VerticalContentAlignment="Center"/>
                                <ComboBoxItem Content="urgent" VerticalContentAlignment="Center"/>
                            </ComboBox>
                            <ui:Button Appearance="Secondary" Height="28" Padding="8,0" FontSize="10.5" Click="OnBatchDeselectClicked" Cursor="Hand">
                                Clear
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 3: Horizontal Scrollable List of Project Tiles (Max 10) -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,2">
                        <ListBox x:Name="ResultsListBox"
                                 SelectionMode="Extended"
                                 SelectionChanged="OnListSelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="CardBorder"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="0"
                                            Width="255" Height="80" Cursor="Hand" Margin="0,0,8,0">
                                        <Grid>
                                            <!-- Left Selected Accent Indicator -->
                                            <Border x:Name="SelectedIndicator" Width="4" HorizontalAlignment="Left"
                                                    Background="{DynamicResource FluentBrand80}" CornerRadius="8,0,0,8"
                                                    Visibility="Collapsed"/>

                                            <Grid Margin="12,10,12,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Top Row: Icon + Title + Active Pill -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <ui:SymbolIcon x:Name="FolderIcon" Symbol="Folder24" FontSize="14"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    
                                                    <ui:TextBlock x:Name="TxtTitle" Grid.Column="1" Text="{Binding Project}"
                                                                  FontSize="11.5" FontWeight="SemiBold"
                                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                  TextTrimming="CharacterEllipsis"
                                                                  TextWrapping="NoWrap" VerticalAlignment="Center"/>

                                                    <!-- Selected Badge -->
                                                    <Border x:Name="ActivePill" Grid.Column="2"
                                                            Background="{DynamicResource FluentBrand80}"
                                                            CornerRadius="4" Padding="5,1" Margin="4,0,0,0"
                                                            Visibility="Collapsed" VerticalAlignment="Center">
                                                        <ui:TextBlock Text="ACTIVE" FontSize="8.5" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Bottom Row: File Count, Size, Modified Date -->
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,4,0,0">
                                                    <ui:TextBlock Text="{Binding FileCount}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <ui:TextBlock Text=" files &#x00B7; " FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <ui:TextBlock Text="{Binding FormattedSize}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <ui:TextBlock Text=" &#x00B7; " FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <ui:TextBlock Text="{Binding Modified}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource FluentBrandTint}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource FluentBrand80}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                            <Setter TargetName="SelectedIndicator" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="ActivePill" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="FolderIcon" Property="Foreground" Value="{DynamicResource FluentBrand80}"/>
                                            <Setter TargetName="TxtTitle" Property="FontWeight" Value="Bold"/>
                                            <Setter TargetName="TxtTitle" Property="Foreground" Value="{DynamicResource FluentBrand80}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </StackPanel>
            </ui:Card>

            <!-- ── 2. BOTTOM SECTION: FULL-WIDTH & FULL-HEIGHT PROJECT WORKSPACE ── -->
            <ui:Card Padding="0" MinHeight="680" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Top Header Strip -->
                        <RowDefinition Height="Auto"/>
                        <!-- Center Workspace (Canvas + Inspector) -->
                        <RowDefinition Height="*"/>
                        <!-- Bottom Action Footer -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Selected Project Header Strip -->
                    <Border Grid.Row="0" x:Name="SelectedHighlightBadge"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="PROJECT WORKSPACE" 
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  FontSize="10" FontWeight="Bold"/>
                                    <Border x:Name="InspectorStatusBadge" Background="{DynamicResource FluentBrand80}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                        <ui:TextBlock x:Name="TxtInspectorStatusBadge" Text="in-progress" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <ui:TextBlock x:Name="SelectedProjectTitle" Text="None selected"
                                              Foreground="{DynamicResource FluentBrand80}"
                                              FontSize="16" FontWeight="Bold" Margin="0,3,0,0"
                                              TextTrimming="CharacterEllipsis"/>
                                <ui:TextBlock x:Name="SelectedProjectPath"
                                              Text="Select a project from the top tray to inspect its brief."
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Mode Toggle Tab Strip -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="BtnModeRendered" Appearance="Primary" Click="OnModeRenderedClicked"
                                           Height="30" Padding="12,0"
                                           Cursor="Hand" ToolTip="Preview - rendered README">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Eye24" FontSize="13" Margin="0,0,5,0"/>
                                        <ui:TextBlock Text="Rendered Brief" FontSize="11.5"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="BtnModeRaw" Appearance="Secondary" Click="OnModeRawClicked"
                                           Height="30" Padding="12,0" Margin="6,0,0,0"
                                           Cursor="Hand" ToolTip="Raw - plain Markdown source">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Code24" FontSize="13" Margin="0,0,5,0"/>
                                        <ui:TextBlock Text="Raw Source" FontSize="11.5"/>
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button x:Name="BtnModeImages" Appearance="Secondary" Click="OnModeImagesClicked"
                                           Height="30" Padding="12,0" Margin="6,0,0,0"
                                           Cursor="Hand" ToolTip="Gallery - project image assets">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Image24" FontSize="13" Margin="0,0,5,0"/>
                                        <ui:TextBlock Text="Assets Gallery" FontSize="11.5"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. Center 2-Column Split: Left Canvas + Right Inspector -->
                    <Grid Grid.Row="1" MinHeight="520">
                        <Grid.ColumnDefinitions>
                            <!-- Left Canvas (Brief / Markdown / Images) -->
                            <ColumnDefinition Width="*"/>
                            <!-- Splitter -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Right Inspector Sheet (Expanded breathing room) -->
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Canvas Area -->
                        <Grid Grid.Column="0">
                            <!-- Edit Mode Panel (Collapsed by default) -->
                            <DockPanel x:Name="EditBriefPanel" Visibility="Collapsed">
                                <!-- Edit Toolbar -->
                                <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <ui:Button Content="B" Click="OnEditMdBold" Height="26" Width="30" Background="Transparent"
                                                       Foreground="{DynamicResource FluentBrand80}" FontWeight="Bold" FontSize="12"
                                                       BorderThickness="0" Cursor="Hand" />
                                            <ui:Button Content="I" Click="OnEditMdItalic" Height="26" Width="30" Background="Transparent"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontStyle="Italic"
                                                       FontFamily="Georgia, serif" FontSize="12" BorderThickness="0" Cursor="Hand"/>
                                            <ui:Button Click="OnEditMdCode" Height="26" Width="30" Background="Transparent"
                                                       BorderThickness="0" Cursor="Hand" FontFamily="Consolas">
                                                <ui:TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="10.5"
                                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </ui:Button>
                                            <ui:Button Content="H2" Click="OnEditMdH2" Height="26" Width="34" Background="Transparent"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="10.5"
                                                       FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                                            <ui:Button Content="* List" Click="OnEditMdList" Height="26" Padding="6,0" Background="Transparent"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="10.5"
                                                       BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ui:Button Appearance="Primary" Click="OnSaveBriefClicked"
                                                       Height="28" Padding="12,0" FontSize="11.5" FontWeight="Bold" Cursor="Hand" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Save24" FontSize="12" Margin="0,0,4,0"/>
                                                    <ui:TextBlock Text="Save Brief"/>
                                                </StackPanel>
                                            </ui:Button>
                                            <ui:Button Appearance="Secondary" Click="OnCancelEditClicked"
                                                       Height="28" Padding="12,0" FontSize="11.5" Cursor="Hand">
                                                Cancel
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- Brief Editor TextBox -->
                                <TextBox x:Name="BriefEditor"
                                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas, Cascadia Code, monospace" FontSize="12.5"
                                         Padding="16" BorderThickness="0" Background="{DynamicResource TextControlBackground}"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </DockPanel>

                            <!-- Rendered Markdown Viewer -->
                            <FlowDocumentScrollViewer x:Name="RenderedMarkdownViewer"
                                                      FontFamily="{DynamicResource FluentFontFamily}"
                                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                      VerticalScrollBarVisibility="Auto"
                                                      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                      BorderThickness="0"
                                                      Padding="18"/>

                            <!-- Raw Text Viewer -->
                            <TextBox x:Name="RawMarkdownBox"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Visibility="Collapsed"
                                     FontFamily="Cascadia Code, Consolas, Segoe UI Mono, monospace" FontSize="12"
                                     Background="{DynamicResource TextControlBackground}"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     BorderThickness="0" Padding="16"/>

                            <!-- Image Gallery Grid -->
                            <ScrollViewer x:Name="ImageGalleryViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.CanContentScroll="False"
                                          Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
                                          BorderThickness="0"
                                          Padding="14"
                                          Visibility="Collapsed">
                                <ListBox x:Name="ImageGalleryList"
                                         BorderThickness="0" Background="Transparent"
                                         MouseDoubleClick="OnImageGalleryDoubleClicked">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="8"
                                                    Width="210" Margin="6" Padding="8" Cursor="Hand">
                                                <StackPanel>
                                                    <Border Height="140" Background="{DynamicResource TextControlBackground}"
                                                            CornerRadius="6" Margin="0,0,0,6">
                                                        <Image Source="{Binding ThumbnailSource}" Stretch="Uniform"/>
                                                    </Border>
                                                    <ui:TextBlock Text="{Binding FileName}"
                                                                  FontSize="11.5" FontWeight="SemiBold"
                                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                  TextTrimming="CharacterEllipsis"/>
                                                    <ui:TextBlock Text="{Binding SubFolder}"
                                                                  FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                  TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Grid>

                        <!-- Subtle Inner Splitter -->
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                      Background="{DynamicResource CardStrokeColorDefaultBrush}" Focusable="False"/>

                        <!-- Right Inspector Sheet -->
                        <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                            <DockPanel Margin="12" LastChildFill="True">
                                <!-- Top Properties -->
                                <StackPanel DockPanel.Dock="Top">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="13" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <ui:TextBlock Text="TASK INSPECTOR" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Status & Priority Grid -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock Text="Status" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="InspectorStatusCmb" Height="32" Padding="8,2" VerticalContentAlignment="Center" FontSize="11" SelectionChanged="OnInspectorStatusChanged">
                                                <ComboBoxItem Content="backlog" VerticalContentAlignment="Center"/>
                                                <ComboBoxItem Content="in-progress" VerticalContentAlignment="Center"/>
                                                <ComboBoxItem Content="review" VerticalContentAlignment="Center"/>
                                                <ComboBoxItem Content="done" VerticalContentAlignment="Center"/>
                                                <ComboBoxItem Content="on-hold" VerticalContentAlignment="Center"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <ui:TextBlock Text="Priority" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="InspectorPriorityCmb" Height="32" Padding="8,2" VerticalContentAlignment="Center" FontSize="11" SelectionChanged="OnInspectorPriorityChanged">
                                                <ComboBoxItem Content="low" VerticalContentAlignment="Center"/>
                                                <ComboBoxItem Content="medium" VerticalContentAlignment="Center"/>
                                                <ComboBoxItem Content="high" VerticalContentAlignment="Center"/>
                                                <ComboBoxItem Content="urgent" VerticalContentAlignment="Center"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Revision & Review Actions -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <ui:TextBlock Text="Rev" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Appearance="Secondary" Width="28" Height="28" Padding="0" Click="OnInspectorRevDecClicked" Cursor="Hand" ToolTip="Decrement revision">
                                                    <ui:SymbolIcon Symbol="Subtract24" FontSize="10"/>
                                                </ui:Button>
                                                <ui:TextBlock x:Name="TxtInspectorRev" Text="0" FontWeight="Bold" FontSize="12" Width="24" TextAlignment="Center" VerticalAlignment="Center"/>
                                                <ui:Button Appearance="Secondary" Width="28" Height="28" Padding="0" Click="OnInspectorRevIncClicked" Cursor="Hand" ToolTip="Increment revision">
                                                    <ui:SymbolIcon Symbol="Add24" FontSize="10"/>
                                                </ui:Button>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:Button x:Name="BtnSignOff" Grid.Column="0" Appearance="Primary" Height="28" Padding="4,0" Click="OnSignOffClicked" Cursor="Hand" ToolTip="Sign-Off as Done">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="11" Margin="0,0,3,0"/>
                                                        <ui:TextBlock Text="Sign-Off" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ui:Button>
                                                <ui:Button x:Name="BtnRequestRevision" Grid.Column="2" Appearance="Secondary" Height="28" Padding="4,0" Click="OnRequestRevisionClicked" Cursor="Hand" ToolTip="Request Revision (+1 Rev)">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="11" Margin="0,0,3,0"/>
                                                        <ui:TextBlock Text="Revise" FontSize="10.5" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ui:Button>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,2,0,10"/>
                                </StackPanel>

                                <!-- Discussions Header -->
                                <Border DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Chat24" FontSize="13" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <ui:TextBlock Text="DISCUSSIONS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ui:TextBlock x:Name="TxtCommentCount" Grid.Column="1" Text="0 comments" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </Border>

                                <!-- Add Comment Input at Bottom of Inspector -->
                                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CommentInputBox" Height="30" FontSize="11.5" Padding="8,4"
                                                 Background="{DynamicResource TextControlBackground}"
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                 BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                 KeyDown="OnCommentInputKeyDown"/>
                                        <ui:Button x:Name="BtnPostComment" Grid.Column="1" Appearance="Primary" Margin="6,0,0,0" Height="30" Width="34" Padding="0"
                                                   Click="OnPostCommentClicked" Cursor="Hand" ToolTip="Post Comment">
                                            <ui:SymbolIcon Symbol="Send24" FontSize="12"/>
                                        </ui:Button>
                                    </Grid>
                                </Border>

                                <!-- Scrollable Comments Thread -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="CommentsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource FluentBrand80}" Margin="0,0,6,0">
                                                                    <ui:TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="8.5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ui:TextBlock Text="{Binding Author}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            </StackPanel>
                                                            <ui:TextBlock Grid.Column="1" Text="{Binding DisplayTimestamp}" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </Grid>
                                                        <ui:TextBlock Text="{Binding Content}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- 3. Action Footer -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="16,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Appearance="Secondary" Click="OnPreflightAuditClicked"
                                       Height="32" Padding="12,0" Cursor="Hand" Margin="0,0,8,0" ToolTip="Run Preflight quality audit (folders, brief, copywriting, deliverables)">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="13" Margin="0,0,5,0" Foreground="{DynamicResource FluentBrand80}"/>
                                    <ui:TextBlock Text="Preflight Audit" VerticalAlignment="Center" FontSize="11.5"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Appearance="Secondary" Click="OnAuditNamingClicked"
                                       Height="32" Padding="12,0" Cursor="Hand" Margin="0,0,8,0" ToolTip="Validate and standardize asset file names">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="CheckmarkStarburst24" FontSize="13" Margin="0,0,5,0"/>
                                    <ui:TextBlock Text="Audit Naming" VerticalAlignment="Center" FontSize="11.5"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Appearance="Secondary" Click="OnCopyPathClicked"
                                       Height="32" Padding="12,0" Cursor="Hand" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Copy24" FontSize="13" Margin="0,0,5,0"/>
                                    <ui:TextBlock Text="Copy Path" VerticalAlignment="Center" FontSize="11.5"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="BtnEditBrief" Appearance="Secondary" Click="OnEditBriefClicked"
                                       Height="32" Padding="12,0" Cursor="Hand" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Edit24" FontSize="13" Margin="0,0,5,0"/>
                                    <ui:TextBlock Text="Edit Brief" VerticalAlignment="Center" FontSize="11.5"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Appearance="Primary" Click="OnExportHandoverZipClicked"
                                       Height="32" Padding="14,0" FontWeight="Bold" Cursor="Hand" Margin="0,0,8,0" ToolTip="Export client-ready deliverables handover ZIP with HTML summary">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Archive24" FontSize="13" Margin="0,0,5,0"/>
                                    <ui:TextBlock Text="Export Handover (ZIP)" VerticalAlignment="Center" FontSize="11.5"/>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Appearance="Secondary" Click="OnCopyWholeFolderClicked"
                                       Height="32" Padding="12,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderZip24" FontSize="13" Margin="0,0,5,0"/>
                                    <ui:TextBlock Text="Copy Whole Project..." VerticalAlignment="Center" FontSize="11.5"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>

        <!-- ── Smooth Fluent 2 Loading Overlay (Indeterminate Ring & Feedback) ── -->
        <Border x:Name="LoadingOverlay" Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
                Opacity="0.88" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="44" Height="44"
                                 Foreground="{DynamicResource FluentBrand80}" Margin="0,0,0,16"/>
                <ui:TextBlock x:Name="TxtLoadingMessage" Text="Loading Projects &amp; Briefs..."
                              FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBlock Text="Scanning workspace catalog on Synology NAS"
                              FontSize="11.5" HorizontalAlignment="Center"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>



