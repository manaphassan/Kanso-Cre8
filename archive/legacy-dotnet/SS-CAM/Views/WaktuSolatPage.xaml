<Page x:Class="SS_CAM.Views.WaktuSolatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Waktu Solat &amp; Islamic Dashboard">

    <Grid>
        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" Padding="24" Background="Transparent" PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
            <StackPanel>

                <!-- ── HEADER BAR ─────────────────────────────────────────────── -->
                <ui:Card Padding="20,16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title & Dates -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="Clock24" FontSize="24" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ui:TextBlock Text="Waktu Solat &amp; Islamic Dashboard" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ui:TextBlock Text="Accurate prayer schedules, Qibla direction, daily Hadith inspiration, and Islamic calendar telemetry." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,2,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <ui:TextBlock x:Name="TxtGregorianDate" Text="..."
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBlock Text="  ·  " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBlock x:Name="TxtHijriDate" Text="..."
                                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Live Clock Pill -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,6" Margin="16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ui:TextBlock x:Name="TxtLiveClock" Text="00:00:00 AM" FontSize="18" FontWeight="Bold" FontFamily="Consolas, Segoe UI Mono, Segoe UI"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Zone selector + 12H/24H format toggle + reminder toggle -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBlock Text="Zon:" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ZoneCombo" Width="190" Height="34" FontSize="11.5"
                                      SelectionChanged="OnZoneChanged" Margin="0,0,8,0"/>

                            <!-- 12H / 24H Toggle Button (Icon-Only) -->
                            <ui:Button x:Name="BtnFormatToggle" Click="OnFormatToggle"
                                    Height="34" Width="34" Padding="0" Appearance="Secondary" Cursor="Hand" Margin="0,0,8,0"
                                    ToolTip="Format Masa: 12-Jam (Klik untuk 24-Jam)">
                                <ui:TextBlock x:Name="TxtFormatIcon" Text="&#xE815;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ui:Button>

                            <!-- Reminder Toggle Button (Icon-Only) -->
                            <ui:Button x:Name="BtnReminder" Click="OnReminderToggle"
                                    Height="34" Width="34" Padding="0" Appearance="Primary" Cursor="Hand"
                                    ToolTip="Peringatan Waktu Solat: ON">
                                <ui:TextBlock x:Name="ReminderIcon" Text="&#xEA8F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- ☀️ FULL WIDTH HERO BANNER: Sun Path & Day Phase Visualizer -->
                <ui:Card Padding="20,18" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock x:Name="TxtSunGlyph" Text="&#xE706;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ui:TextBlock Text="Laluan Matahari &amp; Fasa Hari" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                            <ui:TextBlock x:Name="TxtSunPhase" Grid.Column="1" Text="Subuh &amp; Terbit Matahari" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Canvas Arc Area Spanning Full Width -->
                        <Border Height="86" CornerRadius="8" Padding="14,8" ClipToBounds="True" x:Name="SunArcContainer">
                            <Border.Background>
                                <LinearGradientBrush x:Name="AtmosphereGradient" StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0284C7" Offset="0"/>
                                    <GradientStop Color="#38BDF8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Canvas x:Name="SunArcCanvas" Height="70" VerticalAlignment="Bottom">
                                <!-- Parabolic solar trajectory arc line -->
                                <Path x:Name="SunArcPath" Stroke="#80FFFFFF" StrokeThickness="2" StrokeDashArray="4 3"/>
                                <!-- Sun / Moon Indicator Orb -->
                                <Border x:Name="SunOrb" Width="24" Height="24" CornerRadius="12" Background="#FDE047"
                                        Effect="{DynamicResource FluentDepth8}">
                                    <ui:TextBlock x:Name="SunOrbGlyph" Text="&#xE706;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Canvas>
                        </Border>
                        <Grid Margin="0,6,0,0">
                            <ui:TextBlock x:Name="TxtSubuhLabel" Text="Subuh" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <ui:TextBlock x:Name="TxtZohorLabel" Text="Zohor" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            <ui:TextBlock x:Name="TxtIsyakLabel" Text="Isyak" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- ── 2-COLUMN RESPONSIVE MAIN DASHBOARD GRID ───────────────── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Left Column: Hero Countdown, Prayer Table -->
                        <ColumnDefinition Width="1.1*"/>
                        <!-- Gutter -->
                        <ColumnDefinition Width="16"/>
                        <!-- Right Column: Islamic Calendar, Events, Daily Hadith -->
                        <ColumnDefinition Width="1.0*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ————————————————— LEFT COLUMN ————————————————— -->
                    <StackPanel Grid.Column="0">

                        <!-- 🕌 Hero Card: Solat Seterusnya -->
                        <ui:Card Padding="24,20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Next Prayer Info -->
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock Text="SOLAT SETERUSNYA" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <ui:TextBlock Text="&#xE815;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26"
                                                   Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ui:TextBlock x:Name="TxtNextPrayer" Text="..." FontSize="30" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>

                                    <ui:TextBlock x:Name="TxtNextPrayerTime" Text="--:--" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>

                                    <!-- Progress Bar -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock x:Name="TxtCurrentLabel" Text="Memuatkan..." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:TextBlock x:Name="TxtProgressPct" Grid.Column="1" Text="" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}"/>
                                    </Grid>
                                    <Border Height="8" CornerRadius="4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" Height="6" CornerRadius="3" Margin="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#0078D4" Offset="0"/>
                                                    <GradientStop Color="#00CFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                </StackPanel>

                                <!-- Countdown & Alert Badge -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <ui:TextBlock Text="MASA BERBAKI" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <ui:TextBlock x:Name="TxtCountdown" Text="--:--:--" FontSize="38" FontWeight="Bold" FontFamily="Consolas, Segoe UI Mono"
                                               Foreground="{DynamicResource FluentBrand80}" HorizontalAlignment="Center"/>

                                    <Border x:Name="AdhanBadge" CornerRadius="12" Padding="12,4" Visibility="Collapsed" Margin="0,10,0,0" HorizontalAlignment="Center" Background="#22C55E">
                                        <ui:TextBlock x:Name="TxtAdhanBadge" Text="Waktu Solat!" FontSize="11.5" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <!-- 📊 Prayer Schedule List -->
                        <ui:Card Padding="0" Margin="0,0,0,16">
                            <StackPanel>
                                <Border Padding="18,12" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Text="JADUAL WAKTU SOLAT HARI INI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:TextBlock x:Name="TxtHeaderTimeFormatLabel" Text="WAKTU 12-JAM (AM/PM)" Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="PrayerListPanel"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>

                    <!-- ————————————————— RIGHT COLUMN ————————————————— -->
                    <StackPanel Grid.Column="2">

                        <!-- 📅 Islamic Calendar & Upcoming Hijri Events Card -->
                        <ui:Card Padding="18,16" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <ui:TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ui:TextBlock Text="Kalendar Hijrah &amp; Acara Kebangsaan" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>

                                <!-- Calendar Month Banner -->
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock Text="BULAN HIJRAH SEMASA" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <ui:TextBlock x:Name="TxtHijriMonthBanner" Text="Safar 1448 Hijrah" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:TextBlock Grid.Column="1" Text="&#x1F319;" FontSize="20" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <ui:TextBlock Text="HARI KEBANGSAAN &amp; ACARA ISLAM SEGERA" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                                
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="210">
                                    <StackPanel x:Name="IslamicEventsPanel"/>
                                </ScrollViewer>
                            </StackPanel>
                        </ui:Card>

                        <!-- 📖 Daily Hadith & Motivational Card -->
                        <ui:Card Padding="18,16" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="&#xE82D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ui:TextBlock Text="Hadis Hari Ini" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="10,3">
                                        <ui:TextBlock x:Name="TxtHadithTheme" Text="Niat &amp; Kerja" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource FluentBrand80}"/>
                                    </Border>
                                </Grid>

                                <!-- Hadith Box with Large Jawi / Arabic Typography -->
                                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <ui:TextBlock x:Name="TxtHadithTitle" Text="Niat &amp; Keikhlasan" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                                        
                                        <!-- LARGE JAWI / ARABIC TEXT CONTAINER -->
                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,12" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <ui:TextBlock x:Name="TxtHadithArabic" Text="..." FontSize="24" FontWeight="Bold"
                                                       FontFamily="Amiri, Scheherazade, Traditional Arabic, Arabic Typesetting, Microsoft Uighur, Arial, Segoe UI"
                                                       Foreground="{DynamicResource FluentBrand80}" TextAlignment="Right" LineHeight="42" TextWrapping="Wrap"/>
                                        </Border>

                                        <ui:TextBlock x:Name="TxtHadithMalay" Text="..." FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" LineHeight="20"/>
                                        <ui:TextBlock x:Name="TxtHadithSource" Text="Sahih al-Bukhari #1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Hadith Actions -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Salin Hadis with Copy Icon -->
                                    <ui:Button Appearance="Secondary" Click="OnCopyHadithClicked" Height="34" Cursor="Hand" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <ui:TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ui:TextBlock Text="Salin Hadis" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>

                                    <!-- Hadis Lain with Refresh Icon -->
                                    <ui:Button Grid.Column="2" Appearance="Primary" Click="OnNextHadithClicked" Height="34" Padding="14,0" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ui:TextBlock Text="Hadis Lain" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:Button>
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </Grid>

                <!-- Footer attribution -->
                <ui:TextBlock Text="Waktu solat disediakan oleh JAKIM melalui api.waktusolat.app · SuamiSihat Digital Ecosystem"
                           FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,12,0,24"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>



