<Page x:Class="SS_CAM.Views.WorkstationHealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Workstation Health &amp; Software Diagnostics">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" Padding="24" Background="Transparent" PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
        <StackPanel HorizontalAlignment="Stretch">
            <!-- Fluent 2 Page Header with Action Button -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="24" Foreground="{DynamicResource FluentBrand80}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ui:TextBlock Text="Workstation &amp; Software Health Diagnostics" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ui:TextBlock Text="Hardware telemetry, GPU OpenCL rendering status, storage performance, and Creative Suite installation integrity." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>
                <ui:Button Grid.Column="1" Appearance="Primary" Click="OnRescanSoftwareClicked" Width="36" Height="36" Padding="0" Cursor="Hand" ToolTip="Rescan Workstation &amp; Creative Suite Software" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ArrowSync24"/>
                </ui:Button>
            </Grid>

            <!-- Hero KPI Summary Grid (4 Metric Cards) -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Metric 1: System Readiness -->
                <ui:Card Grid.Column="0" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0"/>
                            <ui:TextBlock Text="SYSTEM STATUS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ui:TextBlock Text="Workstation Ready" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="All core subsystems active" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Metric 2: GPU Acceleration -->
                <ui:Card Grid.Column="2" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                            <ui:TextBlock Text="GPU ACCELERATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ui:TextBlock x:Name="MetricGpuName" Text="DirectX 12 Ready" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <ui:TextBlock Text="Hardware rendering active" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Metric 3: Scratch Storage Health -->
                <ui:Card Grid.Column="4" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="HardDrive24" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                            <ui:TextBlock Text="SCRATCH STORAGE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ui:TextBlock x:Name="MetricStorageText" Text="Drive C: Free Space" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <ui:TextBlock x:Name="MetricStorageSubtext" Text="Used Storage Breakdown" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="StorageProgressBar" Value="75" IsIndeterminate="False" Margin="0,6,0,0" Height="4"/>
                    </StackPanel>
                </ui:Card>

                <!-- Metric 4: Software Coverage -->
                <ui:Card Grid.Column="6" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Apps24" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                            <ui:TextBlock Text="SUITE COVERAGE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ui:TextBlock x:Name="MetricSoftwareCoverage" Text="Scanning..." FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="Creative tools detected" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- Main Content Area: 2 Columns -->
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Workstation Hardware Specs -->
                <ui:Card Grid.Column="0" Padding="16" VerticalAlignment="Top">
                    <StackPanel>
                        <ui:TextBlock Text="Hardware Specifications" FontTypography="BodyStrong" Margin="0,0,4,4"/>
                        <ui:TextBlock Text="Hardware capabilities for GPU rendering, OpenCL acceleration &amp; exports." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <!-- OS -->
                        <ui:Card Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Laptop24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock Text="OPERATING SYSTEM" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="9.5" FontWeight="Bold"/>
                                    <ui:TextBlock x:Name="SpecOS" Text="Windows 11 (64-bit)" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <!-- CPU -->
                        <ui:Card Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock Text="PROCESSOR (CPU)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="9.5" FontWeight="Bold"/>
                                    <ui:TextBlock x:Name="SpecCPU" Text="AMD Ryzen / Intel Core" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <!-- MOTHERBOARD MODEL -->
                        <ui:Card Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock Text="MOTHERBOARD MODEL" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="9.5" FontWeight="Bold"/>
                                    <ui:TextBlock x:Name="SpecMotherboard" Text="BaseBoard System Board" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <!-- RAM -->
                        <ui:Card Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Database24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock Text="SYSTEM MEMORY (RAM)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="9.5" FontWeight="Bold"/>
                                    <ui:TextBlock x:Name="SpecRAM" Text="16 GB RAM" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <!-- GPU -->
                        <ui:Card Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock Text="GRAPHICS ADAPTER (GPU MODEL)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="9.5" FontWeight="Bold"/>
                                    <ui:TextBlock x:Name="SpecGPU" Text="NVIDIA / AMD Graphics" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <!-- DISPLAY -->
                        <ui:Card Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock Text="PRIMARY DISPLAY" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="9.5" FontWeight="Bold"/>
                                    <ui:TextBlock x:Name="SpecDisplay" Text="1920 x 1080" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <!-- STORAGE -->
                        <ui:Card Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="HardDrive24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock Text="SCRATCH STORAGE (FREE / USED)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="9.5" FontWeight="Bold"/>
                                    <ui:TextBlock x:Name="SpecStorage" Text="Drive C: 84.9 GB free" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </StackPanel>
                </ui:Card>

                <!-- Right Column: Standardized Software Suite Health Table -->
                <ui:Card Grid.Column="2" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Stretch">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <ui:TextBlock Text="Design Suite Software Scanner" FontTypography="BodyStrong"/>
                                <ui:TextBlock Text="Installed Creative Workstation Suite Apps &amp; Health Diagnostics" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ui:TextBox x:Name="SoftwareSearchBox" Grid.Column="1" PlaceholderText="Search software..." Icon="Search24" Width="200" TextChanged="OnSoftwareSearchTextChanged" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Table Header Card -->
                        <ui:Card Padding="14,10" Margin="0,0,0,8" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Text="SOFTWARE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBlock Grid.Column="1" Text="FILE EXTENSION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBlock Grid.Column="2" Text="APP VERSION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBlock Grid.Column="3" Text="INSTALL STATUS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBlock Grid.Column="4" Text="ACTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </ui:Card>

                        <!-- Items List -->
                        <ItemsControl x:Name="SoftwareHealthList" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Padding="14,10" Margin="0,0,0,6" HorizontalAlignment="Stretch">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- App Name & Icon -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <ui:TextBlock Text="{Binding Icon}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <ui:TextBlock Text="{Binding SoftwareName}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <ui:TextBlock Text="Design Application" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- File Extension Badge -->
                                            <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                                <ui:TextBlock Text="{Binding FileExtension}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- App Version -->
                                            <ui:TextBlock Grid.Column="2" Text="{Binding ScannedVersion}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <!-- Install Status Badge (Color-Contrasted) -->
                                            <Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="10" Padding="8,3" Background="{Binding StatusColor}">
                                                <ui:TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Action Buttons Column -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Get App (Visible if NOT installed) -->
                                                <ui:Button Click="OnDownloadSoftwareClicked" Tag="{Binding DownloadUrl}" Appearance="Secondary" Width="30" Height="30" Padding="0" ToolTip="Download Software Package" Visibility="{Binding ShowActionButton, Converter={StaticResource BoolToVisConverter}}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <ui:SymbolIcon Symbol="ArrowDownload24"/>
                                                </ui:Button>

                                                <!-- Uninstall (Visible if INSTALLED) -->
                                                <ui:Button Click="OnUninstallSoftwareClicked" Tag="{Binding SoftwareName}" Appearance="Secondary" Width="30" Height="30" Padding="0" ToolTip="Uninstall Software" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisConverter}}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Delete24"/>
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
