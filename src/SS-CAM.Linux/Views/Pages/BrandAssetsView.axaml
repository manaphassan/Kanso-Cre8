<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS_CAM.Linux.ViewModels"
             x:Class="SS_CAM.Linux.Views.Pages.BrandAssetsView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer Padding="28,24">
        <StackPanel Spacing="24">
            <!-- Page Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Brand Assets Vault" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Official corporate color palettes, typography, and identity tokens." FontSize="13" Foreground="#94A3B8"/>
            </StackPanel>

            <!-- Color Swatches -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Corporate Holding Brand Identity Tokens (60:30:10)" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Official color palettes for SuamiSihat Holding subsidiaries." FontSize="13" Foreground="#94A3B8"/>
                    <Grid ColumnDefinitions="*, *, *, *, *" Margin="0,10,0,0">
                        <Border Grid.Column="0" Background="#022057" CornerRadius="8" Padding="16" Margin="0,0,6,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="SSH Navy" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="#022057" Foreground="#93C5FD" FontSize="12"/>
                                <TextBlock Text="RGB: 2, 32, 87" Foreground="#60A5FA" FontSize="11"/>
                                <TextBlock Text="Pantone: 288 C" Foreground="#BFDBFE" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#21A1F7" CornerRadius="8" Padding="16" Margin="6,0,6,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="SS Azure" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="#21A1F7" Foreground="#EFF6FF" FontSize="12"/>
                                <TextBlock Text="RGB: 33, 161, 247" Foreground="#DBEAFE" FontSize="11"/>
                                <TextBlock Text="Pantone: 2925 C" Foreground="#EFF6FF" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#BD9A73" CornerRadius="8" Padding="16" Margin="6,0,6,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Warm Gold" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="#BD9A73" Foreground="#FEF3C7" FontSize="12"/>
                                <TextBlock Text="RGB: 189, 154, 115" Foreground="#FDE68A" FontSize="11"/>
                                <TextBlock Text="Pantone: 465 C" Foreground="#FEF3C7" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#107C10" CornerRadius="8" Padding="16" Margin="6,0,6,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Care Emerald" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="#107C10" Foreground="#D1FAE5" FontSize="12"/>
                                <TextBlock Text="RGB: 16, 124, 16" Foreground="#A7F3D0" FontSize="11"/>
                                <TextBlock Text="Pantone: 348 C" Foreground="#D1FAE5" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="#8B5CF6" CornerRadius="8" Padding="16" Margin="6,0,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Tech Violet" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="#8B5CF6" Foreground="#EDE9FE" FontSize="12"/>
                                <TextBlock Text="RGB: 139, 92, 246" Foreground="#DDD6FE" FontSize="11"/>
                                <TextBlock Text="Pantone: 2665 C" Foreground="#EDE9FE" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Typography -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Typography Scale" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="120, *, Auto">
                            <TextBlock Text="Display" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="SuamiSihat Creative Studio" FontSize="28" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock Grid.Column="2" Text="28px Bold" Foreground="#475569" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="#1E293B"/>
                        <Grid ColumnDefinitions="120, *, Auto">
                            <TextBlock Text="Heading 1" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Campaign Title Goes Here" FontSize="22" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            <TextBlock Grid.Column="2" Text="22px SemiBold" Foreground="#475569" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="#1E293B"/>
                        <Grid ColumnDefinitions="120, *, Auto">
                            <TextBlock Text="Body" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Standard body text for copy and captions." FontSize="14" Foreground="#CBD5E1"/>
                            <TextBlock Grid.Column="2" Text="14px Regular" Foreground="#475569" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="#1E293B"/>
                        <Grid ColumnDefinitions="120, *, Auto">
                            <TextBlock Text="Caption" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Fine print, disclaimers and metadata." FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Grid.Column="2" Text="11px Regular" Foreground="#475569" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Brand Subsidiaries -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="SuamiSihat Holding Subsidiaries" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <Grid ColumnDefinitions="*, *, *, *, *">
                        <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="SSH" FontSize="20" FontWeight="Bold" Foreground="#21A1F7" HorizontalAlignment="Center"/>
                                <TextBlock Text="SuamiSihat Holding" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="14" Margin="6,0,6,0">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="SSC" FontSize="20" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                                <TextBlock Text="SuamiSihat Commerce" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="14" Margin="6,0,6,0">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="SSW" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                <TextBlock Text="SuamiSihat Wellness" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#1E293B" CornerRadius="8" Padding="14" Margin="6,0,6,0">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="SSE" FontSize="20" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Center"/>
                                <TextBlock Text="SuamiSihat Education" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="#1E293B" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="SST" FontSize="20" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center"/>
                                <TextBlock Text="SuamiSihat Tech" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
