<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS_CAM.Linux.ViewModels"
             x:Class="SS_CAM.Linux.Views.Pages.BrandAssetsView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer Padding="28,24">
        <StackPanel Spacing="20">
            <!-- 1. Header with Badge -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🎨" FontSize="24" VerticalAlignment="Center"/>
                        <TextBlock Text="Brand Assets &amp; Identity Vault" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Authoritative SuamiSihat™ color palettes, multi-format design tokens, sub-brand vector marks, and typography hierarchy." Foreground="#94A3B8" FontSize="13"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🛡️" FontSize="13"/>
                        <TextBlock Text="Brand System v3.5.1 (SSoT)" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. Copy Notification Alert Banner -->
            <Border Background="#022057" BorderBrush="#21A1F7" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <Grid ColumnDefinitions="Auto, *">
                    <TextBlock Grid.Column="0" Text="✨" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding CopyNotificationText}" Foreground="#BAE6FD" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 3. Primary Official Palette Grid (Click-to-Copy) -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🎨" FontSize="14" Foreground="#38BDF8"/>
                        <TextBlock Text="Primary Official Palette (Click any swatch to copy HEX &amp; inspect tokens)" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding PrimaryPalette}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid ColumnDefinitions="*, *, *, *, *, *, *"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).InspectAndCopyTokenCommand}" CommandParameter="{Binding}"
                                        Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="6">
                                        <Border Height="44" Background="{Binding BackgroundBrush}" CornerRadius="6"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Hex}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <TextBlock Text="{Binding Pantone}" FontSize="9.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 4. Multi-Format Token Inspector Panel -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🔬" FontSize="14" Foreground="#38BDF8"/>
                        <TextBlock Text="Multi-Format Design Token Inspector" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                    </StackPanel>

                    <!-- Inspector Card -->
                    <Border Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid ColumnDefinitions="Auto, 20, *">
                            <!-- Left: Large Color Block -->
                            <Border Grid.Column="0" Width="100" Height="100" Background="{Binding InspectedColorToken.BackgroundBrush, FallbackValue='#022057'}" CornerRadius="8">
                                <TextBlock Text="{Binding InspectedColorToken.Hex, FallbackValue='#022057'}" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Right: Token Rows -->
                            <Grid Grid.Column="2" ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto">
                                <!-- HEX -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#1E293B" CornerRadius="6" Padding="10" Margin="3">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="HEX CODE" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding InspectedColorToken.Hex, FallbackValue='#022057'}" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </StackPanel>
                                </Border>
                                <!-- RGB -->
                                <Border Grid.Row="0" Grid.Column="1" Background="#1E293B" CornerRadius="6" Padding="10" Margin="3">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="RGB VALUE" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding InspectedColorToken.Rgb, FallbackValue='2, 32, 87'}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    </StackPanel>
                                </Border>
                                <!-- CMYK -->
                                <Border Grid.Row="0" Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="10" Margin="3">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="CMYK (PRINT)" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding InspectedColorToken.Cmyk, FallbackValue='98, 63, 0, 66'}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    </StackPanel>
                                </Border>

                                <!-- PANTONE -->
                                <Border Grid.Row="1" Grid.Column="0" Background="#1E293B" CornerRadius="6" Padding="10" Margin="3">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="PANTONE®" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding InspectedColorToken.Pantone, FallbackValue='Pantone 281 C'}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B"/>
                                    </StackPanel>
                                </Border>
                                <!-- RAL -->
                                <Border Grid.Row="1" Grid.Column="1" Background="#1E293B" CornerRadius="6" Padding="10" Margin="3">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="RAL CLASSIC" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding InspectedColorToken.Ral, FallbackValue='RAL 5013'}" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    </StackPanel>
                                </Border>
                                <!-- CSS TOKEN -->
                                <Border Grid.Row="1" Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="10" Margin="3">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="CSS VARIABLE" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding InspectedColorToken.CssToken, FallbackValue='--ss-prussian-blue'}" FontSize="12" FontFamily="Consolas" FontWeight="Bold" Foreground="#8B5CF6"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 5. Sub-Brand Subsidiaries Grid -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🏢" FontSize="14" Foreground="#38BDF8"/>
                        <TextBlock Text="SuamiSihat Holding Subsidiaries &amp; Brand Systems" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding SubBrandPalettes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto, 16, *, Auto">
                                        <!-- Brand Swatch -->
                                        <Border Grid.Column="0" Width="40" Height="40" Background="{Binding PrimaryColorHex}" CornerRadius="6" BorderBrush="{Binding AccentColorHex}" BorderThickness="2">
                                            <TextBlock Text="{Binding BrandCode}" FontWeight="Bold" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Brand Info -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding BrandName}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="13"/>
                                            <TextBlock Text="{Binding Tagline}" Foreground="#94A3B8" FontSize="11"/>
                                        </StackPanel>
                                        <!-- Colors -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Background="{Binding PrimaryColorHex}" CornerRadius="4" Padding="8,4">
                                                <TextBlock Text="{Binding PrimaryColorHex}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <Border Background="{Binding AccentColorHex}" CornerRadius="4" Padding="8,4">
                                                <TextBlock Text="{Binding AccentColorHex}" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
