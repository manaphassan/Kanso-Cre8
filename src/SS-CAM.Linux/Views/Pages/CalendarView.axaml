<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS_CAM.Linux.ViewModels"
             xmlns:models="using:SS_CAM.Linux.Models"
             x:Class="SS_CAM.Linux.Views.Pages.CalendarView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer Padding="28,24">
        <StackPanel Spacing="20">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Visual Project Timeline &amp; Calendar" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Monthly project schedule, visual timeline charts, and deliverable deadlines."
                           FontSize="13" Foreground="#94A3B8"/>
            </StackPanel>

            <!-- KPI Row -->
            <Grid ColumnDefinitions="*,12,*,12,*,12,*">
                <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="DEADLINES THIS MONTH" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding DeadlinesThisMonth}" FontSize="28" FontWeight="Bold" Foreground="#F59E0B"/>
                        <TextBlock Text="Scheduled deliverables" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="STARTED THIS MONTH" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding StartedThisMonth}" FontSize="28" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock Text="New projects kicked off" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="OVERDUE / CRITICAL" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding OverdueCount}" FontSize="28" FontWeight="Bold" Foreground="#EF4444"/>
                        <TextBlock Text="Past deadline, unresolved" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="COMPLETED THIS MONTH" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding DoneCount}" FontSize="28" FontWeight="Bold" Foreground="#10B981"/>
                        <TextBlock Text="Archived deliverables" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Calendar Grid -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="12">
                    <!-- Month nav -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Content="◀" Command="{Binding PrevMonthCommand}"
                                Background="#1E293B" Foreground="#94A3B8" CornerRadius="6" Padding="12,6"/>
                        <TextBlock Grid.Column="1" Text="{Binding CalendarMonthLabel}"
                                   FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="▶" Command="{Binding NextMonthCommand}"
                                Background="#1E293B" Foreground="#94A3B8" CornerRadius="6" Padding="12,6"/>
                    </Grid>

                    <!-- Day headers -->
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                        <TextBlock Grid.Column="0" Text="SUN" FontSize="10" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="MON" FontSize="10" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="TUE" FontSize="10" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="WED" FontSize="10" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="THU" FontSize="10" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="FRI" FontSize="10" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="SAT" FontSize="10" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                    </Grid>

                    <!-- Calendar days (ItemsControl renders 6 rows of 7 days) -->
                    <ItemsControl ItemsSource="{Binding CalendarWeeks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:CalendarWeekRow">
                                <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,0,0,4">
                                    <Border Grid.Column="0" Background="{Binding Day0.CellBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Day0.DayNumber}" FontSize="12" FontWeight="{Binding Day0.DayFontWeight}"
                                                       Foreground="{Binding Day0.DayFg}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Day0.Badge}" FontSize="9" Foreground="#F59E0B" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{Binding Day1.CellBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Day1.DayNumber}" FontSize="12" FontWeight="{Binding Day1.DayFontWeight}"
                                                       Foreground="{Binding Day1.DayFg}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Day1.Badge}" FontSize="9" Foreground="#F59E0B" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{Binding Day2.CellBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Day2.DayNumber}" FontSize="12" FontWeight="{Binding Day2.DayFontWeight}"
                                                       Foreground="{Binding Day2.DayFg}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Day2.Badge}" FontSize="9" Foreground="#F59E0B" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Background="{Binding Day3.CellBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Day3.DayNumber}" FontSize="12" FontWeight="{Binding Day3.DayFontWeight}"
                                                       Foreground="{Binding Day3.DayFg}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Day3.Badge}" FontSize="9" Foreground="#F59E0B" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Background="{Binding Day4.CellBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Day4.DayNumber}" FontSize="12" FontWeight="{Binding Day4.DayFontWeight}"
                                                       Foreground="{Binding Day4.DayFg}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Day4.Badge}" FontSize="9" Foreground="#F59E0B" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="5" Background="{Binding Day5.CellBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Day5.DayNumber}" FontSize="12" FontWeight="{Binding Day5.DayFontWeight}"
                                                       Foreground="{Binding Day5.DayFg}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Day5.Badge}" FontSize="9" Foreground="#F59E0B" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="6" Background="{Binding Day6.CellBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Day6.DayNumber}" FontSize="12" FontWeight="{Binding Day6.DayFontWeight}"
                                                       Foreground="{Binding Day6.DayFg}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Day6.Badge}" FontSize="9" Foreground="#F59E0B" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Gantt Timeline -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Project Timeline (Gantt)" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <ItemsControl ItemsSource="{Binding InProgressProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:ProjectStatusItem">
                                <Grid ColumnDefinitions="200,*" Margin="0,0,0,8">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Project}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Deadline}" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Height="22" Margin="8,0,0,0">
                                        <Border Background="{Binding StatusBadgeColor}" CornerRadius="4"
                                                HorizontalAlignment="Left" Width="120"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
