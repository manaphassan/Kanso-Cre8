<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS_CAM.Linux.ViewModels"
             x:Class="SS_CAM.Linux.Views.Pages.FocusRadioView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer Padding="28,24">
        <StackPanel Spacing="24">
            <!-- 1. Header Bar -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="📻" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="Studio Focus Radio Player" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Live Malaysian radio streaming, Lo-Fi beats, and ambient soundscapes powered by mpv audio engine." Foreground="#94A3B8" FontSize="13"/>
            </StackPanel>

            <!-- 2. Currently Playing Banner -->
            <Border Background="#022057" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid ColumnDefinitions="Auto, 20, *, Auto">
                    <!-- Cassette Icon -->
                    <Border Grid.Column="0" Width="64" Height="64" Background="#043388" CornerRadius="10" BorderBrush="#21A1F7" BorderThickness="1">
                        <TextBlock Text="🎵" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Station Info -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="NOW STREAMING" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock Text="{Binding CurrentStationName}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Live high-fidelity stream for creative flow" FontSize="12" Foreground="#93C5FD"/>
                    </StackPanel>

                    <!-- Action Toggle -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleRadioCommand}"
                                Background="#21A1F7" Foreground="#022057" CornerRadius="8" Padding="18,10" FontWeight="Bold">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding RadioPlayIcon}" FontSize="14"/>
                                <TextBlock Text="Toggle Playback" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Available Radio Stations Grid -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Available Curated Live Stations" FontSize="14" FontWeight="Bold" Foreground="#94A3B8"/>
                    <ItemsControl ItemsSource="{Binding RadioStations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto, 16, *, Auto">
                                        <!-- Station Icon -->
                                        <Border Grid.Column="0" Width="38" Height="38" Background="#043388" CornerRadius="6">
                                            <TextBlock Text="📻" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Name & Genre -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="13"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Genre}" Foreground="#38BDF8" FontSize="11"/>
                                                <TextBlock Text="•" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Bitrate}" Foreground="#64748B" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Play Button -->
                                        <Button Grid.Column="3" Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PlayStationCommand}" CommandParameter="{Binding}"
                                                Background="#043388" Foreground="White" BorderBrush="#21A1F7" BorderThickness="1" CornerRadius="6" Padding="14,8" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="▶" FontSize="11"/>
                                                <TextBlock Text="Stream Station" FontSize="11.5" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
