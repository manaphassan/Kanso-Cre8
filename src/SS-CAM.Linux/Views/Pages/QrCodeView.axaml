<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS_CAM.Linux.ViewModels"
             x:Class="SS_CAM.Linux.Views.Pages.QrCodeView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer Padding="28,24">
        <StackPanel Spacing="24">
            <!-- Header -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="⬛" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="QR Code Generator Studio" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Generate high-resolution vector QR codes for product packaging, campaign URLs, and WhatsApp broadcast links." Foreground="#94A3B8" FontSize="13"/>
            </StackPanel>

            <Grid ColumnDefinitions="1.2*, 24, *">
                <!-- Left: Form -->
                <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Target URL / Text Content" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding QrText}" PlaceholderText="https://suamisihat.com.my" Height="38"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*, 12, *">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Foreground Color (HEX)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBox Text="{Binding QrFgColor}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock Text="Background Color (HEX)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBox Text="{Binding QrBgColor}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding QrPixelsPerModule, StringFormat='Resolution Scale: {0}x'}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                            <Slider Value="{Binding QrPixelsPerModule}" Minimum="5" Maximum="30"/>
                        </StackPanel>

                        <Button Command="{Binding GenerateQrCommand}" Background="#043388" Foreground="White" BorderBrush="#21A1F7" BorderThickness="1" CornerRadius="8" Padding="16,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="⚡" FontSize="14"/>
                                <TextBlock Text="Generate QR Code" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right: Preview -->
                <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="24" HorizontalAlignment="Center">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <TextBlock Text="Live Preview" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <Border Background="White" Padding="16" CornerRadius="8" HorizontalAlignment="Center">
                            <Image Source="{Binding QrBitmap}" Width="220" Height="220"/>
                        </Border>
                        <TextBlock Text="{Binding QrStatusText}" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
