<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS_CAM.Linux.ViewModels"
             xmlns:models="using:SS_CAM.Linux.Models"
             x:Class="SS_CAM.Linux.Views.Pages.QuickNoteView"
             x:DataType="vm:MainViewModel">
    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="28,24,28,16" Spacing="4">
            <TextBlock Text="Quick Notes &amp; Markdown Scratchpad" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock Text="Capture creative briefs, meeting notes, client feedback, and design ideas."
                       FontSize="13" Foreground="#94A3B8"/>
        </StackPanel>

        <!-- Body: 2-panel layout -->
        <Grid Grid.Row="1" Margin="28,0,28,24" ColumnDefinitions="260,16,*">

            <!-- Left: Notes List Sidebar -->
            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10">
                <Grid RowDefinitions="Auto,Auto,*">

                    <!-- New note button -->
                    <Border Grid.Row="0" Padding="14,14,14,10">
                        <Button Content="+ New Note" Command="{Binding NewNoteCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="#1E4D7B" Foreground="#38BDF8" CornerRadius="7" Padding="0,10"
                                FontWeight="SemiBold"/>
                    </Border>

                    <!-- Note count -->
                    <Border Grid.Row="1" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="0,1,0,1" Padding="14,7">
                        <TextBlock Text="{Binding NoteCountLabel}" FontSize="11" Foreground="#64748B"/>
                    </Border>

                    <!-- Notes list -->
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding NoteItems}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:QuickNoteItem">
                                    <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectNoteCommand}"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Background="Transparent" Padding="10,10" CornerRadius="7" Margin="0,0,0,4">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Modified}" FontSize="10" Foreground="#475569"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right: Editor panel -->
            <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10">
                <Grid RowDefinitions="Auto,Auto,*,Auto">

                    <!-- Title bar -->
                    <Border Grid.Row="0" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="0,0,0,1"
                            CornerRadius="10,10,0,0" Padding="20,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding SelectedNoteTitle}"
                                     Background="Transparent" BorderBrush="Transparent"
                                     Foreground="#F8FAFC" FontSize="16" FontWeight="Bold"
                                     PlaceholderText="Note title..."/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="💾 Save" Command="{Binding SaveNoteCommand}"
                                        Background="#064E3B" Foreground="#34D399" CornerRadius="6" Padding="12,6"
                                        FontWeight="SemiBold" FontSize="12"/>
                                <Button Content="🗑 Delete" Command="{Binding DeleteNoteCommand}"
                                        Background="#4C0519" Foreground="#F87171" CornerRadius="6" Padding="12,6"
                                        FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Toolbar: formatting hints (labels only — no WPF RichTextBox) -->
                    <Border Grid.Row="1" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,7">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Markdown:" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBlock Text="**bold**" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="_italic_" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="# heading" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="- list" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="[ ] task" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <!-- Editor -->
                    <TextBox Grid.Row="2"
                             Text="{Binding SelectedNoteContent}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Background="Transparent" BorderBrush="Transparent"
                             Foreground="#CBD5E1" FontFamily="Courier New, Consolas, monospace" FontSize="13"
                             Padding="20,16"
                             PlaceholderText="Start writing your note... (Markdown supported)"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                    <!-- Footer: word count + autosave status -->
                    <Border Grid.Row="3" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,10,10" Padding="20,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding NoteWordCount}" FontSize="11" Foreground="#475569"/>
                            <TextBlock Grid.Column="1" Text="{Binding NoteSaveStatus}" FontSize="11" Foreground="#34D399"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
