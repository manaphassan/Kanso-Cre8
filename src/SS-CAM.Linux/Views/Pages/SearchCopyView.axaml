<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS_CAM.Linux.ViewModels"
             xmlns:models="using:SS_CAM.Linux.Models"
             x:Class="SS_CAM.Linux.Views.Pages.SearchCopyView"
             x:DataType="vm:MainViewModel">
    <Grid RowDefinitions="Auto,*">

        <!-- ── HEADER ── -->
        <StackPanel Grid.Row="0" Margin="28,24,28,0" Spacing="4">
            <TextBlock Text="Project Workspace Catalog" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock Text="Browse your workspace — select a project to inspect its brief, assets, and task telemetry."
                       FontSize="13" Foreground="#94A3B8"/>
        </StackPanel>

        <!-- ── MAIN BODY ── -->
        <Grid Grid.Row="1" Margin="28,16,28,24" RowDefinitions="Auto,Auto,*">

            <!-- Search + Filter Bar -->
            <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                <Grid ColumnDefinitions="*, 12, 200, 8, 180, 8, Auto">
                    <TextBox Grid.Column="0" Text="{Binding SearchQuery}" PlaceholderText="Search project title, Project ID..."
                             Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="6" Padding="12,8"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableDesigners}" SelectedItem="{Binding FilterDesigner}"
                              Background="#1E293B" Foreground="#F8FAFC" HorizontalAlignment="Stretch"/>
                    <ComboBox Grid.Column="4" ItemsSource="{Binding AvailableBrands}" SelectedItem="{Binding FilterBrand}"
                              Background="#1E293B" Foreground="#F8FAFC" HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="6" Content="🔄 Refresh" Command="{Binding LoadProjectsCommand}"
                            Background="#1E293B" Foreground="#F8FAFC" CornerRadius="6" Padding="14,8"/>
                </Grid>
            </Border>

            <!-- Project Tray (horizontal scroll) -->
            <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                <StackPanel Spacing="6">
                    <TextBlock Text="RECENT PROJECTS" FontSize="10" FontWeight="Bold" Foreground="#475569"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FilteredProjects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:ProjectStatusItem">
                                    <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectProjectCommand}"
                                            CommandParameter="{Binding}"
                                            Background="#1E293B" CornerRadius="8" Padding="12,10" MinWidth="160" MaxWidth="200">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Project}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Background="{Binding StatusBadgeColor}" CornerRadius="3" Padding="6,2">
                                                    <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </Border>
                                                <TextBlock Text="{Binding Designer}" FontSize="10" Foreground="#64748B"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Selected Project Detail Panel -->
            <Grid Grid.Row="2" ColumnDefinitions="*, 16, 340">

                <!-- Left: Project List -->
                <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="0,0,0,1"
                                CornerRadius="10,10,0,0" Padding="16,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="ALL PROJECTS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <Border Background="#1E293B" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="{Binding ProjectCount}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding FilteredProjects}" Margin="8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:ProjectStatusItem">
                                        <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectProjectCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Background="Transparent" Padding="12,10" CornerRadius="6" Margin="0,0,0,4">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Grid.Column="0" Background="{Binding StatusBadgeColor}" Width="3" CornerRadius="2" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Project}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Designer}" FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Priority}" FontSize="10" Foreground="#475569"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Right: Detail Inspector -->
                <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="PROJECT INSPECTOR" FontSize="10" FontWeight="Bold" Foreground="#475569"/>

                        <!-- Project identity -->
                        <StackPanel Spacing="4" IsVisible="{Binding SelectedProject, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding SelectedProject.Project}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedProject.Client}" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>

                        <!-- Metadata table -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="14"
                                IsVisible="{Binding SelectedProject, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="100,*">
                                    <TextBlock Text="Designer" Foreground="#64748B" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedProject.Designer}" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid ColumnDefinitions="100,*">
                                    <TextBlock Text="Status" Foreground="#64748B" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedProject.Status}" Foreground="{Binding SelectedProject.StatusBadgeColor}" FontSize="11" FontWeight="Bold"/>
                                </Grid>
                                <Grid ColumnDefinitions="100,*">
                                    <TextBlock Text="Priority" Foreground="#64748B" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedProject.Priority}" Foreground="{Binding SelectedProject.PriorityBadgeColor}" FontSize="11" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid ColumnDefinitions="100,*">
                                    <TextBlock Text="Deadline" Foreground="#64748B" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedProject.Deadline}" Foreground="#CBD5E1" FontSize="11"/>
                                </Grid>
                                <Grid ColumnDefinitions="100,*">
                                    <TextBlock Text="Revision" Foreground="#64748B" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedProject.Revision}" Foreground="#CBD5E1" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Action buttons -->
                        <StackPanel Spacing="8" IsVisible="{Binding SelectedProject, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Button Content="📁 Open Project Folder" HorizontalAlignment="Stretch"
                                    Command="{Binding OpenFolderCommand}"
                                    CommandParameter="{Binding SelectedProject.FullPath}"
                                    Background="#1E293B" Foreground="#38BDF8" CornerRadius="6" Padding="14,10"/>
                            <Button Content="✍️ Edit Copywriting" HorizontalAlignment="Stretch"
                                    Command="{Binding OpenCopyEditorCommand}"
                                    CommandParameter="{Binding SelectedProject}"
                                    Background="#064E3B" Foreground="#34D399" CornerRadius="6" Padding="14,10"/>
                            <Button Content="➡️ Move to Next Stage" HorizontalAlignment="Stretch"
                                    Command="{Binding MoveStatusCommand}"
                                    CommandParameter="{Binding SelectedProject}"
                                    Background="#022057" Foreground="#60A5FA" CornerRadius="6" Padding="14,10"/>
                        </StackPanel>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                    IsVisible="{Binding SelectedProject, Converter={x:Static ObjectConverters.IsNull}}">
                            <TextBlock Text="📋" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="Select a project" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock Text="from the tray or list" FontSize="12" Foreground="#475569" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
