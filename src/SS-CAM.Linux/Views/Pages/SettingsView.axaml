<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS_CAM.Linux.ViewModels"
             x:Class="SS_CAM.Linux.Views.Pages.SettingsView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer Padding="28,24">
        <StackPanel Spacing="24">
            <!-- 1. Header Bar -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="⚙️" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="Application Settings &amp; Vault Preferences" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Configure your local Synology Drive vault path, active designer profile, visual themes, and Linux workstation integration." Foreground="#94A3B8" FontSize="13"/>
            </StackPanel>

            <!-- 2. Workspace Vault Location -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📁" FontSize="16" Foreground="#38BDF8"/>
                        <TextBlock Text="Synology Drive Workspace Root Directory" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                    </StackPanel>
                    <TextBlock Text="All standardized 5-folder project structures, COPY.md briefs, and assets are indexed and saved under this path." Foreground="#94A3B8" FontSize="12"/>

                    <Grid ColumnDefinitions="*, 10, Auto">
                        <TextBox Grid.Column="0" Text="{Binding SynologyDrivePath}" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Command="{Binding CheckNasStatusCommand}" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="14,8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🔌" FontSize="12"/>
                                <TextBlock Text="Verify Vault Path" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Active Designer Profile & Visual Theme -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🎨" FontSize="16" Foreground="#38BDF8"/>
                        <TextBlock Text="Designer Identity &amp; Visual Theme Profile" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*, 20, *">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Active Designer Profile" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                            <ComboBox ItemsSource="{Binding Designers}" SelectedItem="{Binding SelectedDesigner}" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Visual Theme Profile" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>

                    <!-- Theme Swatch Palette Preview Tiles -->
                    <TextBlock Text="Theme Palette Previews" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    <Grid ColumnDefinitions="*, *, *">
                        <Border Grid.Column="0" Background="#090D16" BorderBrush="#21A1F7" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,4,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="SS Default" FontWeight="Bold" Foreground="#F8FAFC" FontSize="12"/>
                                <TextBlock Text="Deep Navy &amp; Azure Accent" Foreground="#38BDF8" FontSize="10.5"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#111827" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="2,0,2,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Falconia" FontWeight="Bold" Foreground="#F8FAFC" FontSize="12"/>
                                <TextBlock Text="Charcoal &amp; Warm Gold" Foreground="#F59E0B" FontSize="10.5"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#050505" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4,0,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Metamorphosis" FontWeight="Bold" Foreground="#F8FAFC" FontSize="12"/>
                                <TextBlock Text="OLED Black &amp; Care Emerald" Foreground="#10B981" FontSize="10.5"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Action Save Button -->
            <Button Command="{Binding SaveSettingsCommand}"
                    Background="#043388" Foreground="#FFFFFF" BorderBrush="#21A1F7" BorderThickness="1"
                    CornerRadius="8" Padding="20,12" HorizontalAlignment="Left" FontSize="13" FontWeight="Bold">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="💾" FontSize="14"/>
                    <TextBlock Text="Save Settings &amp; Preferences"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
