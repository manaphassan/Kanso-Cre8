<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS_CAM.Linux.ViewModels"
             x:Class="SS_CAM.Linux.Views.Pages.TaskManagerView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer Padding="28,24">
        <StackPanel Spacing="20">
            <!-- 1. Header Bar -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="📋" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="Creative Task Manager" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Kanban board, deadline tracking, priority workflow, and designer project queues." Foreground="#94A3B8" FontSize="13"/>
            </StackPanel>

            <!-- 2. 5 KPI Summary Glance Bar -->
            <Grid ColumnDefinitions="*, *, *, *, *">
                <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,4,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="TOTAL PROJECTS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding MetricTotalTasks}" FontSize="22" FontWeight="Bold" Foreground="#38BDF8"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="2,0,2,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="IN PROGRESS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding MetricInProgressTasks}" FontSize="22" FontWeight="Bold" Foreground="#3B82F6"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="2,0,2,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="IN REVIEW" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding MetricReviewTasks}" FontSize="22" FontWeight="Bold" Foreground="#F59E0B"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="2,0,2,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="URGENT / OVERDUE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding MetricUrgentTasks}" FontSize="22" FontWeight="Bold" Foreground="#EF4444"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="4,0,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="COMPLETED" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding MetricDoneTasks}" FontSize="22" FontWeight="Bold" Foreground="#10B981"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Interactive Filter Bar -->
            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <Grid ColumnDefinitions="260, 20, Auto, 140, *, Auto">
                    <TextBox Grid.Column="0" Text="{Binding TaskSearchQuery}" PlaceholderText="Search task or project..." VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Designer Filter:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding DesignerFilterOptions}" SelectedItem="{Binding SelectedDesignerFilter}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Button Grid.Column="5" Command="{Binding LoadProjectsCommand}" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔄" FontSize="12"/>
                            <TextBlock Text="Refresh Tasks" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 4. 4-Column Kanban Board -->
            <Grid ColumnDefinitions="*, *, *, *">
                <!-- Column 1: Backlog -->
                <Border Grid.Column="0" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,5,0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="BACKLOG" FontWeight="Bold" FontSize="12" Foreground="#94A3B8"/>
                            <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{Binding BacklogTasks.Count}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC"/>
                            </Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding BacklogTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding Project}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="12" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Background="{Binding PriorityColor}" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{Binding Priority}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <Border Background="{Binding DeadlineBadgeBackground}" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{Binding DeadlineDisplay}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding DeadlineBadgeForeground}"/>
                                                </Border>
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Text="{Binding Designer}" Foreground="#64748B" FontSize="10.5" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="Start ▶" Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).StartTaskCommand}" CommandParameter="{Binding}"
                                                        Background="#043388" Foreground="White" FontSize="10" Padding="8,3" CornerRadius="4"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Column 2: In Progress -->
                <Border Grid.Column="1" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="12" Margin="3,0,3,0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="IN PROGRESS" FontWeight="Bold" FontSize="12" Foreground="#3B82F6"/>
                            <Border Grid.Column="1" Background="#1E3A8A" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{Binding InProgressTasks.Count}" FontSize="11" FontWeight="Bold" Foreground="#93C5FD"/>
                            </Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding InProgressTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding Project}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="12" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Background="{Binding PriorityColor}" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{Binding Priority}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <Border Background="{Binding DeadlineBadgeBackground}" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{Binding DeadlineDisplay}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding DeadlineBadgeForeground}"/>
                                                </Border>
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Text="{Binding Designer}" Foreground="#64748B" FontSize="10.5" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="Review 👁" Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ReviewTaskCommand}" CommandParameter="{Binding}"
                                                        Background="#78350F" Foreground="White" FontSize="10" Padding="8,3" CornerRadius="4"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Column 3: In Review -->
                <Border Grid.Column="2" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="12" Margin="3,0,3,0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="IN REVIEW" FontWeight="Bold" FontSize="12" Foreground="#F59E0B"/>
                            <Border Grid.Column="1" Background="#78350F" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{Binding ReviewTasks.Count}" FontSize="11" FontWeight="Bold" Foreground="#FDE68A"/>
                            </Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ReviewTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding Project}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="12" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Background="{Binding PriorityColor}" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{Binding Priority}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <Border Background="{Binding DeadlineBadgeBackground}" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{Binding DeadlineDisplay}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding DeadlineBadgeForeground}"/>
                                                </Border>
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Text="{Binding Designer}" Foreground="#64748B" FontSize="10.5" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="Approve ✔" Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ApproveTaskCommand}" CommandParameter="{Binding}"
                                                        Background="#064E3B" Foreground="White" FontSize="10" Padding="8,3" CornerRadius="4"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Column 4: Completed -->
                <Border Grid.Column="3" Background="#0A0F1D" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="12" Margin="5,0,0,0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="COMPLETED" FontWeight="Bold" FontSize="12" Foreground="#10B981"/>
                            <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{Binding DoneTasks.Count}" FontSize="11" FontWeight="Bold" Foreground="#A7F3D0"/>
                            </Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding DoneTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding Project}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="12" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Background="#064E3B" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="DONE" FontSize="9.5" FontWeight="Bold" Foreground="#A7F3D0"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Designer}" Foreground="#64748B" FontSize="10.5"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
