                            </Viewbox>
                        </Grid>
                    </Border>

                    <!-- Station Name, Live Badge, Visualizer Badge & Now Playing Track Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="OnBottomRadioBarClicked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBlock x:Name="TxtBottomRadioTitle" Text="SuamiSihat Radio" FontWeight="Bold" FontSize="13"
                                           Foreground="White" VerticalAlignment="Center"/>
                            <Border Background="#10B981" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <ui:TextBlock Text="LIVE" Foreground="White" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                            <ui:TextBlock x:Name="BottomRadioNowPlayingLabel" Text="NOW PLAYING:" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#60A5FA" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:TextBlock x:Name="TxtBottomRadioTrack" Text="Now Playing..." FontSize="11"
                                           Foreground="#93C5FD" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Controls: Play/Pause, Volume -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="BtnBottomRadioPlay" Click="OnStatusRadioPlayToggle" Appearance="Primary"
                                   Width="34" Height="34" Padding="0" Margin="0,0,12,0" Cursor="Hand" ToolTip="Play / Pause">
                            <ui:TextBlock x:Name="TxtBottomRadioPlayIcon" Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="White"/>
                        </ui:Button>

                        <StackPanel x:Name="BottomRadioVolumePanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                           Foreground="#8AAACF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="BottomRadioVolumeSlider" Width="100" Minimum="0" Maximum="100" Value="80"
                                     ValueChanged="OnBottomRadioVolumeChanged" VerticalAlignment="Center" ToolTip="Volume"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Toast Notification Floating Container Overlay -->
        <StackPanel x:Name="ToastContainer" Grid.RowSpan="4" VerticalAlignment="Top" HorizontalAlignment="Right"
                    Margin="0,52,24,0" Panel.ZIndex="9999" Width="360"/>

        <!-- In-App Notification Center Drawer Overlay -->
        <Border x:Name="NotificationDrawer" Grid.RowSpan="4" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,50,24,0" Width="380" MaxHeight="520" Panel.ZIndex="10000"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                Visibility="Collapsed">
            <Grid Margin="16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Drawer Header -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Alert24" FontSize="16" Foreground="{DynamicResource FluentBrand80}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="Notifications" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Click="OnMarkAllNotificationsReadClicked" Appearance="Secondary" Width="26" Height="26" Padding="0" Margin="0,0,6,0" Cursor="Hand" ToolTip="Mark All Notifications as Read">
                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="12" VerticalAlignment="Center"/>
                        </ui:Button>
                        <ui:Button Click="OnClearAllNotificationsClicked" Appearance="Secondary" Width="26" Height="26" Padding="0" Margin="0,0,6,0" Cursor="Hand" ToolTip="Clear All Notifications">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="12" VerticalAlignment="Center"/>
                        </ui:Button>
                        <ui:Button Click="OnCloseNotificationDrawerClicked" Appearance="Secondary" Width="26" Height="26" Padding="0" Cursor="Hand" ToolTip="Close Drawer">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="12"/>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="1" Margin="0,0,0,10"/>

                <!-- Notification List Container -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NotificationListStack">
                        <!-- Populated programmatically -->
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Hidden elements (kept for backward compatibility) -->
        <Canvas x:Name="HeaderCanvas" Grid.Row="0" IsHitTestVisible="False" Visibility="Collapsed"/>
        <TextBlock x:Name="HeaderSubtitle" Grid.Row="0" Visibility="Collapsed"/>
    </Grid>
</ui:FluentWindow>